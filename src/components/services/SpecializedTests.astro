---
// Services — Evaluaciones especializadas.
// Layout mirrors Home ServicesSection interaction pattern without thumbnails.
// All copy and images come from siteConfig.servicesPage.specializedTests.
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Icon from '../ui/Icon.astro';

const { specializedTests } = siteConfig.servicesPage;
const { contact } = siteConfig;
---

<section
  id={specializedTests.id}
  class="relative bg-white text-brand-body py-12 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
  aria-labelledby="specialized-tests-heading"
>
  <!-- Consistent fluid container matching Hero, Navbar, and /nosotros -->
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Section Header -->
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Eyebrow -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {specializedTests.eyebrow}
        </span>
      </div>

      <h2
        id="specialized-tests-heading"
        class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
      >
        <span class="block font-normal">{specializedTests.titlePart1}</span>
        <span class="block italic font-normal text-brand-primary">{specializedTests.titleHighlight}</span>
      </h2>

      <p class="text-sm sm:text-lg text-brand-body leading-relaxed mt-3 sm:mt-6 max-w-lg">
        {specializedTests.description}
      </p>
    </div>

    <!-- Mobile-only image: positioned right after header -->
    <div class="block lg:hidden mt-8 mb-8">
      <div class="group relative rounded-2xl overflow-hidden shadow-xs border border-white/80 aspect-video">
        <img
          src={specializedTests.image.src}
          alt={specializedTests.image.alt}
          width={specializedTests.image.width}
          height={specializedTests.image.height}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
        />
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="mt-8 sm:mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-start">
      <!-- Left Column: The 5 Specialized Tests List -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="divide-y divide-brand-border border-t border-b border-brand-border">
          {specializedTests.tests.map((test) => {
            const whatsappUrl = buildWhatsAppLink(test.whatsappMessage, contact.whatsappNumber);

            return (
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-event="specialized_test_click"
                data-test-number={test.number}
                class="group flex items-center gap-3 sm:gap-6 py-4 sm:py-6 lg:py-7 px-1.5 sm:px-4 rounded-2xl hover:bg-brand-cool/60 active:bg-brand-cool/90 active:scale-[0.99] transition-colors duration-200"
              >
                <!-- Numeric Index: Instrument Serif (High contrast WCAG AA compliant >= 4.5:1) -->
                <span class="font-display text-xl sm:text-2xl lg:text-3xl text-brand-primary font-medium min-w-5 sm:min-w-8 shrink-0 text-center sm:text-left">
                  {test.number}
                </span>

                <!-- Textual Content -->
                <div class="flex-1 min-w-0 pr-1 sm:pr-2">
                  <h3 class="font-display text-base sm:text-xl lg:text-2xl font-normal text-brand-heading group-hover:text-brand-primary transition-colors leading-snug">
                    {test.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-brand-body leading-relaxed mt-1 sm:mt-1.5">
                    {test.description}
                  </p>
                </div>

                <!-- Circle Action Arrow Button -->
                <div class="w-8 h-8 sm:w-11 sm:h-11 lg:w-12 lg:h-12 rounded-full bg-brand-mist text-brand-heading group-hover:bg-brand-primary group-hover:text-white transition-colors duration-200 flex items-center justify-center shrink-0">
                  <Icon
                    name="arrow-right"
                    class="w-3.5 h-3.5 sm:w-5 sm:h-5 transition-transform duration-200 group-hover:translate-x-0.5"
                  />
                  <span class="sr-only">Consultar por WhatsApp</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Right Column: Featured Photography + Technology Banner -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Desktop Photography -->
        <div class="hidden lg:block group relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-video">
          <img
            src={specializedTests.image.src}
            alt={specializedTests.image.alt}
            width={specializedTests.image.width}
            height={specializedTests.image.height}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
          />
        </div>

        <!-- Technology Banner -->
        <div class="bg-brand-cool border border-brand-border rounded-2xl p-5 sm:p-6 flex items-start gap-4 shadow-xs">
          <div
            class="shrink-0 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-brand-ice flex items-center justify-center text-brand-primary"
            aria-hidden="true"
          >
            <Icon name="eye" class="w-5 h-5 sm:w-6 sm:h-6" />
          </div>

          <div class="flex-1 min-w-0">
            <span class="font-sans text-xs font-semibold text-brand-primary tracking-wider uppercase block mb-1">
              {specializedTests.techBanner.eyebrow}
            </span>
            <p class="font-sans text-xs sm:text-sm text-brand-body leading-relaxed">
              {specializedTests.techBanner.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
