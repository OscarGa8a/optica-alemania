---
// Sección 7 — Monturas y Estilo
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

const { frames } = siteConfig;
const whatsappFramesUrl = buildWhatsAppLink(
  frames.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id="monturas"
  class="relative bg-brand-cool text-brand-body py-14 sm:py-16 lg:py-24 scroll-mt-20 overflow-hidden"
>
  <!-- Atmospheric soft ambient clinic lighting matching brand tokens -->
  <div class="absolute -top-[10%] -left-[5%] w-[600px] h-[500px] bg-brand-blue-soft/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-[10%] -right-[5%] w-[500px] h-[450px] bg-brand-ice/40 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header: Title & Context -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-6 lg:gap-16 items-end mb-10 sm:mb-12 lg:mb-14">
      
      <!-- Left Column: Eyebrow & Title -->
      <div>
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-brand-primary">
          {frames.eyebrow}
        </span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-brand-heading leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{frames.titlePart1}</span>
          <span class="block italic font-normal text-brand-primary">{frames.titlePart2}</span>
        </h2>
      </div>

      <!-- Right Column: Description & Action Link -->
      <div class="flex flex-col items-start gap-4 lg:pb-2">
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed max-w-lg">
          {frames.description}
        </p>

        <Button
          variant="link"
          size="lg"
          href={whatsappFramesUrl}
          target="_blank"
          rel="noopener noreferrer"
          icon="arrow-right"
          data-event="whatsapp_cta"
          data-event-location="frames_header"
          aria-label="Explorar catálogo de monturas de Óptica Alemania en WhatsApp"
        >
          {frames.ctaText}
        </Button>
      </div>

    </div>

    <!-- Cards Grid: Mujer, Hombre, Niños -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {frames.categories.map((category) => {
        const categoryUrl = buildWhatsAppLink(
          category.whatsappMessage,
          siteConfig.contact.whatsappNumber
        );

        return (
          <a
            href={categoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="frame_category_click"
            data-event-category={category.id}
            aria-label={`Explorar colección de monturas para ${category.title} en WhatsApp`}
            class="group relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[16/9] sm:aspect-[2/1] md:aspect-[4/5] bg-brand-blue-soft block"
          >
            <!-- Card Image -->
            <img
              src={category.image.src}
              alt={category.image.alt}
              width={category.image.width}
              height={category.image.height}
              class="w-full h-full object-cover object-[center_45%] md:object-center group-hover:scale-[1.03] transition-transform duration-700 ease-out"
              loading="lazy"
              decoding="async"
            />

            <!-- Editorial Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent pointer-events-none" aria-hidden="true"></div>

            <!-- Card Bottom Bar: Title & Circular Action -->
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7 lg:p-9 flex flex-col justify-end pointer-events-none">
              <div class="flex items-end justify-between border-b border-transparent md:border-white/60 pb-0 md:pb-3.5 w-full">
                <span class="font-display text-3xl sm:text-4xl lg:text-5xl text-white font-normal leading-none tracking-tight">
                  {category.title}
                </span>

                <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full border border-white/80 flex items-center justify-center text-white shrink-0 group-hover:bg-white group-hover:text-brand-heading group-hover:border-white transition-all duration-300 shadow-sm">
                  <Icon
                    name="arrow-right"
                    class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5"
                  />
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</section>
