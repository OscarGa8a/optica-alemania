---
import Layout from '../layouts/Layout.astro';
import ProcedimientosHero from '../components/procedimientos/ProcedimientosHero.astro';
import ProcedimientosVolk from '../components/procedimientos/ProcedimientosVolk.astro';
import ProcedimientosFarnsworth from '../components/procedimientos/ProcedimientosFarnsworth.astro';
import ProcedimientosGallery from '../components/procedimientos/ProcedimientosGallery.astro';
import ProcedimientosCta from '../components/procedimientos/ProcedimientosCta.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';

const pageTitle = `Procedimientos visuales en Villavicencio | ${siteConfig.name}`;
const pageDescription = "Conoce cómo se realizan algunas evaluaciones visuales en Óptica Alemania Villavicencio, como la evaluación retinal y el test de Farnsworth D-15.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/procedimientos"
  headerTheme="light"
>
  <main id="main-content">
    <ProcedimientosHero />
    <ProcedimientosVolk />
    <ProcedimientosFarnsworth />
    <ProcedimientosGallery />
    <ProcedimientosCta />
  </main>
  <Footer currentPath="/procedimientos" />
</Layout>
