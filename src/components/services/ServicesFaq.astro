---
// Sección 7: Preguntas frecuentes
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const { faq } = siteConfig.servicesPage;
const { contact } = siteConfig;

const whatsappUrl = buildWhatsAppLink(faq.contact.whatsappMessage, contact.whatsappNumber);
---

<section
  id={faq.id}
  class="relative bg-brand-cool text-brand-body py-14 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
  aria-labelledby="faq-heading"
>
  <!-- Stylized Decorative Eye Watermark from assets.webp -->
  <div
    class="absolute -left-20 sm:-left-28 lg:-left-36 -bottom-10 sm:-bottom-16 lg:-bottom-20 w-full max-w-lg sm:max-w-xl lg:max-w-2xl pointer-events-none opacity-15 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left Column: Sticky Title, Description & WhatsApp Contact Card (Desktop) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <!-- Eyebrow -->
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
            {faq.eyebrow}
          </span>
        </div>

        <h2
          id="faq-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-normal text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
        >
          <span class="block">{faq.titlePart1}</span>
          <span class="block italic font-normal text-brand-primary">{faq.titleHighlight}</span>
        </h2>

        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed max-w-md mt-4 sm:mt-6">
          {faq.description}
        </p>

        <!-- Direct WhatsApp Contact Box (Desktop) -->
        <div class="hidden lg:block mt-10 sm:mt-12">
          <div class="bg-white border border-brand-border rounded-2xl p-5 shadow-xs max-w-sm">
            <div class="flex items-center gap-3.5">
              <div class="w-11 h-11 rounded-full bg-brand-ice text-brand-primary flex items-center justify-center shrink-0">
                <Icon name="whatsapp" class="w-5 h-5" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-brand-body font-medium">{faq.contact.title}</p>
                <div class="mt-0.5">
                  <Button
                    variant="link"
                    size="sm"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    icon="arrow-right"
                  >
                    {faq.contact.actionText}
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive FAQ Accordion List -->
      <div class="lg:col-span-7">
        <div class="space-y-3.5 lg:space-y-0" id="faq-accordion">
          {faq.items.map((item) => {
            const isOpen = item.defaultOpen;
            return (
              <div
                class:list={[
                  'faq-item transition-all duration-300 overflow-hidden',
                  'rounded-2xl border p-5 sm:p-6',
                  isOpen
                    ? 'is-open bg-brand-mist/80 border-brand-steel/40 lg:rounded-2xl lg:border lg:my-2 lg:p-7'
                    : 'bg-white border-brand-border hover:border-brand-steel/40 lg:border-0 lg:border-b lg:border-brand-border lg:rounded-none lg:bg-transparent lg:p-6 lg:hover:bg-brand-mist/30',
                ]}
                data-faq-id={item.id}
              >
                <button
                  type="button"
                  class="faq-toggle w-full text-left flex items-start sm:items-center justify-between gap-4 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 rounded-lg"
                  aria-expanded={isOpen ? 'true' : 'false'}
                  aria-controls={`faq-answer-${item.id}`}
                  id={`faq-toggle-${item.id}`}
                >
                  <div class="flex items-center gap-3.5 sm:gap-5 flex-1">
                    <!-- Serif Number -->
                    <span class="font-display text-2xl sm:text-3xl lg:text-4xl text-brand-primary font-normal shrink-0 w-8 sm:w-10 select-none">
                      {item.number}
                    </span>
                    <!-- Vertical Divider -->
                    <span class="w-px h-7 sm:h-9 bg-brand-border shrink-0" aria-hidden="true"></span>
                    <!-- Question Heading -->
                    <h3 class="font-display text-lg sm:text-xl lg:text-2xl text-brand-heading font-normal leading-snug flex-1">
                      {item.question}
                    </h3>
                  </div>

                  <!-- Plus / Minus Icon Indicator -->
                  <div class="faq-icon-wrapper w-8 h-8 flex items-center justify-center text-brand-primary shrink-0 ml-2">
                    <span class:list={['faq-minus', !isOpen && 'hidden']}>
                      <Icon name="minus" class="w-5 h-5 transition-transform duration-200" />
                    </span>
                    <span class:list={['faq-plus', isOpen && 'hidden']}>
                      <Icon name="plus" class="w-5 h-5 transition-transform duration-200" />
                    </span>
                  </div>
                </button>

                <!-- Expandable Answer -->
                <div
                  id={`faq-answer-${item.id}`}
                  class:list={[
                    'faq-answer transition-all duration-300',
                    isOpen ? 'block opacity-100 max-h-96' : 'hidden opacity-0 max-h-0',
                  ]}
                  role="region"
                  aria-labelledby={`faq-toggle-${item.id}`}
                >
                  <div class="mt-3 lg:mt-4 p-3.5 sm:p-4 lg:p-0 rounded-xl lg:rounded-none bg-brand-mist/60 lg:bg-transparent lg:pl-[calc(2.5rem+1px+1.25rem)] text-brand-body text-sm sm:text-base leading-relaxed font-normal">
                    {item.answer}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Direct WhatsApp Contact Box (Mobile - placed below FAQ list) -->
        <div class="flex lg:hidden mt-8 pt-4">
          <div class="w-full bg-white border border-brand-border rounded-2xl p-4 sm:p-5 shadow-xs">
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-full bg-brand-ice text-brand-primary flex items-center justify-center shrink-0">
                <Icon name="whatsapp" class="w-5 h-5" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-brand-body font-medium">{faq.contact.title}</p>
                <div class="mt-0.5">
                  <Button
                    variant="link"
                    size="sm"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    icon="arrow-right"
                  >
                    {faq.contact.actionText}
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('.faq-item');

    items.forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>('.faq-toggle');
      const answer = item.querySelector<HTMLElement>('.faq-answer');
      const plusWrapper = item.querySelector<HTMLElement>('.faq-plus');
      const minusWrapper = item.querySelector<HTMLElement>('.faq-minus');

      if (!toggle || !answer) return;
      if (toggle.dataset.listenerAttached) return;
      toggle.dataset.listenerAttached = 'true';

      toggle.addEventListener('click', () => {
        const isCurrentlyExpanded = toggle.getAttribute('aria-expanded') === 'true';

        // Close all other items (classic accordion behavior)
        items.forEach((otherItem) => {
          if (otherItem !== item) {
            const otherToggle = otherItem.querySelector<HTMLButtonElement>('.faq-toggle');
            const otherAnswer = otherItem.querySelector<HTMLElement>('.faq-answer');
            const otherPlus = otherItem.querySelector<HTMLElement>('.faq-plus');
            const otherMinus = otherItem.querySelector<HTMLElement>('.faq-minus');

            if (otherToggle && otherAnswer) {
              otherToggle.setAttribute('aria-expanded', 'false');
              otherAnswer.classList.add('hidden', 'opacity-0', 'max-h-0');
              otherAnswer.classList.remove('block', 'opacity-100', 'max-h-96');
              otherItem.classList.remove('is-open', 'bg-brand-mist/80', 'border-brand-steel/40', 'lg:rounded-2xl', 'lg:border', 'lg:my-2');
              otherItem.classList.add('bg-white', 'border-brand-border', 'lg:border-0', 'lg:border-b', 'lg:border-brand-border', 'lg:rounded-none', 'lg:bg-transparent');
              otherPlus?.classList.remove('hidden');
              otherMinus?.classList.add('hidden');
            }
          }
        });

        // Toggle current item
        if (isCurrentlyExpanded) {
          toggle.setAttribute('aria-expanded', 'false');
          answer.classList.add('hidden', 'opacity-0', 'max-h-0');
          answer.classList.remove('block', 'opacity-100', 'max-h-96');
          item.classList.remove('is-open', 'bg-brand-mist/80', 'border-brand-steel/40', 'lg:rounded-2xl', 'lg:border', 'lg:my-2');
          item.classList.add('bg-white', 'border-brand-border', 'lg:border-0', 'lg:border-b', 'lg:border-brand-border', 'lg:rounded-none', 'lg:bg-transparent');
          plusWrapper?.classList.remove('hidden');
          minusWrapper?.classList.add('hidden');
        } else {
          toggle.setAttribute('aria-expanded', 'true');
          answer.classList.remove('hidden', 'opacity-0', 'max-h-0');
          answer.classList.add('block', 'opacity-100', 'max-h-96');
          item.classList.add('is-open', 'bg-brand-mist/80', 'border-brand-steel/40', 'lg:rounded-2xl', 'lg:border', 'lg:my-2');
          item.classList.remove('bg-white', 'border-brand-border', 'lg:border-0', 'lg:border-b', 'lg:border-brand-border', 'lg:rounded-none', 'lg:bg-transparent');
          plusWrapper?.classList.add('hidden');
          minusWrapper?.classList.remove('hidden');
        }
      });
    });
  }

  // Initialize on initial page load and after view transitions
  setupFaqAccordion();
  document.addEventListener('astro:page-load', setupFaqAccordion);
</script>