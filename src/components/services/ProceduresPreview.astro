---
// Sección 6: Procedimientos en video
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const { procedures } = siteConfig.servicesPage;
---

<section id={procedures.id} class="relative bg-brand-midnight text-white py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20">
  <!-- Stylized Decorative Eye Watermark from assets.webp matching About sections -->
  <div
    class="absolute -right-20 sm:-right-28 lg:-right-36 -top-10 sm:-top-16 lg:-top-20 w-full max-w-lg sm:max-w-xl lg:max-w-3xl xl:max-w-4xl pointer-events-none opacity-10 select-none filter brightness-0 invert z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Section Header: Title left & Description right -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 lg:gap-12">
      <div class="max-w-2xl">
        <!-- Eyebrow -->
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-steel">
            {procedures.eyebrow}
          </span>
        </div>

        <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-white leading-[1.06] tracking-tight mt-3 sm:mt-5">
          <span class="block font-normal">{procedures.titlePart1}</span>
          <span class="block italic font-normal text-brand-steel">{procedures.titleHighlight}</span>
        </h2>
      </div>

      <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed max-w-md lg:mb-2">
        {procedures.description}
      </p>
    </div>

    <!-- Procedures Cards Grid (2 Columns Desktop, Stacked Mobile) -->
    <div class="mt-8 sm:mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      {procedures.items.map((item) => (
        <article class="group">
          <a
            href={item.actionHref}
            data-event="procedure_card_click"
            data-event-location="procedures_preview"
            data-event-item={item.id}
            class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-steel rounded-2xl sm:rounded-3xl active:scale-[0.99] transition-transform duration-150"
          >
            <!-- Thumbnail Container -->
            <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden aspect-video bg-brand-midnight-card shadow-2xl border border-white/10 group-hover:border-brand-steel/50 transition-colors duration-300">
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- Card Content: Title & Link Indicator with unified group hover -->
            <div class="mt-4 sm:mt-5 lg:mt-6">
              <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-white group-hover:text-brand-steel font-normal leading-snug transition-colors duration-200">
                {item.title}
              </h3>

              <div class="mt-3 sm:mt-4 inline-flex items-center gap-2 text-sm sm:text-base font-medium text-brand-steel group-hover:text-white transition-colors duration-200">
                <span class="border-b border-brand-slate-border group-hover:border-white pb-0.5 transition-colors duration-200">
                  {item.actionText}
                </span>
                <Icon
                  name="arrow-right"
                  class="w-4 h-4 stroke-current stroke-2 fill-none group-hover:translate-x-1.5 transition-transform duration-200"
                />
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Bottom Action CTA Button -->
    <div class="mt-10 sm:mt-14 lg:mt-18 text-center">
      <Button
        variant="glass"
        size="lg"
        href={procedures.ctaHref}
        icon="arrow-right"
        data-event="procedures_explore_click"
        data-event-location="procedures_preview"
      >
        {procedures.ctaText}
      </Button>
    </div>
  </div>
</section>
