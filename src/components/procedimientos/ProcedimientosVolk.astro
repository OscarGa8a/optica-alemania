---
// Sección 2 — Volk InView (Tecnología en Acción)
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import VideoPlayer from '../ui/VideoPlayer.astro';

const { volk } = siteConfig.procedimientosPage;
const whatsappUrl = buildWhatsAppLink(
  volk.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id={volk.id}
  class="relative bg-white text-brand-body py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20 lg:scroll-mt-24"
  aria-labelledby="volk-inview-heading"
>
  <!-- Background decorative watermark -->
  <div
    class="absolute -right-24 sm:-right-32 lg:-right-40 -bottom-10 w-full max-w-xl lg:max-w-3xl pointer-events-none opacity-15 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/about/assets.webp"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Mobile-only Eyebrow & H2 (above video on mobile matching mockup) -->
    <div class="lg:hidden mb-6">
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {volk.eyebrow}
        </span>
      </div>

      <h2 class="font-display text-4xl sm:text-5xl text-brand-heading leading-[1.06] tracking-tight mt-3">
        <span class="block font-normal">{volk.titleLine1}</span>
        <span class="block italic font-normal text-brand-primary">{volk.titleHighlight}</span>
      </h2>
    </div>

    <!-- Main Grid: Video on Left (7 cols) / Editorial Content on Right (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 xl:gap-16 items-center">
      
      <!-- Video Player Card using reusable VideoPlayer component with Icon.astro -->
      <div class="lg:col-span-7">
        <VideoPlayer
          id={volk.videoId}
          src={volk.video.src}
          poster={volk.video.poster}
          pngFallback={volk.video.pngFallback}
          alt={volk.video.alt}
          initialTimestamp={volk.video.initialTimestamp}
          initialProgress={volk.video.initialProgress}
        />
      </div>

      <!-- Right Column: Text & CTA Button -->
      <div class="lg:col-span-5">
        <div class="max-w-xl">
          <!-- Desktop Eyebrow & H2 -->
          <div class="hidden lg:block">
            <div>
              <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
                {volk.eyebrow}
              </span>
            </div>

            <h2
              id="volk-inview-heading"
              class="font-display text-4xl sm:text-5xl lg:text-[3rem] xl:text-[3.5rem] text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
            >
              <span class="block font-normal">{volk.titleLine1}</span>
              <span class="block italic font-normal text-brand-primary">{volk.titleHighlight}</span>
            </h2>
          </div>

          <!-- Descriptive Paragraph -->
          <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-6 font-normal">
            {volk.description}
          </p>

          <!-- WhatsApp Pill Button using Button.astro and Icon.astro -->
          <div class="mt-6 sm:mt-8">
            <Button
              variant="primary"
              size="lg"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-event="whatsapp_cta"
              data-event-location="procedimientos_volk"
              icon="arrow-right"
              iconPosition="right"
              aria-label={`${volk.ctaText} - ${siteConfig.name}`}
              class="w-full sm:w-auto inline-flex items-center justify-between sm:justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4"
            >
              <span class="inline-flex items-center gap-2.5">
                <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
                <span class="text-sm sm:text-base font-semibold whitespace-nowrap">{volk.ctaText}</span>
              </span>
            </Button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
