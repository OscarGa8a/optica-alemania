---
// Sección 5 — Nuestro Espacio
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import Button from './ui/Button.astro';

const { space } = siteConfig;
---

<section
  id="espacio"
  class="relative bg-brand-cool text-brand-body py-14 sm:py-16 lg:py-24 scroll-mt-20 overflow-hidden"
>
  <!-- Atmospheric soft ambient clinic lighting matching brand tokens -->
  <div class="absolute -top-[10%] -right-[5%] w-[650px] h-[550px] bg-brand-blue-soft/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-[15%] -left-[10%] w-[550px] h-[450px] bg-brand-ice/40 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Header: Editorial Heading and Lead Context -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end">
      <!-- Left Column: Eyebrow + Display Title -->
      <div class="lg:col-span-7 flex flex-col">
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-brand-primary">
          {space.eyebrow}
        </span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-brand-heading leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{space.titlePart1}</span>
          <span class="block italic font-normal text-brand-primary">{space.titlePart2}</span>
        </h2>
      </div>

      <!-- Right Column: Description + Desktop Link -->
      <div class="lg:col-span-5 flex flex-col justify-end lg:pb-1">
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed max-w-xl">
          {space.description}
        </p>

        <!-- Desktop Action Link -->
        <div class="hidden lg:block mt-5 sm:mt-6">
          <Button
            variant="link"
            size="lg"
            href={space.ctaHref}
            icon="arrow-right"
            data-event="space_about_click"
            data-event-location="space_section_desktop"
          >
            {space.ctaText}
          </Button>
        </div>
      </div>
    </div>

    <!-- Asymmetric Bento Photo Grid -->
    <div class="mt-10 sm:mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-[1.626fr_1fr] gap-5 sm:gap-6 lg:gap-7 items-stretch">
      <!-- Main Featured Image (Reception / Lounge) -->
      <div class="relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[16/10] lg:aspect-auto lg:h-full group">
        <img
          src={space.images.main.src}
          alt={space.images.main.alt}
          width={space.images.main.width}
          height={space.images.main.height}
          class="w-full h-full object-cover object-center group-hover:scale-[1.015] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Secondary Stacked Column (Frames Display & Clinical Space) -->
      <div class="grid grid-cols-1 gap-5 sm:gap-6 lg:gap-7 h-full">
        <div class="relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[2/1] group">
          <img
            src={space.images.shelves.src}
            alt={space.images.shelves.alt}
            width={space.images.shelves.width}
            height={space.images.shelves.height}
            class="w-full h-full object-cover object-center group-hover:scale-[1.015] transition-transform duration-500 ease-out"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[2/1] group">
          <img
            src={space.images.clinic.src}
            alt={space.images.clinic.alt}
            width={space.images.clinic.width}
            height={space.images.clinic.height}
            class="w-full h-full object-cover object-center group-hover:scale-[1.015] transition-transform duration-500 ease-out"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- Mobile Action Link (placed below the image stack matching mobile mockup) -->
    <div class="lg:hidden mt-7 sm:mt-8">
      <Button
        variant="link"
        size="md"
        href={space.ctaHref}
        icon="arrow-right"
        data-event="space_about_click"
        data-event-location="space_section_mobile"
      >
        {space.ctaText}
      </Button>
    </div>
  </div>
</section>
