            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_whatsapp_click"
