---
// Services — Urgencias oculares.
// All copy comes from siteConfig.servicesPage.eyeEmergencies.
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const { eyeEmergencies } = siteConfig.servicesPage;
const { contact } = siteConfig;

const whatsappUrl = buildWhatsAppLink(eyeEmergencies.whatsappMessage, contact.whatsappNumber);
---

<section
  id={eyeEmergencies.id}
  class="relative bg-brand-cool text-brand-body py-12 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
  aria-labelledby="urgencias-oculares-heading"
>
  <!-- Stylized Decorative Eye Watermark from assets.webp -->
  <div
    class="absolute -right-24 sm:-right-32 lg:-right-40 -bottom-10 w-full max-w-xl lg:max-w-3xl pointer-events-none opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <!-- Consistent fluid container matching Hero, Navbar, and other sections -->
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Top Content Row: Title + Description on Left / CTA Button on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <!-- Left Column: Title & Description -->
      <div class="lg:col-span-8 max-w-2xl lg:max-w-none">
        <!-- Eyebrow -->
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
            {eyeEmergencies.eyebrow}
          </span>
        </div>

        <h2
          id="urgencias-oculares-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
        >
          <span class="block font-normal">{eyeEmergencies.titlePart1} {eyeEmergencies.titlePart2}</span>
          <span class="block italic font-normal text-brand-primary">{eyeEmergencies.titleHighlight}</span>
        </h2>

        <p class="text-sm sm:text-lg text-brand-body leading-relaxed mt-3 sm:mt-6 max-w-xl lg:max-w-2xl">
          {eyeEmergencies.description}
        </p>
      </div>

      <!-- Right Column: WhatsApp CTA Button -->
      <div class="lg:col-span-4 flex items-center lg:justify-end">
        <Button
          variant="primary"
          size="lg"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          icon="whatsapp"
          iconPosition="left"
          data-event="whatsapp_cta"
          data-event-location="eye_emergencies"
          aria-label="Consultar disponibilidad de urgencias oculares por WhatsApp"
        >
          {eyeEmergencies.ctaText}
        </Button>
      </div>
    </div>

    <!-- Bottom Notice: Medical Disclaimer Card -->
    <div class="mt-10 sm:mt-14 lg:mt-16 bg-white border border-brand-border rounded-2xl lg:rounded-3xl p-5 sm:p-6 shadow-xs max-w-3xl">
      <div class="flex items-center gap-3.5 sm:gap-4">
        <!-- Circular Eye Icon Badge -->
        <div
          class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-brand-ice text-brand-primary flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <Icon name="eye" class="w-5 h-5 sm:w-6 sm:h-6" />
        </div>

        <!-- Vertical divider line -->
        <div class="w-px h-8 bg-brand-border shrink-0" aria-hidden="true"></div>

        <!-- Notice text with bold disclaimer lead -->
        <p class="font-sans text-xs sm:text-sm text-brand-body leading-relaxed">
          <strong class="font-semibold text-brand-heading">{eyeEmergencies.notice.boldText}</strong>
          {' '}
          <span>{eyeEmergencies.notice.regularText}</span>
        </p>
      </div>
    </div>
  </div>
</section>
