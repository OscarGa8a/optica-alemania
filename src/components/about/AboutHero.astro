---
// Sección 1 — Hero Sobre Nosotros
// Óptica Alemania Villavicencio
---

<section id="inicio" class="relative w-full min-h-screen lg:min-h-[900px] xl:min-h-screen flex flex-col justify-start lg:justify-center overflow-hidden">
  
  <!-- Full-bleed Background Image occupying 100% width and 100% height of the Hero -->
  <div class="absolute inset-0 w-full h-full z-0 select-none pointer-events-none">
    <picture class="block w-full h-full">
      <!-- Mobile source (< 1024px) -->
      <source
        media="(max-width: 1023px)"
        srcset="/images/about/1_hero_mobile_image.webp"
        type="image/webp"
      />
      <source
        media="(max-width: 1023px)"
        srcset="/images/about/1_hero_mobile_image.png"
        type="image/png"
      />
      <!-- Desktop source (>= 1024px) -->
      <source
        media="(min-width: 1024px)"
        srcset="/images/about/1_hero_desktop_image.webp"
        type="image/webp"
      />
      <!-- Fallback image -->
      <img
        src="/images/about/1_hero_desktop_image.png"
        alt="Especialista de Óptica Alemania en el counter de atención"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-[54%_bottom] translate-y-20 sm:translate-y-10 lg:translate-y-0 lg:object-right xl:object-[84%_center]"
      />
    </picture>

    <!-- Translucent gradient overlay: soft wash so background is visible, stops before the middle (50%) -->
    <!-- Desktop: soft translucent gradient covering the text column up to 42%, fading out completely by 50% -->
    <div class="hidden lg:block absolute inset-0 bg-gradient-to-r from-brand-ice/90 via-brand-mist/80 via-30% to-brand-mist/20 to-42% to-transparent to-50%"></div>
    <!-- Mobile: soft gradient from top fading out before the specialist -->
    <div class="block lg:hidden absolute inset-0 bg-gradient-to-b from-brand-ice/90 via-brand-mist/75 via-45% to-transparent to-50%"></div>
  </div>

  <!-- Content Container: Sits on top of the full-bleed background with comfortable left spacing -->
  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-28 pb-12 sm:pt-32 lg:py-24">
    <div class="max-w-xl lg:max-w-2xl xl:max-w-3xl 2xl:max-w-4xl">
      <!-- Eyebrow matching mockup -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-[0.2em] text-brand-primary">
          SOBRE NOSOTROS
        </span>
      </div>

      <!-- Hero Heading H1: Fluid Sans-Serif Bold scaling smoothly with screen width -->
      <h1 class="text-[clamp(2.25rem,1.25rem+3.6vw,5.5rem)] font-sans font-bold text-brand-heading tracking-tight leading-[1.06] mt-4 sm:mt-6">
        Personas detrás<br />
        <span class="text-brand-primary font-bold not-italic">de cada mirada.</span>
      </h1>

      <!-- Subtitle / Lead Paragraph matching mockup -->
      <p class="mt-4 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-brand-heading font-medium sm:font-normal leading-relaxed max-w-md sm:max-w-lg xl:max-w-xl">
        Conoce nuestra historia y el compromiso que nos mueve en el cuidado de tu salud visual.
      </p>

      <!-- CTA Link to History Anchor matching mockup -->
      <div class="mt-6 sm:mt-10">
        <a
          href="#trayectoria"
          data-event="history_click"
          data-event-location="about_hero"
          class="group inline-flex items-center gap-3.5 pr-2 pb-1.5 border-b-[1.5px] border-brand-primary text-brand-primary hover:text-brand-bright hover:border-brand-bright transition-colors font-semibold text-sm sm:text-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
        >
          <span>Conoce nuestra historia</span>
          <svg
            class="w-5 sm:w-6 h-3.5 sm:h-4 transition-transform duration-200 group-hover:translate-x-1"
            viewBox="0 0 24 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M1 8h21" />
            <path d="m15 2 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>

</section>
