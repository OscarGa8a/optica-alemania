---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ArrivalSection from '../components/ArrivalSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import TechSection from '../components/TechSection.astro';
import SpaceSection from '../components/SpaceSection.astro';
import KidsVisionSection from '../components/KidsVisionSection.astro';
import FramesSection from '../components/FramesSection.astro';
import CofremSection from '../components/CofremSection.astro';
import TrajectorySection from '../components/TrajectorySection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { obtenerVideosInicio } from '../lib/sanity/videos';
import { obtenerFotosSede } from '../lib/sanity/sede';
import { obtenerFotosMonturas } from '../lib/sanity/frames';

const videosInicio = await obtenerVideosInicio();
const fotosSede = await obtenerFotosSede();
const fotosMonturas = await obtenerFotosMonturas();

// Mapeo resiliente por título/palabra clave con fallback posicional
const videoInfantil = videosInicio.procedimientos.find((v) =>
  /infan/i.test(v.titulo)
) ?? videosInicio.procedimientos[0];

const videoVolk = videosInicio.procedimientos.find((v) =>
  /volk/i.test(v.titulo)
) ?? videosInicio.procedimientos[1];

const videoFarnsworth = videosInicio.procedimientos.find((v) =>
  /farnsworth/i.test(v.titulo)
) ?? videosInicio.procedimientos[2];
---

<Layout
  title="Óptica Alemania Villavicencio | Optometría y salud visual"
  description="Conoce Óptica Alemania Villavicencio: atención optométrica, evaluaciones visuales y monturas. Visítanos en Barzal o contáctanos por WhatsApp."
  currentPath="/"
  headerTheme="light"
>
  <Hero />
  <AboutSection />
  <ArrivalSection
    videoUrl={videosInicio.atencion?.url}
    posterUrl={videosInicio.atencion?.portada}
  />
  <ServicesSection />
  <TechSection
    volkVideo={videoVolk}
    farnsworthVideo={videoFarnsworth}
  />
  <SpaceSection images={fotosSede} />
  <KidsVisionSection
    videoUrl={videoInfantil?.url}
    posterUrl={videoInfantil?.portada}
  />
  <FramesSection categories={fotosMonturas} />
  <CofremSection />
  <TrajectorySection />
  <ReviewsSection />
  <ContactSection
    routeVideo={videosInicio.comoLlegar}
  />
  <Footer />
</Layout>
