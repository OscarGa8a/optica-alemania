---
// Sección 2 — Ubicación y Video de Recorrido
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import VideoModal from '../ui/VideoModal.astro';

const { contact, contactSection } = siteConfig;
const googleMapsUrl = contact.googleMapsUrl;
const modalId = 'contact-page-como-llegar-video-modal';
---

<section id="ubicacion" class="relative overflow-hidden">
  
  <!-- Sub-sección 1: Encuéntranos en Villavicencio -->
  <div class="relative bg-gradient-to-br from-brand-surface via-brand-cool to-brand-mist/70 py-14 sm:py-20 lg:py-24 overflow-hidden">
    <!-- Ambient soft clinic light waves matching mockup -->
    <div
      class="absolute -bottom-24 right-0 w-96 sm:w-144 h-96 sm:h-144 bg-brand-ice/50 rounded-full blur-3xl pointer-events-none select-none z-0"
      aria-hidden="true"
    ></div>

    <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Details & Direction (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col">
          <!-- Eyebrow -->
          <div>
            <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
              ENCUÉNTRANOS EN VILLAVICENCIO
            </span>
          </div>

          <!-- H2 Heading -->
          <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-brand-heading tracking-tight leading-none mt-4 sm:mt-6">
            <span class="block font-normal">Nos vemos en</span>
            <span class="block italic font-normal text-brand-primary">Barzal.</span>
          </h2>

          <!-- Description -->
          <p class="mt-4 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-brand-body leading-relaxed max-w-md sm:max-w-lg">
            Visítanos en nuestra sede y encuentra toda la información que necesitas para llegar.
          </p>

          <!-- Contact List (Vertical stack across all viewports matching mockup) -->
          <div data-contact-list class="flex flex-col gap-5 sm:gap-6 mt-7 sm:mt-9">
            
            <!-- Dirección -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-mist flex items-center justify-center text-brand-primary shrink-0">
                <Icon name="map-pin" class="w-5 h-5 stroke-current stroke-2" />
              </div>
              <div>
                <p class="text-sm sm:text-base font-semibold text-brand-primary">Dirección</p>
                <p class="text-brand-heading text-sm sm:text-base lg:text-lg font-normal mt-0.5">
                  {contact.address}, {contact.city}
                </p>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-mist flex items-center justify-center text-brand-primary shrink-0">
                <Icon name="clock" class="w-5 h-5 stroke-current stroke-2" />
              </div>
              <div>
                <p class="text-sm sm:text-base font-semibold text-brand-primary">Horarios</p>
                <div class="text-brand-heading text-sm sm:text-base lg:text-lg font-normal mt-0.5 leading-snug">
                  <p>{contact.scheduleWeekdays}</p>
                  <p>{contact.scheduleSaturday}</p>
                </div>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-mist flex items-center justify-center text-brand-primary shrink-0">
                <Icon name="phone" class="w-5 h-5 stroke-current stroke-2" />
              </div>
              <div>
                <p class="text-sm sm:text-base font-semibold text-brand-primary">Teléfono</p>
                <p class="text-brand-heading text-sm sm:text-base lg:text-lg font-normal mt-0.5">
                  <a href={`tel:${contact.phoneTel}`} class="hover:text-brand-primary transition-colors">
                    +57 {contact.phonePrimary}
                  </a>
                </p>
              </div>
            </div>

          </div>

          <!-- Cómo llegar Outlined Pill Button matching mockup -->
          <div class="mt-7 sm:mt-9">
            <Button
              variant="secondary"
              size="md"
              href={googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-event="google_maps_click"
              data-event-location="contact_location_cta"
              icon="arrow-right"
              class="min-w-52 sm:min-w-56 justify-between border-brand-primary text-brand-primary hover:bg-brand-mist"
              aria-label="Abrir indicaciones para llegar a Óptica Alemania en Google Maps"
            >
              <span class="inline-flex items-center gap-2.5">
                <Icon name="navigation" class="w-4 h-4 stroke-current stroke-2" />
                <span>Cómo llegar</span>
              </span>
            </Button>
          </div>

        </div>

        <!-- Right Column: Illustrated Map Card (col-span-7) -->
        <div class="lg:col-span-7 w-full">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="google_maps_click"
            data-event-location="contact_location_map"
            class="group block relative w-full rounded-2xl lg:rounded-3xl overflow-hidden border border-brand-border shadow-md hover:shadow-xl transition-all duration-300 bg-brand-surface"
            aria-label="Abrir mapa de ubicación de Óptica Alemania Barzal en Google Maps"
          >
            <img
              src="/images/contact/2_ubicacion_map.webp"
              alt="Mapa ilustrado de ubicación de Óptica Alemania en Calle 35 #34-36, Barzal, Villavicencio"
              width="1656"
              height="811"
              loading="eager"
              decoding="async"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Sub-sección 2: Te mostramos el camino (Full-width light blue band) -->
  <div class="relative bg-gradient-to-br from-brand-mist/80 via-brand-cool to-brand-surface border-t border-brand-border py-12 sm:py-16 lg:py-20 overflow-hidden">
    <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
        
        <!-- Left Column: Copy & Title (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col">
          <div>
            <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
              TE MOSTRAMOS EL CAMINO
            </span>
          </div>

          <h3 class="font-display text-4xl sm:text-5xl lg:text-6xl font-normal text-brand-heading tracking-tight leading-tight mt-3 sm:mt-4">
            ¿Es tu primera visita?
          </h3>

          <p class="mt-3 sm:mt-4 text-sm sm:text-base lg:text-lg xl:text-xl text-brand-body leading-relaxed max-w-md sm:max-w-lg">
            Mira nuestro video y conoce el recorrido para llegar a Óptica Alemania.
          </p>
        </div>

        <!-- Right Column: Full-Width Panoramic Route Video Banner matching mockup (col-span-7) -->
        <div class="lg:col-span-7 w-full">
          <button
            type="button"
            data-open-video-modal={modalId}
            data-event="route_video_click"
            data-event-location="contact_tour_video"
            class="group relative block w-full rounded-2xl lg:rounded-3xl overflow-hidden shadow-md hover:shadow-xl border border-white/80 aspect-21/9 sm:aspect-12/5 bg-brand-midnight cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            aria-label="Reproducir video del recorrido para llegar a Óptica Alemania en Barzal"
          >
            <picture>
              <source srcset="/images/contact/2_ubicacion_image.webp" type="image/webp" />
              <img
                src="/images/contact/2_ubicacion_image.png"
                alt={contactSection.facadeImage.alt}
                width={contactSection.facadeImage.width}
                height={contactSection.facadeImage.height}
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
            </picture>

            <!-- Subtle bottom vignette for crisp white label readability -->
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent pointer-events-none"
              aria-hidden="true"
            ></div>

            <!-- Centered White Play Button + "Ver cómo llegar" label matching mockup -->
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 sm:gap-2.5 pointer-events-none">
              <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-white text-brand-primary flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110">
                <Icon name="play" class="w-5 h-5 sm:w-6 sm:h-6 fill-current ml-0.5" />
              </div>
              <span class="text-white text-xs sm:text-sm lg:text-base font-medium drop-shadow-xs">
                Ver cómo llegar
              </span>
            </div>

            <!-- Bottom-Right Duration Badge -->
            <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 pointer-events-none">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-brand-heading/85 backdrop-blur-xs text-white text-xs font-semibold tabular-nums">
                {contactSection.routeVideo.duration}
              </span>
            </div>
          </button>
        </div>

      </div>
    </div>
  </div>

  <VideoModal
    id={modalId}
    src={contactSection.routeVideo.videoSrc}
    poster="/images/contact/2_ubicacion_image.webp"
    pngFallback="/images/contact/2_ubicacion_image.png"
    alt={contactSection.facadeImage.alt}
    eyebrow="TE MOSTRAMOS EL CAMINO"
    title="Cómo llegar a Óptica Alemania en Barzal"
  />
</section>
