---
// Hero Servicios — mirrors Home/About hero sizing, typography and layout.
// All copy and images come from siteConfig.servicesPage.hero.
import { siteConfig } from '../../data/siteConfig';
import Button from '../ui/Button.astro';

const { hero } = siteConfig.servicesPage;
---

<section
  id="hero-servicios"
  class="relative w-full min-h-[100dvh] flex flex-col justify-start lg:justify-center overflow-hidden bg-white"
  aria-labelledby="servicios-hero-title"
>
  <!-- Full-bleed Background Image occupying 100% width and 100% height of the Hero -->
  <div class="absolute inset-0 w-full h-full z-0 select-none pointer-events-none">
    <picture class="block w-full h-full">
      <!-- Mobile source (< 1024px) -->
      <source media="(max-width: 1023px)" srcset={hero.images.mobile.src} type="image/webp" />
      <!-- Desktop source (>= 1024px) -->
      <source media="(min-width: 1024px)" srcset={hero.images.desktop.src} type="image/webp" />
      <!-- Fallback image -->
      <img
        src={hero.images.desktop.src}
        alt={hero.images.desktop.alt}
        width={hero.images.desktop.width}
        height={hero.images.desktop.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center lg:object-right"
      />
    </picture>

    <!-- Desktop gradient: covers the left half for editorial legibility -->
    <div class="hidden lg:block absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-white via-white/80 to-transparent pointer-events-none"></div>

    <!-- Mobile gradient: top-down for full text and button legibility -->
    <div class="block lg:hidden absolute inset-0 bg-gradient-to-b from-white/95 via-white/85 via-[52%] to-transparent to-[60%] pointer-events-none"></div>
  </div>

  <!-- Content Container: aligned left with the header -->
  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-20 pb-8 sm:pt-24 sm:pb-12 lg:py-24">
    <div class="max-w-xl lg:max-w-2xl xl:max-w-3xl 2xl:max-w-4xl flex flex-col items-start">
      <!-- Eyebrow -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-[0.2em] text-brand-primary">
          {hero.eyebrow}
        </span>
      </div>

      <!-- Hero Heading H1: Fluid Instrument Serif scaling smoothly with screen width -->
      <h1
        id="servicios-hero-title"
        class="font-display text-[clamp(2.15rem,1.25rem+3.6vw,5.5rem)] text-brand-heading leading-tight tracking-tight mt-3 sm:mt-6"
      >
        <span class="block">{hero.titlePart1}</span>
        <span class="block">{hero.titlePart2}</span>
        <span class="block italic text-brand-primary font-normal">{hero.titleHighlight}</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-slate-800 font-medium sm:font-normal leading-relaxed max-w-md sm:max-w-lg xl:max-w-xl">
        {hero.description}
      </p>

      <!-- CTA: Explorar servicios -->
      <div class="mt-5 sm:mt-10">
        <Button
          variant="link"
          size="lg"
          href={hero.exploreHref}
          icon="arrow-right"
          data-event="services_explore_click"
          data-event-location="services_hero"
        >
          {hero.exploreText}
        </Button>
      </div>
    </div>
  </div>
</section>
