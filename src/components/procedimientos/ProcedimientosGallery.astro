---
// Sección 4 — Galería: Más de Nuestro Trabajo
// Óptica Alemania Villavicencio
---

<section id="nuestro-trabajo" class="relative bg-white py-16 sm:py-24 lg:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="flex items-center gap-3">
        <span class="text-xs uppercase font-semibold tracking-[0.2em] text-brand-primary">
          MÁS DE NUESTRO TRABAJO
        </span>
        <span class="w-12 h-[1.5px] bg-[#9BB0CE]" aria-hidden="true"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.25rem] font-display font-normal text-brand-heading tracking-tight leading-[1.1] mt-4 sm:mt-5">
        La atención está en <span class="italic text-brand-primary">cada detalle.</span>
      </h2>

      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-body leading-relaxed font-normal max-w-2xl">
        Conoce otros momentos de las evaluaciones visuales que realizamos en Óptica Alemania.
      </p>
    </div>

    <!-- 2 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Card 1: Evaluación optométrica -->
      <div class="group flex flex-col">
        <div class="relative rounded-2xl sm:rounded-3xl shadow-lg overflow-hidden bg-slate-900 border border-slate-100">
          <picture>
            <source srcset="/images/procedimientos/4_nuestro_trabajo_image1.webp" type="image/webp" />
            <img
              src="/images/procedimientos/4_nuestro_trabajo_image1.png"
              alt="Evaluación optométrica completa con tecnología especializada en Óptica Alemania"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="w-full h-auto aspect-[4/3] object-cover transform duration-500 group-hover:scale-[1.01]"
            />
          </picture>

          <!-- Mockup Video Controls Overlay Bar -->
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent px-4 sm:px-5 pt-8 pb-3.5 sm:pb-4 flex items-center gap-3 text-white select-none">
            <!-- Pause Icon -->
            <button
              type="button"
              class="text-white hover:text-brand-bright transition-colors focus:outline-none"
              aria-label="Pausar video"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16" rx="1"></rect>
                <rect x="14" y="4" width="4" height="16" rx="1"></rect>
              </svg>
            </button>

            <!-- Timestamp -->
            <span class="text-xs font-sans tracking-tight text-white/90 shrink-0">
              0:10 / 0:45
            </span>

            <!-- Progress Scrubber -->
            <div class="relative flex-1 h-1 bg-white/30 rounded-full cursor-pointer flex items-center">
              <div class="h-full bg-brand-primary rounded-full w-[22%]"></div>
              <div class="absolute left-[22%] -translate-x-1/2 w-2.5 h-2.5 bg-white rounded-full shadow-md"></div>
            </div>

            <!-- Volume / Mute Icon -->
            <button
              type="button"
              class="text-white/90 hover:text-white transition-colors focus:outline-none"
              aria-label="Silenciar o activar audio"
            >
              <svg class="w-3.5 h-3.5 stroke-current shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
            </button>

            <!-- Fullscreen Icon -->
            <button
              type="button"
              class="text-white/90 hover:text-white transition-colors focus:outline-none"
              aria-label="Pantalla completa"
            >
              <svg class="w-3.5 h-3.5 stroke-current shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-5">
          <h3 class="text-2xl sm:text-[1.75rem] font-display font-normal text-brand-heading tracking-tight">
            Evaluación optométrica
          </h3>
          <p class="mt-2 text-sm sm:text-base text-brand-body leading-relaxed font-normal">
            Una evaluación completa y detallada de la salud visual con tecnología de precisión.
          </p>
        </div>
      </div>

      <!-- Card 2: Atención visual infantil -->
      <div class="group flex flex-col">
        <div class="relative rounded-2xl sm:rounded-3xl shadow-lg overflow-hidden bg-slate-900 border border-slate-100">
          <picture>
            <source srcset="/images/procedimientos/4_nuestro_trabajo_image2.webp" type="image/webp" />
            <img
              src="/images/procedimientos/4_nuestro_trabajo_image2.png"
              alt="Atención visual infantil y valoraciones adaptadas en Óptica Alemania"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="w-full h-auto aspect-[4/3] object-cover transform duration-500 group-hover:scale-[1.01]"
            />
          </picture>

          <!-- Mockup Video Controls Overlay Bar -->
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent px-4 sm:px-5 pt-8 pb-3.5 sm:pb-4 flex items-center gap-3 text-white select-none">
            <!-- Pause Icon -->
            <button
              type="button"
              class="text-white hover:text-brand-bright transition-colors focus:outline-none"
              aria-label="Pausar video"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16" rx="1"></rect>
                <rect x="14" y="4" width="4" height="16" rx="1"></rect>
              </svg>
            </button>

            <!-- Timestamp -->
            <span class="text-xs font-sans tracking-tight text-white/90 shrink-0">
              0:08 / 0:36
            </span>

            <!-- Progress Scrubber -->
            <div class="relative flex-1 h-1 bg-white/30 rounded-full cursor-pointer flex items-center">
              <div class="h-full bg-brand-primary rounded-full w-[24%]"></div>
              <div class="absolute left-[24%] -translate-x-1/2 w-2.5 h-2.5 bg-white rounded-full shadow-md"></div>
            </div>

            <!-- Volume / Mute Icon -->
            <button
              type="button"
              class="text-white/90 hover:text-white transition-colors focus:outline-none"
              aria-label="Silenciar o activar audio"
            >
              <svg class="w-3.5 h-3.5 stroke-current shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
            </button>

            <!-- Fullscreen Icon -->
            <button
              type="button"
              class="text-white/90 hover:text-white transition-colors focus:outline-none"
              aria-label="Pantalla completa"
            >
              <svg class="w-3.5 h-3.5 stroke-current shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-5">
          <h3 class="text-2xl sm:text-[1.75rem] font-display font-normal text-brand-heading tracking-tight">
            Atención visual infantil
          </h3>
          <p class="mt-2 text-sm sm:text-base text-brand-body leading-relaxed font-normal">
            Cuidado especializado y adaptado a las necesidades de los más pequeños con paciencia y calidez.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
