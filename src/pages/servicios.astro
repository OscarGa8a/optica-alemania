---
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/services/ServicesHero.astro';
import ServicesOverview from '../components/services/ServicesOverview.astro';
import VisualCareDetail from '../components/services/VisualCareDetail.astro';
import SpecializedTests from '../components/services/SpecializedTests.astro';
import EyeEmergencies from '../components/services/EyeEmergencies.astro';
import ProceduresPreview from '../components/services/ProceduresPreview.astro';
import ServicesFaq from '../components/services/ServicesFaq.astro';
import ServicesCta from '../components/services/ServicesCta.astro';
import Footer from '../components/Footer.astro';
import { obtenerVideosProcedimientos } from '../lib/sanity/videos';

const videos = await obtenerVideosProcedimientos();
const videoVolk = videos.find((v) => /volk/i.test(v.titulo)) ?? videos[1];
const videoFarnsworth = videos.find((v) => /farnsworth/i.test(v.titulo)) ?? videos[2];
---

<Layout
  title="Servicios de optometría | Óptica Alemania Villavicencio"
  description="Conoce los servicios de Óptica Alemania Villavicencio: consulta de optometría, lentes de contacto y evaluaciones visuales especializadas."
  currentPath="/servicios"
  navVariant="light"
>
  <ServicesHero />
  <ServicesOverview />
  <VisualCareDetail />
  <SpecializedTests />
  <EyeEmergencies />
  <ProceduresPreview
    volkVideo={videoVolk}
    farnsworthVideo={videoFarnsworth}
  />
  <ServicesFaq />
  <ServicesCta />
  <Footer />
</Layout>
