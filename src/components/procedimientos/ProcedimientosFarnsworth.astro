---
// Sección 3 — Visión del Color (Test de Farnsworth D-15)
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import VideoPlayer from '../ui/VideoPlayer.astro';

const { farnsworth } = siteConfig.procedimientosPage;
const whatsappUrl = buildWhatsAppLink(
  farnsworth.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id={farnsworth.id}
  class="relative bg-[#F8FAFC] text-brand-body py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20 lg:scroll-mt-24"
  aria-labelledby="farnsworth-heading"
>
  <!-- Subtle decorative gradient accents matching Figma -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Mobile-only Eyebrow & H2 (above video on mobile matching mockup) -->
    <div class="lg:hidden mb-6">
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {farnsworth.eyebrow}
        </span>
      </div>

      <h2 class="font-display text-[2.6rem] sm:text-5xl text-brand-heading leading-[1.04] tracking-tight mt-3">
        <span class="block font-normal">{farnsworth.titleLine1}</span>
        <span class="block font-normal">{farnsworth.titleLine2}</span>
        <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine1 || farnsworth.titleHighlight}</span>
        {farnsworth.titleHighlightLine2 && (
          <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine2}</span>
        )}
      </h2>
    </div>

    <!-- Main Grid: Editorial Content on Left (5 cols) / Video on Right (7 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
      
      <!-- Left Column on Desktop, Bottom on Mobile: Text & CTA Button -->
      <div class="order-3 lg:order-1 lg:col-span-5">
        <div class="max-w-xl">
          <!-- Desktop Eyebrow & H2 -->
          <div class="hidden lg:block">
            <div>
              <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
                {farnsworth.eyebrow}
              </span>
            </div>

            <h2
              id="farnsworth-heading"
              class="font-display text-4xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] 2xl:text-[4.25rem] text-brand-heading leading-[1.04] tracking-tight mt-3 sm:mt-5"
            >
              <span class="block font-normal">{farnsworth.titleLine1}</span>
              <span class="block font-normal">{farnsworth.titleLine2}</span>
              <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine1 || farnsworth.titleHighlight}</span>
              {farnsworth.titleHighlightLine2 && (
                <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine2}</span>
              )}
            </h2>
          </div>

          <!-- Descriptive Paragraph matching mockup -->
          <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-6 font-normal">
            {farnsworth.description}
          </p>

          <!-- WhatsApp Pill Button using Button.astro and Icon.astro -->
          <div class="mt-6 sm:mt-8">
            <Button
              variant="primary"
              size="lg"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-event="whatsapp_cta"
              data-event-location="procedimientos_farnsworth"
              icon="arrow-right"
              iconPosition="right"
              aria-label={`${farnsworth.ctaText} - ${siteConfig.name}`}
              class="w-full sm:w-auto inline-flex items-center !justify-between sm:!justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4"
            >
              <span class="inline-flex items-center gap-2.5">
                <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
                <span class="text-sm sm:text-base font-semibold whitespace-nowrap">{farnsworth.ctaText}</span>
              </span>
            </Button>
          </div>
        </div>
      </div>

      <!-- Right Column on Desktop, Middle on Mobile: Video Player Card -->
      <div class="order-2 lg:order-2 lg:col-span-7">
        <VideoPlayer
          id={farnsworth.videoId}
          poster={farnsworth.video.poster}
          pngFallback={farnsworth.video.pngFallback}
          alt={farnsworth.video.alt}
          initialTimestamp={farnsworth.video.initialTimestamp}
          initialProgress={farnsworth.video.initialProgress}
        />
      </div>

    </div>
  </div>
</section>

<script>
  function setupFarnsworthVideo() {
    const section = document.getElementById('farnsworth');
    const video = document.getElementById('farnsworth-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const playToggle = document.getElementById('farnsworth-video-play-toggle');
    const pauseIcon = document.getElementById('farnsworth-video-pause-icon');
    const playIcon = document.getElementById('farnsworth-video-play-icon');
    const muteToggle = document.getElementById('farnsworth-video-mute-toggle');
    const muteIcon = document.getElementById('farnsworth-video-mute-icon');
    const unmuteIcon = document.getElementById('farnsworth-video-unmute-icon');
    const timestamp = document.getElementById('farnsworth-video-timestamp');
    const progressFill = document.getElementById('farnsworth-video-progress-fill');
    const progressThumb = document.getElementById('farnsworth-video-progress-thumb');
    const progressBar = document.getElementById('farnsworth-video-progress-bar');
    const fullscreenToggle = document.getElementById('farnsworth-video-fullscreen-toggle');

    let userManuallyPaused = false;

    function formatTime(seconds: number) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function updatePlayState(isPlaying: boolean) {
      if (pauseIcon && playIcon) {
        if (isPlaying) {
          pauseIcon.classList.remove('hidden');
          pauseIcon.classList.add('block');
          playIcon.classList.remove('block');
          playIcon.classList.add('hidden');
        } else {
          pauseIcon.classList.remove('block');
          pauseIcon.classList.add('hidden');
          playIcon.classList.remove('hidden');
          playIcon.classList.add('block');
        }
      }
    }

    // IntersectionObserver: auto-play when entering viewport, auto-pause when leaving
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reducedMotion && !userManuallyPaused && video.currentSrc) {
              video.play().then(() => {
                updatePlayState(true);
              }).catch(() => {
                updatePlayState(false);
              });
            }
          } else {
            if (video.currentSrc && !video.paused) {
              video.pause();
              updatePlayState(false);
            }
          }
        });
      },
      {
        threshold: 0.35,
        rootMargin: '0px'
      }
    );

    observer.observe(section);

    playToggle?.addEventListener('click', () => {
      if (video.currentSrc) {
        if (video.paused) {
          userManuallyPaused = false;
          video.play().then(() => updatePlayState(true)).catch(() => {});
        } else {
          userManuallyPaused = true;
          video.pause();
          updatePlayState(false);
        }
      }
    });

    muteToggle?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (muteIcon && unmuteIcon) {
        if (video.muted) {
          muteIcon.classList.remove('hidden');
          muteIcon.classList.add('block');
          unmuteIcon.classList.remove('block');
          unmuteIcon.classList.add('hidden');
        } else {
          muteIcon.classList.remove('block');
          muteIcon.classList.add('hidden');
          unmuteIcon.classList.remove('hidden');
          unmuteIcon.classList.add('block');
        }
      }
    });

    video.addEventListener('timeupdate', () => {
      if (!video.duration) return;
      const progress = (video.currentTime / video.duration) * 100;
      if (progressFill) progressFill.style.width = `${progress}%`;
      if (progressThumb) progressThumb.style.left = `${progress}%`;
      if (timestamp) {
        timestamp.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
      }
      if (progressBar) {
        progressBar.setAttribute('aria-valuenow', Math.round(progress).toString());
      }
    });

    progressBar?.addEventListener('click', (e) => {
      const rect = progressBar.getBoundingClientRect();
      const pos = (e.clientX - rect.left) / rect.width;
      if (video.duration) {
        video.currentTime = pos * video.duration;
      }
    });

    fullscreenToggle?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        video.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });
  }

  document.addEventListener('astro:page-load', setupFarnsworthVideo);
</script>
