---
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';

interface Props {
  currentPath?: string;
  variant?: 'transparent' | 'light';
}

const { currentPath = '/', variant = 'transparent' } = Astro.props;
const isLight = variant === 'light';
const whatsappUrl = buildWhatsAppLink('Hola, deseo solicitar atención en Óptica Alemania.', siteConfig.contact.whatsappNumber);
---

<header
  id="site-header"
  data-variant={variant}
  class:list={[
    "fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300",
    isLight
      ? "bg-white/95 backdrop-blur-md shadow-xs"
      : "bg-transparent border-b border-transparent"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center group transition-transform duration-200" aria-label="Óptica Alemania - Inicio">
        {isLight ? (
          <img
            src="/images/home/10_footer_logo.webp"
            alt="Óptica Alemania"
            width="808"
            height="242"
            class="h-8 sm:h-9 w-auto object-contain"
          />
        ) : (
          <div class="flex flex-col">
            <span
              id="brand-logo-text"
              class="font-display text-2xl sm:text-3xl font-normal text-white lg:text-brand-heading tracking-tight leading-none group-hover:text-brand-primary transition-colors"
            >
              Óptica Alemania
            </span>
            <span
              id="brand-logo-sub"
              class="font-sans text-[9px] sm:text-[10px] tracking-[0.28em] text-white/85 lg:text-brand-body uppercase mt-1 transition-colors"
            >
              Villavicencio
            </span>
          </div>
        )}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        {siteConfig.nav.map((item) => {
          const isActive = item.href === currentPath || (currentPath === '/servicios' && item.href.includes('servicios')) || item.active;
          return (
            <a
              href={item.href}
              class:list={[
                "relative py-2 text-sm font-medium transition-colors duration-200",
                isActive 
                  ? "text-brand-primary font-semibold" 
                  : "text-brand-heading/85 hover:text-brand-primary"
              ]}
            >
              {item.label}
              {isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-brand-primary rounded-full" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Action Button & Mobile Controls -->
      <div class="flex items-center gap-3">
        <!-- WhatsApp CTA Button -->
        <a
          id="navbar-cta-btn"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_cta"
          data-event-location="header_cta"
          aria-label="Escríbenos por WhatsApp con Óptica Alemania"
          class:list={[
            "items-center gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide shadow-sm hover:shadow active:scale-[0.98] transition-all duration-200",
            isLight
              ? "hidden lg:inline-flex border-transparent bg-brand-primary text-white hover:bg-brand-bright"
              : "inline-flex border border-white/80 text-white bg-white/10 backdrop-blur-xs lg:border-transparent lg:bg-brand-primary lg:text-white lg:hover:bg-brand-bright"
          ]}
        >
          <!-- WhatsApp SVG Icon -->
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
          </svg>
          <span class="hidden sm:inline">Escríbenos por WhatsApp</span>
          <span class="sm:hidden">WhatsApp</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-button"
          class:list={[
            "lg:hidden inline-flex items-center justify-center p-2 rounded-lg transition-colors",
            isLight
              ? "text-brand-primary hover:bg-brand-cool/80"
              : "text-white hover:bg-white/15"
          ]}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" id="hamburger-icon"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" class="hidden" id="close-icon"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer / Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-white/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-2 shadow-xl">
    {siteConfig.nav.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-brand-heading hover:bg-brand-cool hover:text-brand-primary transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const brandLogoText = document.getElementById('brand-logo-text');
  const brandLogoSub = document.getElementById('brand-logo-sub');
  const navbarCtaBtn = document.getElementById('navbar-cta-btn');
  const isLightVariant = header?.dataset.variant === 'light';

  if (button && menu && hamburgerIcon && closeIcon) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    const links = menu.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Header scroll appearance for transparent variant
  function updateHeaderState() {
    if (!header || isLightVariant) return;
    const isScrolled = window.scrollY > 20;

    if (isScrolled) {
      header.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-xs', 'border-brand-border/40');
      header.classList.remove('bg-transparent', 'border-transparent');
      
      // Update mobile colors for white background
      brandLogoText?.classList.remove('text-white');
      brandLogoText?.classList.add('text-brand-heading');
      brandLogoSub?.classList.remove('text-white/85');
      brandLogoSub?.classList.add('text-brand-body');
      
      button?.classList.remove('text-white', 'hover:bg-white/15');
      button?.classList.add('text-brand-heading', 'hover:bg-brand-cool/80');

      navbarCtaBtn?.classList.remove('border-white/80', 'text-white', 'bg-white/10');
      navbarCtaBtn?.classList.add('border-transparent', 'bg-brand-primary', 'text-white');
    } else {
      header.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-xs', 'border-brand-border/40');
      header.classList.add('bg-transparent', 'border-transparent');

      // Restore mobile colors for transparent over hero background
      brandLogoText?.classList.add('text-white');
      brandLogoText?.classList.remove('text-brand-heading');
      brandLogoSub?.classList.add('text-white/85');
      brandLogoSub?.classList.remove('text-brand-body');

      button?.classList.add('text-white', 'hover:bg-white/15');
      button?.classList.remove('text-brand-heading', 'hover:bg-brand-cool/80');

      navbarCtaBtn?.classList.add('border-white/80', 'text-white', 'bg-white/10');
      navbarCtaBtn?.classList.remove('border-transparent', 'bg-brand-primary');
    }
  }

  if (!isLightVariant) {
    window.addEventListener('scroll', updateHeaderState, { passive: true });
    updateHeaderState();
  }
</script>
