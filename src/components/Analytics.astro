---
// PLAYBOOK Fase 7: Despachador Centralizado de Eventos para GTM / GA4 / Meta Pixel
---

<script is:inline>
  document.addEventListener('click', (event) => {
    const origin = event.target;
    if (!(origin instanceof Element)) return;

    let target = origin.closest('[data-event]');

    // Fallback defensivo para enlaces telefónicos, WhatsApp o Google Maps sin data-event explícito
    if (!target) {
      const anchor = origin.closest('a');
      if (anchor instanceof HTMLAnchorElement) {
        const href = anchor.getAttribute('href') || '';
        if (
          href.startsWith('tel:') ||
          href.includes('wa.me') ||
          href.includes('whatsapp.com') ||
          href.includes('maps.app.goo.gl') ||
          href.includes('google.com/maps') ||
          href.includes('maps.google.') ||
          href.includes('search.google.com/local')
        ) {
          target = anchor;
        }
      }
    }

    if (!(target instanceof HTMLElement)) return;

    const isAnchor = target instanceof HTMLAnchorElement;
    const href = isAnchor ? (target.getAttribute('href') || '') : '';
    const isTel = href.startsWith('tel:');
    const isWa = href.includes('wa.me') || href.includes('whatsapp.com');
    const isMaps = href.includes('maps.app.goo.gl') || href.includes('google.com/maps') || href.includes('maps.google.') || href.includes('search.google.com/local');

    const ctaType = target.dataset.event || (isTel ? 'phone_call' : isWa ? 'whatsapp_cta' : isMaps ? 'google_maps_click' : '');
    if (!ctaType) return;

    const location = target.dataset.eventLocation || (isTel ? 'tel_link' : isWa ? 'whatsapp_link' : isMaps ? 'maps_link' : '');
    const label = target.dataset.eventLabel || target.textContent?.trim() || (isMaps ? 'Google Maps' : '');
    const destination = isAnchor ? target.href : '';
    const service = target.dataset.eventService;
    const item = target.dataset.eventItem;
    const category = target.dataset.eventCategory;
    const network = target.dataset.eventNetwork;

    const detail = {
      event: ctaType,
      location,
      label,
      destination,
      ...(service && { service }),
      ...(item && { item }),
      ...(category && { category }),
      ...(network && { network }),
    };

    window.dispatchEvent(new CustomEvent('optica:event', { detail }));

    // Buffer en dataLayer con nombre de evento unificado para GTM/GA4
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'cta_click',
      cta_type: ctaType,
      location,
      label,
      destination,
      ...(service && { service }),
      ...(item && { item }),
      ...(category && { category }),
      ...(network && { network }),
    });

    // Carga inmediata de GTM si el usuario interactuó antes del temporizador
    if (typeof window._loadGTM === 'function') {
      window._loadGTM();
    }
  });
</script>
