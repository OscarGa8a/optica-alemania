---
// Reusable Video Player Card with Overlay Controls
// Uses Icon.astro for all control icons
import Icon from './Icon.astro';

interface Props {
  id: string;
  src?: string;
  poster: string;
  pngFallback?: string;
  alt: string;
  label?: string;
  initialTimestamp?: string;
  initialProgress?: number;
  class?: string;
}

const {
  id,
  src,
  poster,
  pngFallback,
  alt,
  label = 'Video demostrativo en Óptica Alemania Villavicencio',
  initialTimestamp = '0:00 / 0:30',
  initialProgress = 0,
  class: className = '',
} = Astro.props;
---

<div
  data-video-player-container={id}
  class:list={[
    'relative rounded-2xl sm:rounded-3xl shadow-xl overflow-hidden bg-slate-900 group border border-slate-100 aspect-video',
    className,
  ]}
>
  <!-- Video element with poster and picture fallback -->
  <video
    id={id}
    src={src}
    class="w-full h-full object-cover cursor-pointer"
    poster={poster}
    muted
    playsinline
    loop
    preload="metadata"
    aria-label={label}
  >
    {src && <source src={src} type="video/mp4" />}
    <picture>
      <source srcset={poster} type="image/webp" />
      <img
        src={pngFallback || poster}
        alt={alt}
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </picture>
  </video>

  <!-- Interactive Video Controls Overlay Bar -->
  <div
    class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent px-4 sm:px-6 pt-10 pb-4 sm:pb-5 flex items-center gap-3 sm:gap-4 text-white select-none z-10"
  >
    <!-- Pause/Play Toggle Button -->
    <button
      type="button"
      id={`${id}-play-toggle`}
      class="text-white hover:text-brand-bright transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded p-0.5 cursor-pointer"
      aria-label="Pausar o reproducir video"
    >
      <span id={`${id}-pause-icon`} class="hidden">
        <Icon name="pause" class="w-4 h-4 fill-current" />
      </span>
      <span id={`${id}-play-icon`} class="block">
        <Icon name="play" class="w-4 h-4 fill-current" />
      </span>
    </button>

    <!-- Timestamp -->
    <span
      id={`${id}-timestamp`}
      class="text-xs sm:text-sm font-sans tracking-tight text-white/90 shrink-0 tabular-nums"
    >
      {initialTimestamp}
    </span>

    <!-- Progress Scrubber -->
    <div
      id={`${id}-progress-bar`}
      class="relative flex-1 h-1.5 bg-white/30 rounded-full cursor-pointer flex items-center group/scrubber"
      role="progressbar"
      aria-valuenow={initialProgress}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Progreso del video"
    >
      <div
        id={`${id}-progress-fill`}
        class="h-full bg-brand-primary rounded-full transition-all duration-75"
        style={`width: ${initialProgress}%`}
      ></div>
      <div
        id={`${id}-progress-thumb`}
        class="absolute -translate-x-1/2 w-3 h-3 bg-white rounded-full shadow-md transition-all duration-75 group-hover/scrubber:scale-125"
        style={`left: ${initialProgress}%`}
      ></div>
    </div>

    <!-- Volume / Mute Toggle Button -->
    <button
      type="button"
      id={`${id}-mute-toggle`}
      class="text-white/90 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded p-0.5 cursor-pointer"
      aria-label="Silenciar o activar audio"
    >
      <span id={`${id}-mute-icon`} class="block">
        <Icon name="volume-x" class="w-4 h-4 stroke-current shrink-0" />
      </span>
      <span id={`${id}-unmute-icon`} class="hidden">
        <Icon name="volume-2" class="w-4 h-4 stroke-current shrink-0" />
      </span>
    </button>

    <!-- Fullscreen Button -->
    <button
      type="button"
      id={`${id}-fullscreen-toggle`}
      class="text-white/90 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded p-0.5 cursor-pointer"
      aria-label="Pantalla completa"
    >
      <Icon name="maximize" class="w-4 h-4 stroke-current shrink-0" />
    </button>
  </div>
</div>

<script>
  function initVideoPlayers() {
    const containers = document.querySelectorAll<HTMLElement>('[data-video-player-container]');

    function formatTime(seconds: number) {
      if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const id = container.dataset.videoPlayerContainer;
      if (!id) return;

      const video = document.getElementById(id) as HTMLVideoElement | null;
      if (!video) return;

      const playToggle = document.getElementById(`${id}-play-toggle`);
      const pauseIcon = document.getElementById(`${id}-pause-icon`);
      const playIcon = document.getElementById(`${id}-play-icon`);
      const muteToggle = document.getElementById(`${id}-mute-toggle`);
      const muteIcon = document.getElementById(`${id}-mute-icon`);
      const unmuteIcon = document.getElementById(`${id}-unmute-icon`);
      const timestamp = document.getElementById(`${id}-timestamp`);
      const progressFill = document.getElementById(`${id}-progress-fill`);
      const progressThumb = document.getElementById(`${id}-progress-thumb`);
      const progressBar = document.getElementById(`${id}-progress-bar`);
      const fullscreenToggle = document.getElementById(`${id}-fullscreen-toggle`);

      let userManuallyPaused = false;

      function updatePlayState(isPlaying: boolean) {
        if (pauseIcon && playIcon) {
          if (isPlaying) {
            pauseIcon.classList.remove('hidden');
            pauseIcon.classList.add('block');
            playIcon.classList.remove('block');
            playIcon.classList.add('hidden');
          } else {
            pauseIcon.classList.remove('block');
            pauseIcon.classList.add('hidden');
            playIcon.classList.remove('hidden');
            playIcon.classList.add('block');
          }
        }
      }

      function togglePlay() {
        if (!video) return;
        const hasSource = Boolean(video.currentSrc || video.getAttribute('src') || video.querySelector('source')?.getAttribute('src'));
        if (!hasSource) return;

        if (video.paused) {
          userManuallyPaused = false;
          video.play().then(() => updatePlayState(true)).catch(() => updatePlayState(false));
        } else {
          userManuallyPaused = true;
          video.pause();
          updatePlayState(false);
        }
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const hasSource = Boolean(video.currentSrc || video.getAttribute('src') || video.querySelector('source')?.getAttribute('src'));
            if (!hasSource) return;

            if (entry.isIntersecting) {
              const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if (!reducedMotion && !userManuallyPaused) {
                video.play().then(() => {
                  updatePlayState(true);
                }).catch(() => {
                  updatePlayState(false);
                });
              }
            } else {
              if (!video.paused) {
                video.pause();
                updatePlayState(false);
              }
            }
          });
        },
        {
          threshold: 0.4,
          rootMargin: '0px',
        }
      );

      observer.observe(container);

      playToggle?.addEventListener('click', togglePlay);
      video.addEventListener('click', togglePlay);

      video.addEventListener('play', () => updatePlayState(true));
      video.addEventListener('pause', () => updatePlayState(false));

      muteToggle?.addEventListener('click', () => {
        video.muted = !video.muted;
        if (muteIcon && unmuteIcon) {
          if (video.muted) {
            muteIcon.classList.remove('hidden');
            muteIcon.classList.add('block');
            unmuteIcon.classList.remove('block');
            unmuteIcon.classList.add('hidden');
          } else {
            muteIcon.classList.remove('block');
            muteIcon.classList.add('hidden');
            unmuteIcon.classList.remove('hidden');
            unmuteIcon.classList.add('block');
          }
        }
      });

      video.addEventListener('loadedmetadata', () => {
        if (video.duration && timestamp) {
          timestamp.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        }
      });

      video.addEventListener('timeupdate', () => {
        if (!video.duration) return;
        const progress = (video.currentTime / video.duration) * 100;
        if (progressFill) progressFill.style.width = `${progress}%`;
        if (progressThumb) progressThumb.style.left = `${progress}%`;
        if (timestamp) {
          timestamp.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        }
        if (progressBar) {
          progressBar.setAttribute('aria-valuenow', Math.round(progress).toString());
        }
      });

      progressBar?.addEventListener('click', (e) => {
        const rect = progressBar.getBoundingClientRect();
        const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        if (video.duration) {
          video.currentTime = pos * video.duration;
        }
      });

      fullscreenToggle?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          (container.requestFullscreen ? container.requestFullscreen() : video.requestFullscreen()).catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      });
    });
  }

  initVideoPlayers();
  document.addEventListener('astro:page-load', initVideoPlayers);
</script>
