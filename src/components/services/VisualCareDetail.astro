---
// Services — Atención visual detail: alternating image/text rows.
// All copy and images come from siteConfig.servicesPage.visualCare.
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';

const { visualCare } = siteConfig.servicesPage;
const { contact } = siteConfig;
---

<section
  id={visualCare.id}
  class="relative bg-white text-brand-body py-12 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
  aria-labelledby="visual-care-heading"
>
  <!-- Consistent fluid container matching Hero, Navbar, and /nosotros -->
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <!-- Section Header -->
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Eyebrow -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {visualCare.eyebrow}
        </span>
      </div>

      <h2
        id="visual-care-heading"
        class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
      >
        <span class="block font-normal">{visualCare.titlePart1}</span>
        <span class="block italic font-normal text-brand-primary">{visualCare.titleHighlight}</span>
      </h2>

      <p class="text-sm sm:text-lg text-brand-body leading-relaxed mt-3 sm:mt-6 max-w-lg">
        {visualCare.description}
      </p>
    </div>

    <!-- Alternating services -->
    <div class="mt-10 sm:mt-14 lg:mt-20 flex flex-col gap-12 sm:gap-16 lg:gap-24">
      {visualCare.items.map((item) => {
        const whatsappUrl = buildWhatsAppLink(item.whatsappMessage, contact.whatsappNumber);
        const isReversed = item.reverse;

        return (
          <article class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12 xl:gap-16 items-center">
            <!-- Image: first on mobile; left on desktop unless reversed -->
            <div class={`lg:col-span-7 order-1 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="group relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-video">
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  width={item.image.width}
                  height={item.image.height}
                  loading="lazy"
                  decoding="async"
                  class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out ${item.image.positionClass || 'object-center'}`}
                />
              </div>
            </div>

            <!-- Content: second on mobile; right on desktop unless reversed -->
            <div class={`lg:col-span-5 order-2 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <h3 class="font-display text-3xl sm:text-4xl lg:text-5xl text-brand-heading leading-[1.06] tracking-tight">
                <span class="block font-normal">{item.titleLine1}</span>
                <span class="block italic font-normal text-brand-primary">{item.titleLine2}</span>
              </h3>

              <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-3 sm:mt-5 max-w-lg">
                {item.description}
              </p>

              <div class="mt-5 sm:mt-8">
                <Button
                  variant="link"
                  size="lg"
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  icon="arrow-right"
                  data-event="service_detail_cta"
                  data-event-location="visual_care_detail"
                  data-event-service={item.serviceNumber}
                  aria-label={`${item.ctaText}: ${item.titleLine1} ${item.titleLine2}`}
                >
                  {item.ctaText}
                </Button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
