---
import { siteConfig } from '../data/siteConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const isNosotros = currentPath === '/nosotros' || currentPath === 'nosotros';
const isContacto = currentPath === '/contacto' || currentPath === 'contacto';
const isProcedimientos = currentPath === '/procedimientos' || currentPath === 'procedimientos';
const isSubpage = isNosotros || isContacto || isProcedimientos;
const { footer, contact } = siteConfig;

const navLinks = footer.navLinks.map((link) => {
  let href = link.href;
  if (isSubpage) {
    if (href === '#nosotros' || href === '/nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto' || href === '/contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos' || href === '/procedimientos') {
      href = '/procedimientos';
    } else if (href.startsWith('#')) {
      href = `/${href}`;
    }
  } else {
    if (href === '#nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos') {
      href = '/procedimientos';
    }
  }
  return { ...link, href };
});

const logoHref = isSubpage ? '/#inicio' : '#inicio';
---

<footer id="footer" class="relative bg-brand-heading text-white overflow-hidden border-t border-white/10">
  <!-- Background Watermark Graphic (Large Stylized Eye shifted right matching mockup) -->
  <div
    class="absolute right-0 translate-x-1/3 sm:translate-x-1/2 top-0 w-full max-w-lg sm:max-w-2xl lg:max-w-4xl xl:max-w-5xl pointer-events-none opacity-20 lg:opacity-25 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/home/footer_eye_watermark.webp"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-16 sm:pt-20 lg:pt-24 pb-12 lg:pb-16">
    <!-- Desktop Layout (3 Columns with Vertical Dividers) -->
    <div class="hidden lg:grid lg:grid-cols-12 lg:gap-0">
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-5 lg:border-r lg:border-white/10 lg:pr-10 flex flex-col justify-start">
        <a href={logoHref} class="inline-block transition-opacity hover:opacity-90" aria-label="Óptica Alemania - Volver al inicio">
          <img
            src={footer.logo.src}
            alt={footer.logo.alt}
            width={footer.logo.width}
            height={footer.logo.height}
            loading="lazy"
            decoding="async"
            class="w-64 xl:w-72 h-auto object-contain"
          />
        </a>
        <p class="mt-6 text-sm sm:text-base leading-relaxed text-white/70 max-w-sm">
          {footer.tagline}
        </p>
      </div>

      <!-- Col 2: EXPLORA Navigation -->
      <div class="lg:col-span-3 lg:border-r lg:border-white/10 lg:px-10">
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-6">
          {footer.exploreTitle}
        </h3>
        <ul class="space-y-4">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm sm:text-base text-white/90 hover:text-white hover:translate-x-1 transition-all duration-150 inline-block py-0.5"
                data-event="footer_nav_click"
                data-event-label={link.label}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: CONTACTO -->
      <div class="lg:col-span-4 lg:pl-10">
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-6">
          {footer.contactTitle}
        </h3>
        <ul class="space-y-5">
          <!-- Address -->
          <li class="flex items-start gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
