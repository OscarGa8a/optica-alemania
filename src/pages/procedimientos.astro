---
import Layout from '../layouts/Layout.astro';
import ProcedimientosHero from '../components/procedimientos/ProcedimientosHero.astro';
import ProcedimientosVolk from '../components/procedimientos/ProcedimientosVolk.astro';
import ProcedimientosFarnsworth from '../components/procedimientos/ProcedimientosFarnsworth.astro';
import ProcedimientosGallery from '../components/procedimientos/ProcedimientosGallery.astro';
import ProcedimientosCta from '../components/procedimientos/ProcedimientosCta.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';
import { obtenerVideosProcedimientos } from '../lib/sanity/videos';

const { metaTitle, metaDescription } = siteConfig.procedimientosPage;

const videos = await obtenerVideosProcedimientos();

// Mapeo resiliente por palabra clave / título con fallback posicional
const videoVolk = videos.find((v) => /volk/i.test(v.titulo)) ?? videos[1];
const videoFarnsworth = videos.find((v) => /farnsworth/i.test(v.titulo)) ?? videos[2];
const videoInfantil = videos.find((v) => /infan/i.test(v.titulo)) ?? videos[0];
---

<Layout
  title={metaTitle}
  description={metaDescription}
  currentPath="/procedimientos/"
  headerTheme="light"
>
  <main id="main-content">
    <ProcedimientosHero />
    <ProcedimientosVolk
      videoUrl={videoVolk?.url}
      posterUrl={videoVolk?.portada}
    />
    <ProcedimientosFarnsworth
      videoUrl={videoFarnsworth?.url}
      posterUrl={videoFarnsworth?.portada}
    />
    <ProcedimientosGallery
      childVideoUrl={videoInfantil?.url}
      childPosterUrl={videoInfantil?.portada}
    />
    <ProcedimientosCta />
  </main>
  <Footer currentPath="/procedimientos/" />
</Layout>
