---
// Sección 5 — Banner de Contacto / Conversión
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const { cta } = siteConfig.procedimientosPage;
const whatsappUrl = buildWhatsAppLink(
  cta.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id={cta.id}
  class="relative bg-gradient-to-br from-[#FAFCFE] via-[#EDF4FD] to-[#DCE8FC] py-16 sm:py-24 lg:py-32 xl:py-36 overflow-hidden scroll-mt-20"
  aria-labelledby="contacto-heading"
>
  <!-- Background decorative organic watermark -->
  <div
    class="absolute -right-24 sm:-right-32 lg:-right-40 -bottom-10 w-full max-w-xl lg:max-w-3xl pointer-events-none opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/about/assets.webp"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-16 items-center">
      
      <!-- Left Column: Eyebrow + Heading -->
      <div class="lg:col-span-7">
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
            {cta.eyebrow}
          </span>
        </div>

        <h2
          id="contacto-heading"
          class="font-display text-[2.6rem] sm:text-5xl lg:text-6xl xl:text-[4rem] text-brand-heading leading-[1.04] tracking-tight mt-3 sm:mt-5 max-w-xl"
        >
          <!-- Desktop Line Breaks -->
          <span class="hidden sm:block font-normal">{cta.titleLine1}</span>
          <span class="hidden sm:block font-normal">{cta.titleLine2}</span>
          <!-- Mobile Line Breaks matching Figma -->
          <span class="block sm:hidden font-normal">{cta.titleMobileLine1 || cta.titleLine1}</span>
          <span class="block sm:hidden font-normal">{cta.titleMobileLine2 || cta.titleLine2}</span>
          <!-- Highlighted Keyword -->
          <span class="block italic font-normal text-brand-primary">{cta.titleHighlight}</span>
        </h2>
      </div>

      <!-- Right Column: Paragraph + CTA Buttons with Divider -->
      <div class="lg:col-span-5 flex flex-col items-start lg:border-l lg:border-[#C5D7ED] lg:pl-10 xl:pl-14">
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed font-normal max-w-md">
          {cta.description}
        </p>

        <!-- Primary WhatsApp Button using Button.astro and Icon.astro -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-5 w-full sm:w-auto">
          <Button
            variant="primary"
            size="lg"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_cta"
            data-event-location="procedimientos_cta_banner"
            icon="arrow-right"
            iconPosition="right"
            aria-label={`${cta.ctaText} con ${siteConfig.name}`}
            class="w-full sm:w-auto inline-flex items-center !justify-between sm:!justify-center gap-3 px-7 sm:px-8 py-3.5 sm:py-4"
          >
            <span class="inline-flex items-center gap-2.5">
              <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
              <span class="text-sm sm:text-base font-semibold whitespace-nowrap">{cta.ctaText}</span>
            </span>
          </Button>
        </div>

        <!-- Secondary Link: Explorar servicios -->
        <div class="mt-4 sm:mt-5">
          <Button
            variant="link"
            size="md"
            href={cta.secondaryLink.href}
            icon="arrow-right"
            data-event="navigation_link"
            data-event-location="procedimientos_cta_banner"
          >
            {cta.secondaryLink.text}
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>