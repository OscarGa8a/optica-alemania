---
// Sección 9 — Contacto y Ubicación
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';

const { contact, contactSection } = siteConfig;
const whatsappContactUrl = buildWhatsAppLink(
  contactSection.whatsappMessage,
  contact.whatsappNumber
);
---

<section
  id="contacto"
  class="relative bg-[#0B1B36] text-white py-14 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
>
  <!-- Desktop ambient backdrop: illuminated facade bleed in top-right -->
  <div
    class="hidden lg:block absolute top-0 right-0 w-[58%] h-[74%] pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <img
      src={contactSection.facadeImage.src}
      alt=""
      width={contactSection.facadeImage.width}
      height={contactSection.facadeImage.height}
      class="w-full h-full object-cover object-right-top"
      loading="lazy"
      decoding="async"
    />
    <!-- Delicate gradient overlays to seamlessly blend with the deep navy base -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B1B36] via-[#0B1B36]/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B1B36] via-transparent to-transparent"></div>
  </div>

  <!-- Ambient blue soft radial glow -->
  <div class="absolute top-1/4 left-[-10%] w-[550px] h-[550px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-[-10%] right-[-5%] w-[650px] h-[650px] bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-[1380px] mx-auto px-5 sm:px-10 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Context, Information & Conversion CTA -->
      <div class="flex flex-col">
        <!-- Eyebrow -->
        <span class="text-xs sm:text-[0.8125rem] font-semibold uppercase tracking-[0.2em] text-[#3B82F6]">
          {contactSection.eyebrow}
        </span>

        <!-- H2 Title (two distinct lines with editorial serif) -->
        <h2 class="font-display text-[3.1rem] sm:text-6xl lg:text-[74px] xl:text-[84px] text-white leading-[1.01] tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{contactSection.titlePart1}</span>
          <span class="block italic font-normal text-[#3B82F6]">{contactSection.titlePart2}</span>
        </h2>

        <!-- Description -->
        <p class="mt-4 sm:mt-5 text-[15px] sm:text-base lg:text-lg text-slate-300 leading-relaxed max-w-lg">
          {contactSection.description}
        </p>

        <!-- Desktop Contact List (Vertical stack) -->
        <div class="hidden md:flex flex-col gap-7 mt-9 sm:mt-11">
          <!-- Dirección -->
          <div class="flex items-center gap-4.5">
            <div class="w-13 h-13 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] shrink-0 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Dirección</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">{contact.address}, {contact.city}, {contact.department}.</p>
            </div>
          </div>

          <!-- Teléfonos -->
          <div class="flex items-center gap-4.5">
            <div class="w-13 h-13 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] shrink-0 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Teléfonos</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">
                <a href={`tel:${contact.phonePrimary.replace(/\s+/g, '')}`} class="hover:text-[#3B82F6] transition-colors">{contact.phonePrimary}</a>
                <span class="text-slate-500 mx-1.5">|</span>
                <a href={`tel:${contact.phoneSecondary.replace(/\s+/g, '')}`} class="hover:text-[#3B82F6] transition-colors">{contact.phoneSecondary}</a>
              </p>
            </div>
          </div>

          <!-- Horarios -->
          <div class="flex items-center gap-4.5">
            <div class="w-13 h-13 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] shrink-0 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Horarios de atención</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">Lunes a sábado 8:00 a.m. – 6:00 p.m.</p>
            </div>
          </div>

          <!-- Instagram -->
          <div class="flex items-center gap-4.5">
            <div class="w-13 h-13 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] shrink-0 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Instagram</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">
                <a
                  href={contact.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#3B82F6] transition-colors"
                >
                  {contact.instagram}
                </a>
              </p>
            </div>
          </div>
        </div>

        <!-- Mobile Contact Row: 4 columns matching 9_contacto_mobile.png -->
        <div class="grid grid-cols-4 gap-2 text-center md:hidden mt-7 mb-4">
          <!-- Dirección -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] mb-2 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <p class="text-[11px] font-semibold text-slate-300">Dirección</p>
            <p class="text-[10px] text-slate-400 leading-tight mt-0.5">Calle 35 #34-36,<br />Barzal Bajo</p>
          </div>

          <!-- Teléfonos -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] mb-2 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <p class="text-[11px] font-semibold text-slate-300">Teléfonos</p>
            <p class="text-[10px] text-slate-400 leading-tight mt-0.5">311 201 7302<br />322 712 8828</p>
          </div>

          <!-- Horarios -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] mb-2 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <p class="text-[11px] font-semibold text-slate-300">Horarios</p>
            <p class="text-[10px] text-slate-400 leading-tight mt-0.5">Lun a sáb<br />8am – 6pm</p>
          </div>

          <!-- Instagram -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-[#132A52] border border-blue-400/25 flex items-center justify-center text-[#3B82F6] mb-2 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </div>
            <p class="text-[11px] font-semibold text-slate-300">Instagram</p>
            <p class="text-[10px] text-slate-400 leading-tight mt-0.5">@optica<br />alemania</p>
          </div>
        </div>

        <!-- WhatsApp Primary Button -->
        <div class="mt-6 sm:mt-11 max-w-lg w-full">
          <a
            href={whatsappContactUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_cta"
            data-event-location="contact_section"
            class="group w-full bg-[#1A6FEF] hover:bg-[#1559C7] text-white font-medium rounded-full py-4.5 px-7 sm:px-8 flex items-center justify-between shadow-xl shadow-blue-900/40 transition-all duration-300 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3B82F6]"
            aria-label="Contactar por WhatsApp a Óptica Alemania Villavicencio"
          >
            <span class="flex items-center gap-3.5">
              <!-- WhatsApp icon -->
              <svg class="w-7 h-7 fill-current text-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.078-1.558-.291-.84-.336-1.574-.919-2.146-1.491-.572-.572-1.155-1.306-1.491-2.146-.369-.924-.336-1.246-.291-1.558.05-.333.419-1.026.824-1.17.135-.048.28-.052.404-.009.124.043.238.152.327.327.24.475.584 1.155.635 1.258.051.103.086.223.017.36-.069.137-.103.223-.206.343-.103.12-.218.269-.311.362-.103.103-.211.215-.09.423.121.208.538.887 1.154 1.436.792.705 1.46.924 1.668 1.028.208.104.33-.09.433-.193.103-.103.447-.517.567-.695.12-.178.24-.149.4-.09.16.059 1.016.479 1.19.566.174.087.29.13.333.203.043.073.043.424-.101.829z"/>
                <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.661 1.434 5.176L2 22l4.981-1.396A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.637 0-3.167-.478-4.464-1.301l-.32-.204-3.136.878.835-3.053-.223-.338C3.805 14.819 3.3 13.46 3.3 12c0-4.797 3.903-8.7 8.7-8.7s8.7 3.903 8.7 8.7-3.903 8.7-8.7 8.7z"/>
              </svg>
              <span class="text-lg sm:text-xl font-medium">Contactar por WhatsApp</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Map & Route Video Card -->
      <div class="flex flex-col gap-6 sm:gap-8 w-full">
        
        <!-- Card 1: Interactive Location Map -->
        <div class="group relative rounded-[28px] overflow-hidden shadow-2xl bg-white border border-white/20 transition-transform duration-300 hover:scale-[1.01]">
          <a
            href={contact.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block relative w-full overflow-hidden"
            aria-label="Abrir mapa de ubicación de Óptica Alemania en Google Maps"
          >
            <img
              src={contactSection.mapImage.src}
              alt={contactSection.mapImage.alt}
              width={contactSection.mapImage.width}
              height={contactSection.mapImage.height}
              class="w-full h-auto object-cover"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>

        <!-- Card 2: Route / Video "Cómo Llegar" Card -->
        <div class="rounded-[28px] overflow-hidden border border-blue-500/20 bg-[#102341] shadow-xl">
          <!-- Desktop Layout (Horizontal split) -->
          <div class="hidden sm:grid sm:grid-cols-[1.05fr_1.1fr] items-center">
            <!-- Facade Thumbnail with Play Button -->
            <a
              href={contactSection.routeVideo.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-[16/10] overflow-hidden"
              aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
            >
              <img
                src={contactSection.facadeImage.src}
                alt={contactSection.facadeImage.alt}
                width={contactSection.facadeImage.width}
                height={contactSection.facadeImage.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors"></div>
              
              <!-- Play Button -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-white ml-0.5" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
              </div>
            </a>

            <!-- Content & Action -->
            <div class="p-6 lg:p-8 flex items-center justify-between gap-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-[#4B9BFA]">
                  {contactSection.routeVideo.eyebrow}
                </span>
                <h3 class="font-display text-2xl lg:text-[28px] xl:text-[32px] text-white leading-tight mt-1.5">
                  {contactSection.routeVideo.title}
                </h3>
                <p class="text-xs lg:text-[14px] text-slate-300 mt-2 leading-relaxed max-w-xs">
                  {contactSection.routeVideo.description}
                </p>
              </div>

              <!-- Action circular button -->
              <a
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-full border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-[#0B1B36] transition-colors shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3B82F6]"
                aria-label="Abrir recorrido en video hasta Óptica Alemania"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Mobile Layout (Vertical stack matching 9_contacto_mobile.png) -->
          <div class="sm:hidden flex flex-col">
            <!-- Facade Thumbnail with Play Button -->
            <a
              href={contactSection.routeVideo.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-[16/10] overflow-hidden"
              aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
            >
              <img
                src={contactSection.facadeImage.src}
                alt={contactSection.facadeImage.alt}
                width={contactSection.facadeImage.width}
                height={contactSection.facadeImage.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/30"></div>
              
              <!-- Play Button -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-white ml-0.5" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
              </div>
            </a>

            <!-- Content & Button -->
            <div class="p-5 flex flex-col">
              <span class="text-[11px] font-semibold uppercase tracking-widest text-[#4B9BFA]">
                {contactSection.routeVideo.eyebrow}
              </span>
              <h3 class="font-display text-[22px] text-white leading-snug mt-1">
                {contactSection.routeVideo.title}
              </h3>
              <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                {contactSection.routeVideo.description}
              </p>

              <!-- Outlined Pill Action Button -->
              <a
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 w-full border border-white/30 text-white rounded-full py-2.5 px-5 text-sm font-medium flex items-center justify-center gap-2 hover:bg-white/10 transition-colors"
                aria-label="Ver video del recorrido paso a paso"
              >
                <span>{contactSection.routeVideo.actionTextMobile}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
