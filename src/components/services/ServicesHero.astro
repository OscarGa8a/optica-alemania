---
import { siteConfig } from '../../data/siteConfig';

const { hero } = siteConfig.servicesPage;
---

<section
  id="hero-servicios"
  class="relative bg-white overflow-hidden min-h-[810px] lg:min-h-[820px] flex flex-col justify-between"
  aria-label="Servicios de optometría en Villavicencio"
>
  <!-- Desktop Background Photography: Full-bleed right edge with crisp transition -->
  <div class="hidden lg:block absolute inset-0 z-0 pointer-events-none">
    <img
      src={hero.images.desktop.src}
      alt={hero.images.desktop.alt}
      width={hero.images.desktop.width}
      height={hero.images.desktop.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover object-right"
    />
    <!-- Editorial soft white gradient on left side to guarantee crisp typography contrast without washing out the photo -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-white from-26% via-white/75 via-36% to-transparent to-46%"
      aria-hidden="true"
    ></div>
  </div>

  <!-- Text Content Area -->
  <div class="relative z-10 max-w-7xl mx-auto w-full px-5 sm:px-8 lg:px-12 pt-24 sm:pt-30 lg:pt-36 pb-4 lg:pb-24">
    <div class="max-w-xl lg:max-w-2xl">
      
      <!-- Eyebrow with horizontal accent line -->
      <div class="flex items-center gap-3 mb-4 sm:mb-6">
        <span class="w-8 sm:w-10 h-[2px] bg-brand-primary shrink-0" aria-hidden="true"></span>
        <span class="font-sans text-xs sm:text-sm font-semibold tracking-[0.2em] text-brand-primary uppercase">
          {hero.eyebrow}
        </span>
      </div>

      <!-- Main H1 Title: Instrument Serif, 3 lines matching official mockups -->
      <h1 class="font-display text-[46px] sm:text-5xl lg:text-[62px] xl:text-[66px] font-normal text-brand-heading leading-[1.03] tracking-tight">
        {hero.titlePart1}<br />
        {hero.titlePart2}<br />
        <span class="italic text-brand-primary font-normal">{hero.titleHighlight}</span>
      </h1>

      <!-- Editorial Description / Subtitle -->
      <p class="font-sans text-base sm:text-lg lg:text-[18px] text-brand-body font-normal leading-relaxed mt-4 sm:mt-6 max-w-lg text-balance">
        {hero.description}
      </p>

      <!-- Secondary CTA: Explorar servicios anchor link with down arrow -->
      <div class="mt-6 sm:mt-9">
        <a
          href={hero.exploreHref}
          data-event="services_explore_click"
          data-event-location="services_hero"
          class="inline-flex items-center gap-2 text-brand-primary hover:text-brand-bright font-sans text-base sm:text-lg font-medium transition-colors group cursor-pointer"
        >
          <span>{hero.exploreText}</span>
          <svg
            class="w-4 h-4 stroke-current stroke-2 group-hover:translate-y-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Visual: Full Bleed Image underneath text, matching 1_hero_mobile.png -->
  <div class="lg:hidden relative w-full overflow-hidden mt-1">
    <div class="w-full relative">
      <img
        src={hero.images.mobile.src}
        alt={hero.images.mobile.alt}
        width={hero.images.mobile.width}
        height={hero.images.mobile.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto object-cover object-top"
      />
      <!-- Soft gradient on top of mobile image to seamlessly merge with white section -->
      <div
        class="absolute inset-x-0 top-0 h-6 bg-gradient-to-b from-white to-transparent pointer-events-none"
        aria-hidden="true"
      ></div>
    </div>
  </div>
</section>
