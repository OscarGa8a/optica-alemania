---
// Services overview — non-clickable intro that frames the page and introduces the 01/02/03 areas
// detailed in the sections below. All copy and images come from siteConfig.servicesPage.overview.
import { siteConfig } from '../../data/siteConfig';

const { overview } = siteConfig.servicesPage;
---

<section
  id={overview.id}
  class="relative bg-brand-cool text-brand-body py-12 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
  aria-labelledby="overview-heading"
>
  <!-- Consistent fluid container matching Hero, Navbar, and /nosotros -->
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <!-- Left Column: Heading & Description -->
      <div class="lg:col-span-5 flex flex-col">
        <!-- Eyebrow -->
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
            {overview.eyebrow}
          </span>
        </div>

        <h2
          id="overview-heading"
          class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-5"
        >
          <span class="block font-normal">{overview.titleLine1}</span>
          <span class="block italic font-normal text-brand-primary">{overview.titleLine2}</span>
        </h2>

        <p class="text-sm sm:text-lg text-brand-body leading-relaxed mt-3 sm:mt-6 max-w-lg">
          {overview.description}
        </p>
      </div>

      <!-- Right Column: Numbered areas (informational, not interactive) -->
      <div class="lg:col-span-7 flex flex-col pt-2 lg:pt-4">
        <ol class="divide-y divide-brand-border border-t border-b border-brand-border">
          {overview.cards.map((card) => (
            <li class="group flex items-center gap-3 sm:gap-6 py-4 sm:py-6 lg:py-7 px-1.5 sm:px-4">
              <!-- Numeric Index: Instrument Serif -->
              <span class="font-display text-xl sm:text-2xl lg:text-3xl text-brand-primary/40 group-hover:text-brand-primary transition-colors min-w-5 sm:min-w-8 shrink-0 text-center sm:text-left">
                {card.number}
              </span>

              <!-- Area Thumbnail -->
              <div class="relative w-16 h-12 sm:w-28 sm:h-20 lg:w-36 lg:h-24 rounded-xl sm:rounded-2xl overflow-hidden shrink-0 shadow-xs border border-white/80">
                <img
                  src={card.image.src}
                  alt={card.image.alt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
                  width={card.image.width}
                  height={card.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Textual Content -->
              <div class="flex-1 min-w-0 pr-1 sm:pr-2">
                <h3 class="font-display text-base sm:text-xl lg:text-2xl font-normal text-brand-heading leading-snug">
                  {card.titlePart1}{card.titlePart2 && ` ${card.titlePart2}`}
                </h3>
                <p class="text-xs sm:text-sm text-brand-body leading-relaxed mt-1 sm:mt-1.5">
                  {card.description}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
