---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Analytics from '../components/Analytics.astro';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  gtmId?: string;
  currentPath?: string;
  headerTheme?: 'dark-hero' | 'light';
  navVariant?: 'transparent' | 'light';
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  robots,
  gtmId = import.meta.env.PUBLIC_GTM_ID,
  currentPath = '#inicio',
  headerTheme,
  navVariant,
} = Astro.props;

const effectiveTheme: 'dark-hero' | 'light' = headerTheme || (navVariant === 'light' ? 'light' : 'dark-hero');

// PLAYBOOK Fase 4: Arquitectura de Protección de Staging en Doble Capa
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const publicEnv = import.meta.env.PUBLIC_ENV || '';
const publicNoindex = import.meta.env.PUBLIC_NOINDEX;

const isStagingDomain = siteUrl.includes('oscardev.co') || siteUrl.includes('pages.dev') || siteUrl.includes('vercel.app');
const isStagingEnv = publicEnv === 'staging' || publicEnv === 'preview' || publicEnv === 'development';
const isExplicitNoindex = publicNoindex === 'true';

const shouldForceNoindex = isStagingDomain || isStagingEnv || isExplicitNoindex;
const effectiveRobots = robots || (shouldForceNoindex ? 'noindex, nofollow' : 'index, follow');

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;

// Generar Schema.org JSON-LD para SEO y GEO Local Search
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Optician",
      "@id": `${siteConfig.siteUrl}/#organization`,
      "name": siteConfig.legalName,
      "alternateName": siteConfig.name,
      "url": siteConfig.siteUrl,
      "logo": `${siteConfig.siteUrl}/images/home/10_footer_logo.webp`,
      "image": `${siteConfig.siteUrl}/images/home/1_hero_desktop_image.webp`,
      "description": siteConfig.description,
      "telephone": siteConfig.contact.phone,
      "email": siteConfig.contact.email,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.contact.address,
        "addressLocality": siteConfig.city,
        "addressRegion": "Meta",
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 4.1420,
        "longitude": -73.6266
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "08:00",
          "closes": "14:00"
        }
      ],
      "sameAs": [
        siteConfig.social.instagram,
        siteConfig.social.facebook
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteConfig.siteUrl}/#website`,
      "url": siteConfig.siteUrl,
      "name": siteConfig.name,
      "description": siteConfig.tagline,
      "publisher": {
        "@id": `${siteConfig.siteUrl}/#organization`
      },
      "inLanguage": "es-CO"
    }
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter & Instrument Serif con Font Display Swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveRobots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- GEO Tags (Local SEO Villavicencio) -->
    <meta name="geo.region" content="CO-MET" />
    <meta name="geo.placename" content="Villavicencio" />
    <meta name="geo.position" content="4.1420;-73.6266" />
    <meta name="ICBM" content="4.1420, -73.6266" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/images/home/1_hero_desktop_image.webp`} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/images/home/1_hero_desktop_image.webp`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Google Tag Manager (Carga Diferida para 100/100 Core Web Vitals) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window._gtmLoaded = false;
        window._loadGTM = function() {
          if (window._gtmLoaded) return;
          window._gtmLoaded = true;
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() { setTimeout(window._loadGTM, 2500); });
        } else {
          setTimeout(window._loadGTM, 3000);
        }

        ['pointerdown', 'touchstart', 'scroll', 'keydown', 'click'].forEach(function(evt) {
          window.addEventListener(evt, window._loadGTM, { once: true, passive: true });
        });
      </script>
    )}
  </head>
  <body class="bg-brand-surface text-brand-body antialiased selection:bg-brand-blue-soft selection:text-brand-primary">
    <Navbar currentPath={currentPath} theme={effectiveTheme} />
    <main id="main-content">
      <slot />
    </main>
    <Analytics />
  </body>
</html>
