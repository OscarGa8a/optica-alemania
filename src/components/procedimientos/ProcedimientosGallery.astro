---
// Sección 4 — Galería: Más de Nuestro Trabajo
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import VideoPlayer from '../ui/VideoPlayer.astro';

const { gallery } = siteConfig.procedimientosPage;
---

<section
  id={gallery.id}
  class="relative bg-white text-brand-body py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20 lg:scroll-mt-24"
  aria-labelledby="nuestro-trabajo-heading"
>
  <!-- Subtle decorative background gradient accents matching Figma -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header matching Figma -->
    <div class="max-w-5xl mb-10 sm:mb-14 lg:mb-16">
      <!-- Eyebrow without decorative line -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {gallery.eyebrow}
        </span>
      </div>

      <!-- Heading H2 with Instrument Serif typography -->
      <h2
        id="nuestro-trabajo-heading"
        class="font-display text-[2.6rem] sm:text-5xl lg:text-[3.5rem] xl:text-[4.25rem] 2xl:text-[4.75rem] text-brand-heading leading-[1.04] tracking-tight mt-3 sm:mt-5"
      >
        <span class="block sm:inline font-normal">{gallery.titlePart1} </span>
        <span class="block sm:inline italic font-normal text-brand-primary">{gallery.titleHighlight}</span>
      </h2>

      <!-- Subtitle matching Figma copy -->
      <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-6 max-w-3xl font-normal">
        {gallery.description}
      </p>
    </div>

    <!-- 2 Video Cards Grid generated dynamically from siteConfig -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 xl:gap-12">
      {gallery.cards.map((card) => (
        <div class="group flex flex-col">
          <VideoPlayer
            id={card.videoId}
            src={card.src}
            poster={card.poster}
            pngFallback={card.pngFallback}
            alt={card.alt}
            label={`${card.title} - ${siteConfig.name}`}
            initialTimestamp={card.initialTimestamp}
            initialProgress={card.initialProgress}
          />

          <!-- Typography & Editorial Details matching Figma -->
          <div class="mt-4 sm:mt-5">
            <h3 class="font-display text-2xl sm:text-3xl lg:text-[2rem] text-brand-heading leading-[1.1] tracking-tight">
              {card.title}
            </h3>
            <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-2 font-normal">
              {card.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
