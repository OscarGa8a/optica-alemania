---
import { siteConfig } from '../data/siteConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const isNosotros = currentPath === '/nosotros' || currentPath === 'nosotros';
const isContacto = currentPath === '/contacto' || currentPath === 'contacto';
const isProcedimientos = currentPath === '/procedimientos' || currentPath === 'procedimientos';
const isSubpage = isNosotros || isContacto || isProcedimientos;
const { footer } = siteConfig;

const navLinks = footer.navLinks.map((link) => {
  let href = link.href;
  if (isSubpage) {
    if (href === '#nosotros' || href === '/nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto' || href === '/contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos' || href === '/procedimientos') {
      href = '/procedimientos';
    } else if (href.startsWith('#')) {
      href = `/${href}`;
    }
  } else {
    if (href === '#nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos') {
      href = '/procedimientos';
    }
  }
  return { ...link, href };
});

const logoHref = isSubpage ? '/#inicio' : '#inicio';
---

<footer id="footer" class="relative bg-gradient-to-b from-[#082245] via-[#061A36] to-[#041226] text-white overflow-hidden">
  <!-- Desktop Decorative Wave Transition from Section 9 -->
  <div class="hidden md:block w-full overflow-hidden leading-none -mt-1 select-none pointer-events-none" aria-hidden="true">
    <svg
      class="relative block w-full h-12 lg:h-16 text-[#FAFBFD]"
      viewBox="0 0 1440 60"
      preserveAspectRatio="none"
      fill="currentColor"
    >
      <path d="M 0,0 L 0,22 C 360,50 720,54 1080,32 C 1260,20 1380,8 1440,0 L 1440,0 Z"></path>
    </svg>
  </div>

  <!-- Background Watermark Graphic (Large Stylized Eye) -->
  <div
    class="absolute right-[-15%] top-[1%] sm:right-[-5%] sm:top-[2%] lg:right-[0%] lg:top-[3%] w-[420px] sm:w-[540px] lg:w-[740px] pointer-events-none opacity-25 lg:opacity-30 select-none"
    aria-hidden="true"
  >
    <img
      src="/images/home/footer_eye_watermark.webp"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain filter drop-shadow-[0_0_40px_rgba(20,100,217,0.35)]"
    />
  </div>

  <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-12 sm:pt-16 lg:pt-18 pb-12 lg:pb-16">
    <!-- Desktop Layout (3 Columns with Vertical Dividers) -->
    <div class="hidden lg:grid lg:grid-cols-12 lg:gap-0">
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-5 lg:border-r lg:border-white/10 lg:pr-10 flex flex-col justify-start">
        <a href={logoHref} class="inline-block transition-opacity hover:opacity-90" aria-label="Óptica Alemania - Volver al inicio">
          <img
            src={footer.logo.src}
            alt={footer.logo.alt}
            width={footer.logo.width}
            height={footer.logo.height}
            loading="lazy"
            decoding="async"
            class="w-[290px] h-auto object-contain"
          />
        </a>
        <p class="mt-6 text-[15px] leading-relaxed text-[#92A7C6] max-w-[340px]">
          {footer.tagline}
        </p>
      </div>

      <!-- Col 2: EXPLORA Navigation -->
      <div class="lg:col-span-3 lg:border-r lg:border-white/10 lg:px-10">
        <h3 class="text-xs font-semibold tracking-[0.2em] text-[#4C93F7] uppercase mb-6">
          {footer.exploreTitle}
        </h3>
        <ul class="space-y-4">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[15px] text-[#E3ECF7] hover:text-white hover:translate-x-1 transition-all duration-150 inline-block py-0.5"
                data-event="footer_nav_click"
                data-event-label={link.label}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: CONTACTO -->
      <div class="lg:col-span-4 lg:pl-10">
        <h3 class="text-xs font-semibold tracking-[0.2em] text-[#4C93F7] uppercase mb-6">
          {footer.contactTitle}
        </h3>
        <ul class="space-y-5">
          <!-- Address -->
          <li class="flex items-start gap-3.5 text-sm text-[#E3ECF7]">
            <span class="w-11 h-11 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="pt-1.5 leading-snug">
              <p>{footer.address.line1}</p>
              <p class="text-[#9DB3D1]">{footer.address.line2}</p>
            </div>
          </li>

          <!-- Phones -->
          <li class="flex items-center gap-3.5 text-sm text-[#E3ECF7]">
            <span class="w-11 h-11 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <span class="tracking-wide">{footer.phones}</span>
          </li>

          <!-- Instagram Handle -->
          <li class="flex items-center gap-3.5 text-sm text-[#E3ECF7]">
            <a
              href={footer.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 hover:text-white transition-colors group"
              data-event="footer_social_click"
              data-event-network="instagram"
            >
              <span class="w-11 h-11 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA] group-hover:bg-[#1464D9] group-hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </span>
              <span>{footer.instagramHandle}</span>
            </a>
          </li>
        </ul>

        <!-- Social Outlined Buttons -->
        <div class="flex items-center gap-3 mt-7 pt-2">
          <a
            href={footer.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-[#1E4B87] flex items-center justify-center text-[#E3ECF7] hover:text-white hover:bg-[#1464D9] hover:border-[#1464D9] transition-all duration-200"
            data-event="footer_social_click"
            data-event-network="instagram_icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href={footer.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-[#1E4B87] flex items-center justify-center text-[#E3ECF7] hover:text-white hover:bg-[#1464D9] hover:border-[#1464D9] transition-all duration-200"
            data-event="footer_whatsapp_click"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Layout (Vertical Stack with Accordion-like Nav) -->
    <div class="lg:hidden flex flex-col space-y-10">
      <!-- Brand & Tagline -->
      <div>
        <a href={logoHref} class="inline-block transition-opacity hover:opacity-90" aria-label="Óptica Alemania - Volver al inicio">
          <img
            src={footer.logo.src}
            alt={footer.logo.alt}
            width={footer.logo.width}
            height={footer.logo.height}
            loading="lazy"
            decoding="async"
            class="w-[240px] sm:w-[270px] h-auto object-contain"
          />
        </a>
        <p class="mt-4 text-[15px] leading-relaxed text-[#92A7C6] max-w-[340px]">
          {footer.tagline}
        </p>
      </div>

      <!-- EXPLORA Navigation (Mobile List with Chevrons) -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.2em] text-[#4C93F7] uppercase mb-3">
          {footer.exploreTitle}
        </h3>
        <nav aria-label="Navegación pie de página">
          <ul class="divide-y divide-white/10 border-t border-b border-white/10">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex items-center justify-between py-4 text-[15px] text-[#E3ECF7] hover:text-white transition-colors"
                  data-event="footer_nav_click"
                  data-event-label={link.label}
                >
                  <span>{link.label}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- CONTACTO (Mobile List & Socials) -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.2em] text-[#4C93F7] uppercase mb-4">
          {footer.contactTitle}
        </h3>
        <ul class="space-y-4">
          <!-- Address -->
          <li class="flex items-start gap-3.5 text-sm text-[#E3ECF7]">
            <span class="w-12 h-12 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="pt-2 leading-snug">
              <p>{footer.address.line1}</p>
              <p class="text-[#9DB3D1]">{footer.address.line2}</p>
            </div>
          </li>

          <!-- Phones -->
          <li class="flex items-center gap-3.5 text-sm text-[#E3ECF7]">
            <span class="w-12 h-12 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <span class="tracking-wide">{footer.phones}</span>
          </li>

          <!-- Instagram Handle -->
          <li class="flex items-center gap-3.5 text-sm text-[#E3ECF7]">
            <a
              href={footer.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 hover:text-white transition-colors group"
              data-event="footer_social_click"
              data-event-network="instagram"
            >
              <span class="w-12 h-12 rounded-full bg-[#0E3364] border border-[#184583] flex items-center justify-center shrink-0 text-[#60A5FA] group-hover:bg-[#1464D9] group-hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </span>
              <span>{footer.instagramHandle}</span>
            </a>
          </li>
        </ul>

        <!-- Mobile Social Circles -->
        <div class="flex items-center gap-3.5 mt-6 pt-1">
          <a
            href={footer.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-[#1E4B87] flex items-center justify-center text-[#E3ECF7] hover:text-white hover:bg-[#1464D9] hover:border-[#1464D9] transition-all"
            data-event="footer_social_click"
            data-event-network="instagram_icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href={footer.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-[#1E4B87] flex items-center justify-center text-[#E3ECF7] hover:text-white hover:bg-[#1464D9] hover:border-[#1464D9] transition-all"
            data-event="footer_whatsapp_click"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Horizontal Divider & Bottom Legal / Copyright Bar -->
    <div class="mt-14 lg:mt-20 pt-8 border-t border-white/10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-[#7E9AC2]">
        <div>
          <p>{footer.copyright}</p>
          <p class="mt-0.5">{footer.rights}</p>
        </div>
        <div class="flex items-center gap-3 sm:border-l sm:border-white/15 sm:pl-6">
          <a href={footer.legalLinks[0].href} class="hover:text-white transition-colors">
            {footer.legalLinks[0].label}
          </a>
          <span class="text-white/25">|</span>
          <a href={footer.legalLinks[1].href} class="hover:text-white transition-colors">
            {footer.legalLinks[1].label}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
