---
// Sección — Conoce Nuestra Atención / Desde Que Llegas
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';
import VideoPlayer from './ui/VideoPlayer.astro';

interface Props {
  videoUrl?: string | null;
  posterUrl?: string | null;
}

const { videoUrl, posterUrl } = Astro.props;
const { arrival, contact } = siteConfig;

const whatsappUrl = buildWhatsAppLink(
  arrival.whatsappMessage,
  contact.whatsappNumber
);

const videoSrc = videoUrl || arrival.video.videoSrc;
const videoPoster = posterUrl || arrival.video.poster;
const videoPngFallback = posterUrl ? undefined : arrival.video.pngFallback;
---

<section
  id="atencion"
  class="relative bg-brand-midnight text-white py-14 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
>
  <!-- Stylized Decorative Eye Watermark from SVG asset -->
  <div
    class="absolute -right-20 sm:-right-28 lg:-right-36 -top-10 sm:-top-16 lg:-top-20 w-full max-w-lg sm:max-w-xl lg:max-w-3xl xl:max-w-4xl pointer-events-none opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <!-- Ambient blue soft radial glow for depth -->
  <div
    class="absolute -bottom-24 -left-20 w-96 sm:w-144 h-96 sm:h-144 bg-blue-600/10 rounded-full blur-3xl pointer-events-none z-0"
    aria-hidden="true"
  ></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 xl:gap-18 items-center">
      
      <!-- Text Column (Left on Desktop, Top on Mobile) -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <!-- Eyebrow matching dark section tokens -->
        <span class="font-sans text-xs sm:text-sm font-semibold uppercase tracking-widest text-blue-400">
          {arrival.eyebrow}
        </span>

        <!-- Section Heading: Instrument Serif editorial display with brand-steel italic contrast -->
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{arrival.titlePart1}</span>
          <span class="block italic font-normal text-brand-steel mt-1">{arrival.titleHighlight}</span>
        </h2>

        <!-- Description -->
        <p class="text-sm sm:text-base lg:text-lg text-brand-ice/80 leading-relaxed font-normal mt-4 max-w-xl">
          {arrival.description}
        </p>

        <!-- Desktop CTA: Single WhatsApp icon via Button.astro -->
        <div class="hidden lg:block mt-8 sm:mt-10">
          <Button
            variant="primary"
            size="lg"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="whatsapp"
            iconPosition="left"
            data-event="whatsapp_cta"
            data-event-location="arrival_section"
          >
            {arrival.whatsappButtonText}
          </Button>
        </div>
      </div>

      <!-- Video Column (Right on Desktop, Middle on Mobile) -->
      <div class="lg:col-span-6 flex flex-col items-center">
        <div class="w-full">
          <VideoPlayer
            id="home-arrival-video"
            src={videoSrc}
            poster={videoPoster}
            pngFallback={videoPngFallback}
            alt={arrival.video.label}
            label={arrival.video.label}
            initialTimestamp={`0:00 / ${arrival.video.duration}`}
            initialProgress={0}
            aspectRatio="aspect-[16/10]"
            fit="contain"
            theme="dark"
          />
        </div>

        <!-- Mobile CTA: Single WhatsApp icon via Button.astro -->
        <div class="w-full lg:hidden mt-6 sm:mt-8">
          <Button
            variant="primary"
            size="md"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="whatsapp"
            iconPosition="left"
            class="w-full justify-center"
            data-event="whatsapp_cta"
            data-event-location="arrival_section"
          >
            {arrival.whatsappButtonText}
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>
