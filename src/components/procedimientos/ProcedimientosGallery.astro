---
// Sección 4 — Galería: Más de Nuestro Trabajo
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import VideoPlayer from '../ui/VideoPlayer.astro';

const { gallery } = siteConfig.procedimientosPage;
---

<section
  id={gallery.id}
  class="relative bg-white text-brand-body py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20 lg:scroll-mt-24"
  aria-labelledby="nuestro-trabajo-heading"
>
  <!-- Subtle decorative background gradient accents matching Figma -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header matching Figma -->
    <div class="max-w-5xl mb-10 sm:mb-14 lg:mb-16">
      <!-- Eyebrow without decorative line -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          {gallery.eyebrow}
        </span>
      </div>

      <!-- Heading H2 with Instrument Serif typography -->
      <h2
        id="nuestro-trabajo-heading"
        class="font-display text-[2.6rem] sm:text-5xl lg:text-[3.5rem] xl:text-[4.25rem] 2xl:text-[4.75rem] text-brand-heading leading-[1.04] tracking-tight mt-3 sm:mt-5"
      >
        <span class="block sm:inline font-normal">{gallery.titlePart1} </span>
        <span class="block sm:inline italic font-normal text-brand-primary">{gallery.titleHighlight}</span>
      </h2>

      <!-- Subtitle matching Figma copy -->
      <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-6 max-w-3xl font-normal">
        {gallery.description}
      </p>
    </div>

    <!-- 2 Video Cards Grid generated dynamically from siteConfig -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 xl:gap-12">
      {gallery.cards.map((card) => (
        <div class="group flex flex-col">
          <VideoPlayer
            id={card.videoId}
            poster={card.poster}
            pngFallback={card.pngFallback}
            alt={card.alt}
            label={`${card.title} - ${siteConfig.name}`}
            initialTimestamp={card.initialTimestamp}
            initialProgress={card.initialProgress}
          />

          <!-- Typography & Editorial Details matching Figma -->
          <div class="mt-4 sm:mt-5">
            <h3 class="font-display text-2xl sm:text-3xl lg:text-[2rem] text-brand-heading leading-[1.1] tracking-tight">
              {card.title}
            </h3>
            <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-2 font-normal">
              {card.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupGalleryVideos() {
    const section = document.getElementById('nuestro-trabajo');
    if (!section) return;

    const videoElements = section.querySelectorAll('video[id]');
    const videoIds = Array.from(videoElements).map((el) => el.id);

    interface PlayerState {
      id: string;
      video: HTMLVideoElement | null;
      playToggle: HTMLElement | null;
      pauseIcon: HTMLElement | null;
      playIcon: HTMLElement | null;
      muteToggle: HTMLElement | null;
      muteIcon: HTMLElement | null;
      unmuteIcon: HTMLElement | null;
      timestamp: HTMLElement | null;
      progressFill: HTMLElement | null;
      progressThumb: HTMLElement | null;
      progressBar: HTMLElement | null;
      fullscreenToggle: HTMLElement | null;
      userManuallyPaused: boolean;
    }

    const players: PlayerState[] = videoIds.map((id) => ({
      id,
      video: document.getElementById(id) as HTMLVideoElement | null,
      playToggle: document.getElementById(`${id}-play-toggle`),
      pauseIcon: document.getElementById(`${id}-pause-icon`),
      playIcon: document.getElementById(`${id}-play-icon`),
      muteToggle: document.getElementById(`${id}-mute-toggle`),
      muteIcon: document.getElementById(`${id}-mute-icon`),
      unmuteIcon: document.getElementById(`${id}-unmute-icon`),
      timestamp: document.getElementById(`${id}-timestamp`),
      progressFill: document.getElementById(`${id}-progress-fill`),
      progressThumb: document.getElementById(`${id}-progress-thumb`),
      progressBar: document.getElementById(`${id}-progress-bar`),
      fullscreenToggle: document.getElementById(`${id}-fullscreen-toggle`),
      userManuallyPaused: false,
    }));

    function formatTime(seconds: number) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function updatePlayState(player: PlayerState, isPlaying: boolean) {
      if (player.pauseIcon && player.playIcon) {
        if (isPlaying) {
          player.pauseIcon.classList.remove('hidden');
          player.pauseIcon.classList.add('block');
          player.playIcon.classList.remove('block');
          player.playIcon.classList.add('hidden');
        } else {
          player.pauseIcon.classList.remove('block');
          player.pauseIcon.classList.add('hidden');
          player.playIcon.classList.remove('hidden');
          player.playIcon.classList.add('block');
        }
      }
    }

    // Viewport IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            players.forEach((player) => {
              if (!reducedMotion && !player.userManuallyPaused && player.video?.currentSrc) {
                player.video.play().then(() => {
                  updatePlayState(player, true);
                }).catch(() => {
                  updatePlayState(player, false);
                });
              }
            });
          } else {
            players.forEach((player) => {
              if (player.video?.currentSrc && !player.video.paused) {
                player.video.pause();
                updatePlayState(player, false);
              }
            });
          }
        });
      },
      {
        threshold: 0.35,
        rootMargin: '0px',
      }
    );

    observer.observe(section);

    players.forEach((player) => {
      const { video } = player;
      if (!video) return;

      player.playToggle?.addEventListener('click', () => {
        if (video.currentSrc) {
          if (video.paused) {
            player.userManuallyPaused = false;
            video.play().then(() => updatePlayState(player, true)).catch(() => {});
          } else {
            player.userManuallyPaused = true;
            video.pause();
            updatePlayState(player, false);
          }
        }
      });

      player.muteToggle?.addEventListener('click', () => {
        video.muted = !video.muted;
        if (player.muteIcon && player.unmuteIcon) {
          if (video.muted) {
            player.muteIcon.classList.remove('hidden');
            player.muteIcon.classList.add('block');
            player.unmuteIcon.classList.remove('block');
            player.unmuteIcon.classList.add('hidden');
          } else {
            player.muteIcon.classList.remove('block');
            player.muteIcon.classList.add('hidden');
            player.unmuteIcon.classList.remove('hidden');
            player.unmuteIcon.classList.add('block');
          }
        }
      });

      video.addEventListener('timeupdate', () => {
        if (!video.duration) return;
        const progress = (video.currentTime / video.duration) * 100;
        if (player.progressFill) player.progressFill.style.width = `${progress}%`;
        if (player.progressThumb) player.progressThumb.style.left = `${progress}%`;
        if (player.timestamp) {
          player.timestamp.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        }
        if (player.progressBar) {
          player.progressBar.setAttribute('aria-valuenow', Math.round(progress).toString());
        }
      });

      player.progressBar?.addEventListener('click', (e) => {
        const rect = player.progressBar!.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        if (video.duration) {
          video.currentTime = pos * video.duration;
        }
      });

      player.fullscreenToggle?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          video.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupGalleryVideos);
</script>
