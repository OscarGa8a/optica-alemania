---
// Sección 7.5 — Club Descuentos Cofrem
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

const { cofrem } = siteConfig;
const whatsappCofremUrl = buildWhatsAppLink(
  cofrem.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id="cofrem"
  class="relative bg-brand-cool text-brand-body py-14 sm:py-16 lg:py-24 scroll-mt-20 overflow-hidden"
>
  <!-- Atmospheric soft ambient clinic lighting matching brand tokens -->
  <div class="absolute -bottom-24 -left-20 w-80 sm:w-128 h-80 sm:h-128 bg-brand-success/8 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -top-20 -right-20 w-96 sm:w-144 h-96 sm:h-144 bg-brand-blue-soft/60 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Decorative subtle background curves matching brand rhythm -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none select-none opacity-90 text-brand-primary"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 760"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M1180,-40 C1220,140 1320,260 1500,300"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-opacity="0.14"
    />
    <path
      d="M-60,420 C60,490 140,610 190,780"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-opacity="0.14"
    />
  </svg>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-16 xl:gap-20 items-center">
      
      <!-- Left Column (Desktop) / Top (Mobile): Cofrem Official Logo -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="w-48 sm:w-60 lg:w-full lg:max-w-xs xl:max-w-sm flex items-center justify-center">
          <picture>
            <source srcset={cofrem.logo.src} type="image/webp" />
            <img
              src={cofrem.logo.pngFallback || cofrem.logo.src}
              alt={cofrem.logo.alt}
              width={cofrem.logo.width}
              height={cofrem.logo.height}
              class="w-full h-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>

      <!-- Right Column (Desktop) / Bottom (Mobile): Editorial Content, Benefit Cards & CTA -->
      <div class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left">
        <!-- Eyebrow matching unified section tokens -->
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-brand-primary">
          {cofrem.eyebrow}
        </span>

        <!-- Section Title: Instrument Serif with editorial color contrast -->
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-brand-heading leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{cofrem.titlePart1}</span>
          <span class="block italic font-normal text-brand-primary">{cofrem.titlePart2}</span>
        </h2>

        <!-- Description -->
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-5 max-w-xl">
          {cofrem.description}
        </p>

        <!-- Benefit Cards Grid: Stacked on Mobile, 2 Columns on Desktop -->
        <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4 lg:gap-5 mt-7 sm:mt-8">
          {cofrem.benefits.map((benefit) => {
            const isGreen = benefit.theme === 'green';
            return (
              <div
                data-cofrem-benefit={benefit.id}
                class:list={[
                  'rounded-2xl sm:rounded-3xl p-5 sm:p-6 border flex items-center gap-4 transition-transform duration-300 hover:-translate-y-0.5 shadow-xs',
                  isGreen
                    ? 'bg-brand-success/6 border-brand-success/15'
                    : 'bg-brand-blue-soft/75 border-brand-border',
                ]}
              >
                <!-- Left: Rounded Benefit Icon -->
                <div
                  class:list={[
                    'w-14 h-14 sm:w-15 sm:h-15 rounded-full flex items-center justify-center shrink-0',
                    isGreen
                      ? 'bg-brand-success/12 text-brand-success'
                      : 'bg-brand-primary/12 text-brand-primary',
                  ]}
                >
                  <Icon
                    name={benefit.icon}
                    strokeWidth={1.6}
                    class="w-7 h-7 sm:w-8 sm:h-8"
                  />
                </div>

                <!-- Vertical Divider -->
                <div
                  class:list={[
                    'w-px h-12 sm:h-14 shrink-0',
                    isGreen
                      ? 'bg-brand-success/20'
                      : 'bg-brand-border',
                  ]}
                  aria-hidden="true"
                ></div>

                <!-- Right: Discount Percentage & Label -->
                <div class="flex-1 text-left">
                  <span
                    class:list={[
                      'block font-display text-4xl sm:text-5xl leading-none tracking-tight',
                      isGreen
                        ? 'text-brand-success'
                        : 'text-brand-primary',
                    ]}
                  >
                    {benefit.discount}
                  </span>
                  <span class="block text-sm sm:text-base font-medium text-brand-heading mt-1.5">
                    {benefit.label}
                  </span>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Primary Action CTA -->
        <div class="w-full sm:w-auto mt-7 sm:mt-8">
          <Button
            variant="primary"
            size="lg"
            href={whatsappCofremUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="arrow-right"
            class="w-full sm:w-auto justify-center"
            data-event="whatsapp_cta"
            data-event-location="cofrem_section"
            aria-label="Consultar beneficios del Club Descuentos Cofrem en Óptica Alemania por WhatsApp"
          >
            {cofrem.ctaText}
          </Button>
        </div>

        <!-- Legal Disclaimer -->
        <p class="text-xs sm:text-sm text-brand-body/80 mt-4 sm:mt-5">
          {cofrem.disclaimer}
        </p>
      </div>

    </div>
  </div>
</section>
