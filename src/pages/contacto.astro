---
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';

const pageTitle = `Contacto — ${siteConfig.name} | Villavicencio`;
const pageDescription = "Comunícate con Óptica Alemania en Villavicencio. Ubicación en Barzal, horarios de atención, líneas telefónicas y WhatsApp para agendar tu consulta optométrica.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/contacto"
  headerTheme="light"
>
  <main id="main-content">
    <ContactHero />
    <ContactLocation />
  </main>
  <Footer currentPath="/contacto" />
</Layout>
