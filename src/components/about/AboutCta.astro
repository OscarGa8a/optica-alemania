---
// Sección 6 — Estamos Para Ti (Banner Institucional)
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';

const whatsappUrl = buildWhatsAppLink(
  'Hola, conocí la página Nosotros de Óptica Alemania y quisiera hacer una consulta.',
  siteConfig.contact.whatsappNumber
);
---

<section id="estamos-para-ti" class="relative bg-brand-heading text-white py-24 sm:py-28 lg:py-36 xl:py-40 overflow-hidden">
  
  <!-- Stylized Decorative Eye Watermark from assets.webp (positioned right/bottom matching mockup) -->
  <div
    class="absolute right-0 translate-x-1/2 bottom-0 sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 w-full max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-5xl xl:max-w-6xl pointer-events-none opacity-10 select-none filter brightness-0 invert z-0"
    aria-hidden="true"
  >
    <img
      src="/images/about/assets.webp"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Left Column: Eyebrow + Heading -->
      <div class="lg:col-span-7">
        <!-- Eyebrow without line (consistent with design system) -->
        <div>
          <span class="text-xs uppercase font-semibold tracking-widest text-blue-300">
            ESTAMOS PARA TI
          </span>
        </div>

        <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-white tracking-tight leading-none mt-5 sm:mt-7">
          Ahora que<br />
          nos conoces,<br />
          queremos<br />
          <span class="italic text-blue-400">escucharte.</span>
        </h2>
      </div>

      <!-- Right Column: Description + CTAs (stacked vertically) -->
      <div class="lg:col-span-5 flex flex-col items-start lg:pl-6 w-full">
        <p class="text-base sm:text-lg lg:text-xl text-white/80 leading-relaxed font-normal mb-8 sm:mb-10 max-w-md">
          Estamos aquí para orientarte sobre nuestros servicios y ayudarte a encontrar la atención visual que necesitas.
        </p>

        <div class="flex flex-col items-start gap-6 w-full sm:w-auto">
          <!-- Primary CTA (WhatsApp) -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_cta"
            data-event-location="about_cta"
            aria-label="Contactar a Óptica Alemania por WhatsApp"
            class="group inline-flex items-center justify-center gap-3 w-full sm:w-auto px-7 py-4 rounded-full bg-brand-primary hover:bg-brand-bright text-white text-base font-semibold shadow-md shadow-brand-primary/25 hover:shadow-lg transition-all duration-200"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
            </svg>
            <span>Hablar por WhatsApp</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>

          <!-- Secondary CTA (Services) -->
          <a
            href="/#servicios"
            data-event="services_click"
            data-event-location="about_cta"
            class="group inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 py-3.5 rounded-full border border-white/20 hover:border-white/40 hover:bg-white/5 text-white/90 hover:text-white transition-all duration-200 text-base font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
          >
            <span>Explorar servicios</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

</section>
