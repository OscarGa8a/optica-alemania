---
// Sección 1 — Hero Contacto
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';

const whatsappUrl = buildWhatsAppLink(
  'Hola, quisiera recibir información sobre los servicios de Óptica Alemania.',
  siteConfig.contact.whatsappNumber
);
---

<section id="inicio" class="relative bg-gradient-to-br from-[#EBF3FB] via-[#F4F7FC] to-[#FAFBFD] overflow-hidden pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-20 lg:pb-28">
  
  <!-- Large Brand Wave Arc Watermark across the Hero -->
  <div
    class="absolute right-[-15%] sm:right-[-5%] top-[-5%] sm:top-[0%] w-[680px] sm:w-[950px] lg:w-[1250px] xl:w-[1450px] pointer-events-none opacity-30 sm:opacity-35 lg:opacity-40 select-none z-0"
    aria-hidden="true"
  >
    <picture>
      <source srcset="/images/contact/assets.webp" type="image/webp" />
      <img
        src="/images/contact/assets.png"
        alt=""
        width="1774"
        height="887"
        loading="eager"
        decoding="async"
        class="w-full h-auto object-contain"
      />
    </picture>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
    <div class="max-w-2xl">
      <!-- Eyebrow with decorative rule -->
      <div class="flex items-center gap-3 sm:gap-4">
        <span class="text-xs uppercase font-semibold tracking-[0.2em] text-brand-primary">
          CONTACTO · ÓPTICA ALEMANIA
        </span>
        <span class="w-12 sm:w-16 h-[1.5px] bg-[#9BB0CE]" aria-hidden="true"></span>
      </div>

      <!-- Hero Heading H1: Instrument Serif editorial + Italic Accent -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-[4.25rem] font-display font-normal text-brand-heading tracking-tight leading-[1.06] mt-5 sm:mt-7">
        Hablemos de<br />
        <span class="italic text-brand-primary">tu visión.</span>
      </h1>

      <!-- Subtitle / Lead Paragraph -->
      <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-[1.125rem] text-brand-body leading-relaxed font-normal max-w-xl">
        ¿Tienes preguntas sobre nuestros servicios o necesitas información antes de visitarnos? Escríbenos o llámanos para resolver tus dudas y conocer las opciones de atención disponibles.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <!-- WhatsApp Primary Button -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_cta"
          data-event-location="contact_hero"
          class="inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-brand-primary text-white hover:bg-brand-bright font-semibold text-sm sm:text-base tracking-wide shadow-sm hover:shadow active:scale-[0.98] transition-all duration-200"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
          </svg>
          <span>Escribir por WhatsApp</span>
        </a>

        <!-- Call Secondary Button -->
        <a
          href={`tel:${siteConfig.contact.phoneTel}`}
          data-event="phone_call"
          data-event-location="contact_hero"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full border border-brand-border bg-white text-brand-heading hover:bg-brand-cool hover:border-[#CBD5E1] font-semibold text-sm sm:text-base tracking-wide shadow-xs transition-all duration-200"
        >
          <svg class="w-4 h-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span>Llamar ahora</span>
        </a>
      </div>
    </div>
  </div>
</section>
