---
// Sección 8: Cierre / Contacto
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';

const { cta } = siteConfig.servicesPage;
const { contact } = siteConfig;

const whatsappUrl = buildWhatsAppLink(cta.whatsappMessage, contact.whatsappNumber);
---

<section
  id={cta.id}
  class="relative bg-brand-midnight text-white py-16 sm:py-24 lg:py-32 scroll-mt-20 overflow-hidden"
  aria-labelledby="cta-heading"
>
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="max-w-3xl lg:max-w-4xl mx-auto text-center flex flex-col items-center">
      <!-- Eyebrow Badge matching Design System -->
      <div>
        <span
          data-eyebrow
          class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-steel"
        >
          {cta.eyebrow}
        </span>
      </div>

      <!-- Title with fluid Instrument Serif -->
      <h2
        id="cta-heading"
        class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-normal text-white leading-[1.08] tracking-tight mt-3 sm:mt-5 text-center"
      >
        <span class="block sm:inline">{cta.titlePart1} {cta.titlePart2}</span>
        {' '}
        <span class="italic font-normal text-brand-steel">{cta.titleHighlight}</span>
      </h2>

      <!-- Description -->
      <p class="text-white/80 text-sm sm:text-base lg:text-lg leading-relaxed font-normal max-w-2xl mx-auto mt-4 sm:mt-6 text-center">
        {cta.description}
      </p>

      <!-- Primary WhatsApp CTA Button using Button.astro -->
      <div class="mt-8 sm:mt-10 flex justify-center">
        <Button
          variant="primary"
          size="lg"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          icon="whatsapp"
          iconPosition="left"
          aria-label="Consultar por WhatsApp sobre nuestros servicios"
        >
          {cta.ctaText}
        </Button>
      </div>
    </div>
  </div>
</section>
