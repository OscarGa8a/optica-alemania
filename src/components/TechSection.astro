---
// Sección 4 — Tecnología en Acción
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import Button from './ui/Button.astro';
import VideoPlayer from './ui/VideoPlayer.astro';

const { technologies } = siteConfig;
const item01 = technologies.find(t => t.id === 'volk-inview') || technologies[0];
const item02 = technologies.find(t => t.id === 'farnsworth-d15') || technologies[1];
---

<section id="tecnologia" class="relative bg-brand-heading text-white py-14 sm:py-16 lg:py-24 scroll-mt-20 overflow-hidden">
  <!-- Stylized Decorative Eye Watermark from SVG asset -->
  <div
    class="absolute -right-20 sm:-right-28 lg:-right-36 -top-10 sm:-top-16 lg:-top-20 w-full max-w-lg sm:max-w-xl lg:max-w-3xl xl:max-w-4xl pointer-events-none opacity-15 lg:opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header: Eyebrow, Editorial Title & Description -->
    <div class="max-w-2xl">
      <!-- Eyebrow matching ContactSection color token -->
      <span class="font-sans text-xs sm:text-sm font-semibold uppercase tracking-widest text-blue-400">
        TECNOLOGÍA EN ACCIÓN
      </span>

      <!-- Title: Instrument Serif with brand-steel italic contrast -->
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-tight tracking-tight mt-3 sm:mt-4">
        <span class="block font-normal">La tecnología detrás</span>
        <span class="block italic font-normal text-brand-steel">de cada evaluación.</span>
      </h2>

      <!-- Description -->
      <p class="text-sm sm:text-base lg:text-lg text-brand-ice/80 leading-relaxed mt-3 sm:mt-4 max-w-xl">
        Conoce de cerca algunos de los procedimientos que realizamos y descubre cómo se utilizan distintas herramientas en la atención visual.
      </p>
    </div>

    <!-- Technology Showcase Items: Clean editorial rhythm -->
    <div class="mt-10 sm:mt-12 lg:mt-16 space-y-12 sm:space-y-16 lg:space-y-20">
      
      <!-- Item 01: Volk iNview (Desktop: Video Left, Text Right | Mobile: Video Top, Text Bottom) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-14 items-center">
        <!-- Video Card -->
        <div class="lg:col-span-7">
          <VideoPlayer
            id={`home-video-${item01.id}`}
            src={item01.videoSrc}
            poster={item01.image}
            pngFallback={item01.pngFallback}
            alt={item01.alt}
            label={`Demostración en video de ${item01.titlePart1} ${item01.titlePart2}`}
            initialTimestamp={`0:00 / ${item01.duration}`}
            initialProgress={0}
            class="border-white/10 shadow-2xl"
          />
        </div>

        <!-- Text Content -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <div class="flex items-center gap-3">
            <span class="font-display text-2xl sm:text-3xl lg:text-4xl text-brand-steel">{item01.number}</span>
            <span class="w-10 h-[1.5px] bg-brand-slate-border"></span>
          </div>

          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-white leading-snug mt-3">
            <span class="block font-normal">{item01.titlePart1}</span>
            <span class="block italic font-normal text-brand-steel">{item01.titlePart2}</span>
          </h3>

          <p class="text-sm sm:text-base text-brand-ice/80 leading-relaxed mt-3 max-w-lg">
            {item01.description}
          </p>

          <div class="mt-4 sm:mt-5">
            <Button
              variant="link-light"
              size="md"
              href={item01.actionHref}
              icon="arrow-right"
              data-event="procedure_click"
              data-event-item={item01.id}
            >
              {item01.actionText}
            </Button>
          </div>
        </div>
      </article>

      <!-- Item 02: Farnsworth D-15 (Desktop: Text Left, Video Right | Mobile: Video Top, Text Bottom) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-14 items-center">
        <!-- Text Content (order-2 on mobile, order-1 on desktop) -->
        <div class="order-2 lg:order-1 lg:col-span-5 flex flex-col justify-center">
          <div class="flex items-center gap-3">
            <span class="font-display text-2xl sm:text-3xl lg:text-4xl text-brand-steel">{item02.number}</span>
            <span class="w-10 h-[1.5px] bg-brand-slate-border"></span>
          </div>

          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-white leading-snug mt-3">
            <span class="block font-normal">{item02.titlePart1}</span>
            <span class="block italic font-normal text-brand-steel">{item02.titlePart2}</span>
          </h3>

          <p class="text-sm sm:text-base text-brand-ice/80 leading-relaxed mt-3 max-w-lg">
            {item02.description}
          </p>

          <div class="mt-4 sm:mt-5">
            <Button
              variant="link-light"
              size="md"
              href={item02.actionHref}
              icon="arrow-right"
              data-event="procedure_click"
              data-event-item={item02.id}
            >
              {item02.actionText}
            </Button>
          </div>
        </div>

        <!-- Video Card (order-1 on mobile, order-2 on desktop) -->
        <div class="order-1 lg:order-2 lg:col-span-7">
          <VideoPlayer
            id={`home-video-${item02.id}`}
            src={item02.videoSrc}
            poster={item02.image}
            pngFallback={item02.pngFallback}
            alt={item02.alt}
            label={`Demostración en video de ${item02.titlePart1} ${item02.titlePart2}`}
            initialTimestamp={`0:00 / ${item02.duration}`}
            initialProgress={0}
            class="border-white/10 shadow-2xl"
          />
        </div>
      </article>

    </div>
  </div>
</section>
