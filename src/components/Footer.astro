---
import { siteConfig } from '../data/siteConfig';
import Icon from './ui/Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const isNosotros = currentPath === '/nosotros' || currentPath === 'nosotros';
const isContacto = currentPath === '/contacto' || currentPath === 'contacto';
const isProcedimientos = currentPath === '/procedimientos' || currentPath === 'procedimientos';
const isSubpage = isNosotros || isContacto || isProcedimientos;
const { footer, contact } = siteConfig;

const navLinks = footer.navLinks.map((link) => {
  let href = link.href;
  if (isSubpage) {
    if (href === '#nosotros' || href === '/nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto' || href === '/contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos' || href === '/procedimientos') {
      href = '/procedimientos';
    } else if (href.startsWith('#')) {
      href = `/${href}`;
    }
  } else {
    if (href === '#nosotros') {
      href = '/nosotros';
    } else if (href === '#contacto') {
      href = '/contacto';
    } else if (href === '#procedimientos') {
      href = '/procedimientos';
    }
  }
  return { ...link, href };
});

const logoHref = isSubpage ? '/#inicio' : '#inicio';
---

<footer id="footer" class="relative bg-brand-midnight text-white overflow-hidden border-t border-white/10">
  <!-- Background Watermark Graphic (Large Stylized Eye shifted right matching mockup) -->
  <div
    class="absolute right-0 translate-x-1/3 sm:translate-x-1/2 top-0 w-full max-w-lg sm:max-w-2xl lg:max-w-4xl xl:max-w-5xl pointer-events-none opacity-20 lg:opacity-25 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-16 sm:pt-20 lg:pt-24 pb-12 lg:pb-16">
    <!-- Desktop Layout (3 Columns with Vertical Dividers) -->
    <div class="hidden lg:grid lg:grid-cols-12 lg:gap-0">
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-5 lg:border-r lg:border-white/10 lg:pr-10 flex flex-col justify-start">
        <a href={logoHref} class="inline-block transition-opacity hover:opacity-90" aria-label="Óptica Alemania - Volver al inicio">
          <img
            src={footer.logo.src}
            alt={footer.logo.alt}
            width={footer.logo.width}
            height={footer.logo.height}
            loading="lazy"
            decoding="async"
            class="w-64 xl:w-72 h-auto object-contain"
          />
        </a>
        <p class="mt-6 text-sm sm:text-base leading-relaxed text-white/70 max-w-sm">
          {footer.tagline}
        </p>
      </div>

      <!-- Col 2: EXPLORA Navigation -->
      <div class="lg:col-span-3 lg:border-r lg:border-white/10 lg:px-10">
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-6">
          {footer.exploreTitle}
        </h3>
        <ul class="space-y-4">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm sm:text-base text-white/90 hover:text-white hover:translate-x-1 transition-all duration-150 inline-block py-0.5"
                data-event="footer_nav_click"
                data-event-label={link.label}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: CONTACTO -->
      <div class="lg:col-span-4 lg:pl-10">
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-6">
          {footer.contactTitle}
        </h3>
        <ul class="space-y-5">
          <!-- Address -->
          <li class="flex items-start gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="map-pin" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <div class="pt-1.5 leading-snug">
              <p>{footer.address.line1}</p>
              <p class="text-white/60">{footer.address.line2}</p>
            </div>
          </li>

          <!-- Phones -->
          <li class="flex items-center gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="phone" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <span class="tracking-wide">{footer.phones}</span>
          </li>

          <!-- Business Hours -->
          <li class="flex items-start gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="clock" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <div class="pt-1.5 leading-snug">
              <p class="font-medium text-white/90">Horario de atención</p>
              <div class="text-white/60 text-xs sm:text-sm mt-0.5 leading-relaxed">
                <p>{contact.scheduleWeekdays}</p>
                <p>{contact.scheduleSaturday}</p>
              </div>
            </div>
          </li>
        </ul>

        <!-- Social Outlined Buttons (Instagram & WhatsApp) -->
        <div class="flex items-center gap-3.5 mt-8 pt-1">
          <a
            href={footer.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_social_click"
            data-event-network="instagram_icon"
          >
            <Icon name="instagram" class="w-5 h-5 stroke-current stroke-2" />
          </a>
          <a
            href={footer.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_whatsapp_click"
          >
            <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Layout (Vertical Stack with Accordion-like Nav) -->
    <div class="lg:hidden flex flex-col space-y-10">
      <!-- Brand & Tagline -->
      <div>
        <a href={logoHref} class="inline-block transition-opacity hover:opacity-90" aria-label="Óptica Alemania - Volver al inicio">
          <img
            src={footer.logo.src}
            alt={footer.logo.alt}
            width={footer.logo.width}
            height={footer.logo.height}
            loading="lazy"
            decoding="async"
            class="w-56 sm:w-64 h-auto object-contain"
          />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/70 max-w-sm">
          {footer.tagline}
        </p>
      </div>

      <!-- EXPLORA Navigation (Mobile List with Chevrons) -->
      <div>
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-3">
          {footer.exploreTitle}
        </h3>
        <nav aria-label="Navegación pie de página">
          <ul class="divide-y divide-white/10 border-t border-b border-white/10">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex items-center justify-between py-4 text-sm sm:text-base text-white/90 hover:text-white transition-colors"
                  data-event="footer_nav_click"
                  data-event-label={link.label}
                >
                  <span>{link.label}</span>
                  <Icon name="chevron-right" class="w-4.5 h-4.5 text-white/40" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- CONTACTO (Mobile List & Socials) -->
      <div>
        <h3 class="text-xs font-semibold tracking-widest text-blue-400 uppercase mb-4">
          {footer.contactTitle}
        </h3>
        <ul class="space-y-4">
          <!-- Address -->
          <li class="flex items-start gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="map-pin" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <div class="pt-1.5 leading-snug">
              <p>{footer.address.line1}</p>
              <p class="text-white/60">{footer.address.line2}</p>
            </div>
          </li>

          <!-- Phones -->
          <li class="flex items-center gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="phone" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <span class="tracking-wide">{footer.phones}</span>
          </li>

          <!-- Business Hours -->
          <li class="flex items-start gap-3.5 text-sm text-white/90">
            <span class="w-11 h-11 rounded-full bg-brand-primary text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-primary/25">
              <Icon name="clock" class="w-4.5 h-4.5 stroke-current stroke-2" />
            </span>
            <div class="pt-1.5 leading-snug">
              <p class="font-medium text-white/90">Horario de atención</p>
              <div class="text-white/60 text-xs sm:text-sm mt-0.5 leading-relaxed">
                <p>{contact.scheduleWeekdays}</p>
                <p>{contact.scheduleSaturday}</p>
              </div>
            </div>
          </li>
        </ul>

        <!-- Mobile Social Circles (Instagram & WhatsApp) -->
        <div class="flex items-center gap-3.5 mt-6 pt-1">
          <a
            href={footer.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_social_click"
            data-event-network="instagram_icon"
          >
            <Icon name="instagram" class="w-5 h-5 stroke-current stroke-2" />
          </a>
          <a
            href={footer.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_whatsapp_click"
          >
            <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
          </a>
        </div>
      </div>
    </div>

    <!-- Horizontal Divider & Bottom Bar -->
    <div class="mt-14 lg:mt-20 pt-8 border-t border-white/10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-white/50">
        <p>{footer.copyright} {footer.rights}</p>
        <p class="text-white/40">Villavicencio, Meta — Colombia</p>
      </div>
    </div>
  </div>
</footer>
