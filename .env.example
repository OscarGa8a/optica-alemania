# ==============================================================================
# Óptica Alemania — Variables de Entorno y Configuración de Despliegue
# PLAYBOOK Maestro: Infraestructura, Aislamiento de Staging y Search Console
# ==============================================================================

# Entorno operacional del build (staging | preview | development | production)
# En staging/preview activa automáticamente 'noindex, nofollow'
PUBLIC_ENV=production

# Dominio base canónico para sitemap, OpenGraph, robots y canonical tags
PUBLIC_SITE_URL=https://opticaalemania.co

# Interruptor maestro de bloqueo de indexación (opcional si se usa PUBLIC_ENV)
# True fuerza 'noindex, nofollow'; False permite indexación según PUBLIC_ENV
PUBLIC_NOINDEX=false

# Token de verificación de propiedad en Google Search Console (metaetiqueta)
# Proporcionado por Google Search Console -> Ajustes -> Verificación de la propiedad
# PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token-aqui

# Contenedor de Google Tag Manager (GTM)
# GTM-XXXXXXX cargado de forma diferida (Zero-TBT) al primer gesto o idle
# PUBLIC_GTM_ID=GTM-XXXXXXX
