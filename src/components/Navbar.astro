---
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';

interface Props {
  currentPath?: string;
  theme?: 'dark-hero' | 'light';
  variant?: 'transparent' | 'light';
}

const { currentPath = '/', theme, variant } = Astro.props;
const effectiveTheme: 'dark-hero' | 'light' = theme || (variant === 'light' ? 'light' : 'dark-hero');
const isLight = effectiveTheme === 'light';
const whatsappUrl = buildWhatsAppLink('Hola, deseo solicitar atención en Óptica Alemania.', siteConfig.contact.whatsappNumber);

const normalizedCurrentPath = (currentPath === '#inicio' || currentPath === '' || currentPath === '/')
  ? '/'
  : (currentPath.startsWith('/') ? currentPath : `/${currentPath}`).replace(/\/$/, '');

const navItems = siteConfig.nav.map((item) => {
  const itemPath = item.href === '/' ? '/' : (item.href.startsWith('/') ? item.href : `/${item.href}`).replace(/\/$/, '');
  const isActive = normalizedCurrentPath === itemPath;

  return {
    ...item,
    href: item.href,
    isActive,
  };
});

const logoHref = '/';
---

<header
  id="site-header"
  data-theme={effectiveTheme}
  class="fixed top-0 left-0 right-0 z-50 w-full transition-colors duration-200 ease-out bg-transparent border-b border-transparent"
>
  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={logoHref} class="flex items-center group transition-transform duration-200" aria-label="Óptica Alemania - Inicio">
        <img
          id="brand-logo"
          src="/images/logo.webp"
          alt="Óptica Alemania - Villavicencio"
          width="2172"
          height="724"
          class="h-8 sm:h-10 lg:h-11 w-auto object-contain transition-opacity duration-200"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        {navItems.map((item) => {
          return (
            <a
              href={item.href}
              class:list={[
                "relative py-2 text-sm font-medium transition-colors duration-200",
                item.isActive 
                  ? "text-brand-primary font-semibold" 
                  : "text-brand-heading/85 hover:text-brand-primary"
              ]}
            >
              {item.label}
              {item.isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-brand-primary rounded-full" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Action Button & Mobile Controls -->
      <div class="flex items-center gap-3">
        <!-- WhatsApp CTA Button: Hidden on mobile (< sm) to prevent crowding, visible on tablet & desktop -->
        <Button
          id="navbar-cta-btn"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_cta"
          data-event-location="header_cta"
          aria-label="Solicitar atención por WhatsApp con Óptica Alemania"
          icon="whatsapp"
          iconPosition="left"
          size="sm"
          class:list={[
            "hidden sm:inline-flex",
            isLight
              ? "border border-transparent bg-brand-primary text-white hover:bg-brand-bright"
              : "border border-white/80 text-white bg-white/10 backdrop-blur-xs lg:border-transparent lg:bg-brand-primary lg:text-white lg:hover:bg-brand-bright"
          ]}
        >
          Solicitar atención
        </Button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-button"
          class:list={[
            "lg:hidden inline-flex items-center justify-center p-2 rounded-lg transition-colors",
            isLight
              ? "text-brand-heading hover:bg-brand-cool/80"
              : "text-white hover:bg-white/15"
          ]}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" id="hamburger-icon"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" class="hidden" id="close-icon"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer / Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-white/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-3 shadow-xl">
    <div class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors",
            item.isActive
              ? "text-brand-primary bg-brand-cool/80 font-semibold"
              : "text-brand-heading hover:bg-brand-cool hover:text-brand-primary"
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Mobile CTA Button inside Menu -->
    <div class="pt-3 border-t border-brand-border/60">
      <Button
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-event="whatsapp_cta"
        data-event-location="mobile_menu_cta"
        aria-label="Solicitar atención por WhatsApp con Óptica Alemania"
        icon="whatsapp"
        iconPosition="left"
        size="md"
        class="w-full justify-center bg-brand-primary text-white hover:bg-brand-bright shadow-xs"
      >
        Solicitar atención
      </Button>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const header = document.getElementById('site-header');
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const navbarCtaBtn = document.getElementById('navbar-cta-btn');
    const isLightMode = header?.getAttribute('data-theme') === 'light';

    if (button && menu && hamburgerIcon && closeIcon && !button.dataset.listenerAttached) {
      button.dataset.listenerAttached = 'true';
      let isAnimating = false;

      button.addEventListener('click', () => {
        if (isAnimating) return;
        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        if (!isExpanded) {
          button.setAttribute('aria-expanded', 'true');
          menu.classList.remove('hidden');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');

          isAnimating = true;
          const anim = menu.animate(
            [
              { opacity: 0, transform: 'translateY(-8px)' },
              { opacity: 1, transform: 'translateY(0)' }
            ],
            { duration: 200, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
          );
          anim.onfinish = () => {
            isAnimating = false;
          };
        } else {
          isAnimating = true;
          button.setAttribute('aria-expanded', 'false');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');

          const anim = menu.animate(
            [
              { opacity: 1, transform: 'translateY(0)' },
              { opacity: 0, transform: 'translateY(-6px)' }
            ],
            { duration: 150, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
          );
          anim.onfinish = () => {
            menu.classList.add('hidden');
            isAnimating = false;
          };
        }
      });

      const links = menu.querySelectorAll('a');
      links.forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        });
      });
    }

    // Header scroll appearance
    function updateHeaderState() {
      if (!header) return;
      const isScrolled = window.scrollY > 20;

      if (isScrolled) {
        header.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-xs', 'border-brand-border/40');
        header.classList.remove('bg-transparent', 'border-transparent');
        
        if (!isLightMode) {
          button?.classList.remove('text-white', 'hover:bg-white/15');
          button?.classList.add('text-brand-heading', 'hover:bg-brand-cool/80');

          navbarCtaBtn?.classList.remove('border-white/80', 'text-white', 'bg-white/10');
          navbarCtaBtn?.classList.add('border-transparent', 'bg-brand-primary', 'text-white');
        }
      } else {
        header.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-xs', 'border-brand-border/40');
        header.classList.add('bg-transparent', 'border-transparent');

        if (!isLightMode) {
          button?.classList.add('text-white', 'hover:bg-white/15');
          button?.classList.remove('text-brand-heading', 'hover:bg-brand-cool/80');

          navbarCtaBtn?.classList.add('border-white/80', 'text-white', 'bg-white/10');
          navbarCtaBtn?.classList.remove('border-transparent', 'bg-brand-primary');
        }
      }
    }

    window.removeEventListener('scroll', updateHeaderState);
    window.addEventListener('scroll', updateHeaderState, { passive: true });
    updateHeaderState();
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
