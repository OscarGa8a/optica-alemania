---
// Sección 9 — Contacto y Ubicación
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

const { contact, contactSection } = siteConfig;
const whatsappContactUrl = buildWhatsAppLink(
  contactSection.whatsappMessage,
  contact.whatsappNumber
);
---

<section
  id="contacto"
  class="relative bg-brand-midnight text-white py-14 sm:py-20 lg:py-28 scroll-mt-20 overflow-hidden"
>
  <!-- Desktop ambient backdrop: illuminated facade bleed in top-right -->
  <div
    class="hidden lg:block absolute top-0 right-0 w-3/5 h-3/4 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <img
      src={contactSection.facadeImage.src}
      alt=""
      width={contactSection.facadeImage.width}
      height={contactSection.facadeImage.height}
      class="w-full h-full object-cover object-right-top"
      loading="lazy"
      decoding="async"
    />
    <!-- Delicate gradient overlays to seamlessly blend with the deep navy base -->
    <div class="absolute inset-0 bg-gradient-to-r from-brand-midnight via-brand-midnight/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-midnight via-transparent to-transparent"></div>
  </div>

  <!-- Ambient blue soft radial glow -->
  <div class="absolute top-1/4 -left-20 w-96 sm:w-144 h-96 sm:h-144 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -right-20 w-96 sm:w-160 h-96 sm:h-160 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Context, Information & Conversion CTA -->
      <div class="lg:col-span-5 flex flex-col">
        <!-- Eyebrow -->
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-blue-400">
          {contactSection.eyebrow}
        </span>

        <!-- H2 Title (two distinct lines with editorial serif) -->
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl text-white leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{contactSection.titlePart1}</span>
          <span class="block italic font-normal text-blue-400">{contactSection.titlePart2}</span>
        </h2>

        <!-- Description -->
        <p class="mt-4 sm:mt-5 text-sm sm:text-base lg:text-lg text-slate-300 leading-relaxed max-w-lg">
          {contactSection.description}
        </p>

        <!-- Desktop Contact List (Vertical stack) -->
        <div class="hidden md:flex flex-col gap-7 mt-9 sm:mt-11">
          <!-- Dirección -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 shrink-0 shadow-xs">
              <Icon name="map-pin" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Dirección</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">{contact.address}, {contact.city}, {contact.department}.</p>
            </div>
          </div>

          <!-- Teléfonos -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 shrink-0 shadow-xs">
              <Icon name="phone" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Teléfonos</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">
                <a href={`tel:${contact.phonePrimary.replace(/\s+/g, '')}`} class="hover:text-blue-400 transition-colors">{contact.phonePrimary}</a>
                <span class="text-slate-500 mx-1.5">|</span>
                <a href={`tel:${contact.phoneSecondary.replace(/\s+/g, '')}`} class="hover:text-blue-400 transition-colors">{contact.phoneSecondary}</a>
              </p>
            </div>
          </div>

          <!-- Horarios -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 shrink-0 shadow-xs mt-0.5">
              <Icon name="clock" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Horarios de atención</p>
              <div class="text-white text-base sm:text-lg font-normal mt-0.5 leading-snug">
                <p>{contact.scheduleWeekdays}</p>
                <p>{contact.scheduleSaturday}</p>
              </div>
            </div>
          </div>

          <!-- Instagram -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 shrink-0 shadow-xs">
              <Icon name="instagram" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-medium">Instagram</p>
              <p class="text-white text-base sm:text-lg font-normal mt-0.5">
                <a
                  href={contact.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-blue-400 transition-colors"
                >
                  {contact.instagram}
                </a>
              </p>
            </div>
          </div>
        </div>

        <!-- Mobile Contact Row: 4 columns matching 10_contacto_mobile.png -->
        <div class="grid grid-cols-4 gap-2 text-center md:hidden mt-7 mb-4">
          <!-- Dirección -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 mb-2 shadow-xs">
              <Icon name="map-pin" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <p class="text-xs font-semibold text-slate-300">Dirección</p>
            <p class="text-xs text-slate-400 leading-tight mt-0.5">Calle 35 #34-36,<br />Barzal</p>
          </div>

          <!-- Teléfonos -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 mb-2 shadow-xs">
              <Icon name="phone" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <p class="text-xs font-semibold text-slate-300">Teléfonos</p>
            <p class="text-xs text-slate-400 leading-tight mt-0.5">311 201 7302<br />322 712 8828</p>
          </div>

          <!-- Horarios -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 mb-2 shadow-xs">
              <Icon name="clock" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <p class="text-xs font-semibold text-slate-300">Horarios</p>
            <p class="text-xs text-slate-400 leading-tight mt-0.5">Lun-Vie 8:30-6<br />Sáb 8:30-3</p>
          </div>

          <!-- Instagram -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-brand-midnight-bubble border border-blue-400/25 flex items-center justify-center text-blue-400 mb-2 shadow-xs">
              <Icon name="instagram" class="w-5 h-5 stroke-current stroke-2" />
            </div>
            <p class="text-xs font-semibold text-slate-300">Instagram</p>
            <p class="text-xs text-slate-400 leading-tight mt-0.5">@optica<br />alemania</p>
          </div>
        </div>

        <!-- WhatsApp Primary Button -->
        <div class="mt-6 sm:mt-11 max-w-lg w-full">
          <Button
            variant="primary"
            size="lg"
            href={whatsappContactUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_cta"
            data-event-location="contact_section"
            icon="arrow-right"
            class="w-full justify-between py-4 px-6 sm:px-8 text-base sm:text-lg shadow-xl shadow-blue-950/40"
            aria-label="Contactar por WhatsApp a Óptica Alemania Villavicencio"
          >
            <span class="flex items-center gap-3">
              <Icon name="whatsapp" class="w-6 h-6 fill-current" />
              Contactar por WhatsApp
            </span>
          </Button>
        </div>
      </div>

      <!-- Right Column: Interactive Map & Route Video Card -->
      <div class="lg:col-span-7 flex flex-col gap-6 sm:gap-8 w-full">
        
        <!-- Card 1: Interactive Location Map -->
        <div class="group relative rounded-3xl overflow-hidden shadow-2xl bg-white border border-white/20 transition-transform duration-300 hover:scale-102">
          <a
            href={contact.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block relative w-full overflow-hidden"
            aria-label="Abrir mapa de ubicación de Óptica Alemania en Google Maps"
          >
            <img
              src={contactSection.mapImage.src}
              alt={contactSection.mapImage.alt}
              width={contactSection.mapImage.width}
              height={contactSection.mapImage.height}
              class="w-full h-auto object-cover"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>

        <!-- Card 2: Route / Video 'Cómo Llegar' Card -->
        <div class="rounded-3xl overflow-hidden border border-blue-500/20 bg-brand-midnight-card shadow-xl">
          <!-- Desktop Layout (Horizontal split) -->
          <div class="hidden sm:grid sm:grid-cols-2 items-center">
            <!-- Facade Thumbnail with Play Button -->
            <a
              href={contactSection.routeVideo.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-16/10 overflow-hidden"
              aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
            >
              <img
                src={contactSection.facadeImage.src}
                alt={contactSection.facadeImage.alt}
                width={contactSection.facadeImage.width}
                height={contactSection.facadeImage.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors"></div>
              
              <!-- Play Button -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <Icon name="play" class="w-6 h-6 fill-white ml-0.5" />
                </div>
              </div>
            </a>

            <!-- Content & Action -->
            <div class="p-6 lg:p-8 flex items-center justify-between gap-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-blue-400">
                  {contactSection.routeVideo.eyebrow}
                </span>
                <h3 class="font-display text-2xl lg:text-3xl text-white leading-tight mt-1.5">
                  {contactSection.routeVideo.title}
                </h3>
                <p class="text-xs lg:text-sm text-slate-300 mt-2 leading-relaxed max-w-xs">
                  {contactSection.routeVideo.description}
                </p>
              </div>

              <!-- Action circular button -->
              <Button
                variant="glass"
                size="sm"
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                icon="arrow-right"
                class="w-12 h-12 !rounded-full !p-0 justify-center shrink-0 border-white/30 text-white hover:bg-white hover:text-brand-heading"
                aria-label="Abrir recorrido en video hasta Óptica Alemania"
              />
            </div>
          </div>

          <!-- Mobile Layout (Vertical stack matching 10_contacto_mobile.png) -->
          <div class="sm:hidden flex flex-col">
            <!-- Facade Thumbnail with Play Button -->
            <a
              href={contactSection.routeVideo.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-16/10 overflow-hidden"
              aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
            >
              <img
                src={contactSection.facadeImage.src}
                alt={contactSection.facadeImage.alt}
                width={contactSection.facadeImage.width}
                height={contactSection.facadeImage.height}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/30"></div>
              
              <!-- Play Button -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg">
                  <Icon name="play" class="w-6 h-6 fill-white ml-0.5" />
                </div>
              </div>
            </a>

            <!-- Content & Button -->
            <div class="p-5 flex flex-col">
              <span class="text-xs font-semibold uppercase tracking-widest text-blue-400">
                {contactSection.routeVideo.eyebrow}
              </span>
              <h3 class="font-display text-xl sm:text-2xl text-white leading-snug mt-1">
                {contactSection.routeVideo.title}
              </h3>
              <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                {contactSection.routeVideo.description}
              </p>

              <!-- Outlined Glass Pill Action Button -->
              <Button
                variant="glass"
                size="sm"
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                icon="arrow-right"
                class="mt-4 w-full justify-center"
                aria-label="Ver video del recorrido paso a paso"
              >
                {contactSection.routeVideo.actionTextMobile}
              </Button>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
