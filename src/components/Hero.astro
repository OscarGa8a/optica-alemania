---
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';

const whatsappHeroUrl = buildWhatsAppLink(
  'Hola, visité la página de Óptica Alemania y quisiera información sobre sus servicios.',
  siteConfig.contact.whatsappNumber
);
---

<section
  id="inicio"
  class="relative w-full min-h-[100dvh] flex flex-col justify-start lg:justify-center overflow-hidden bg-white"
>
  
  <!-- Full-bleed Background Image occupying 100% width and 100% height of the Hero -->
  <div class="absolute inset-0 w-full h-full z-0 select-none pointer-events-none">
    <picture class="block w-full h-full">
      <!-- Mobile source (< 1024px) -->
      <source
        media="(max-width: 1023px)"
        srcset="/images/hero-mobile.webp"
        type="image/webp"
      />
      <!-- Desktop source (>= 1024px) -->
      <source
        media="(min-width: 1024px)"
        srcset="/images/hero-desktop.webp"
        type="image/webp"
      />
      <img
        src="/images/hero-desktop.webp"
        alt="Examen optométrico de alta tecnología en Óptica Alemania Villavicencio"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center lg:object-right"
      />
    </picture>

    <!-- Desktop gradient: cubre la mitad izquierda (w-1/2) para máxima legibilidad del bloque editorial -->
    <div class="hidden lg:block absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-white via-white/80 to-transparent pointer-events-none"></div>

    <!-- Mobile gradient: de arriba hacia abajo para legibilidad total del texto y botón conocer servicios -->
    <div class="block lg:hidden absolute inset-0 bg-gradient-to-b from-white/95 via-white/85 via-[52%] to-transparent to-[60%] pointer-events-none"></div>
  </div>

  <!-- Content Container: alineado a la izquierda con el header -->
  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-20 pb-8 sm:pt-24 sm:pb-12 lg:py-24">
    <div class="max-w-xl lg:max-w-2xl xl:max-w-3xl 2xl:max-w-4xl flex flex-col items-start">
      
      <!-- Eyebrow matching mockup & about rhythm -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-[0.2em] text-brand-primary">
          ÓPTICA ALEMANIA · VILLAVICENCIO
        </span>
      </div>

      <!-- Hero Heading H1: Fluid Instrument Serif scaling smoothly with screen width -->
      <h1 class="font-display text-[clamp(2.15rem,1.25rem+3.6vw,5.5rem)] text-brand-heading leading-tight tracking-tight mt-3 sm:mt-6">
        <span class="block">Cuidamos tu visión</span>
        <span class="block italic text-brand-primary font-normal">con experiencia</span>
        <span class="block">y tecnología.</span>
      </h1>

      <!-- Subtitle matching desktop & mobile mockups and about rhythm -->
      <p class="mt-3 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-slate-800 font-medium sm:font-normal leading-relaxed max-w-md sm:max-w-lg xl:max-w-xl">
        Atención optométrica, evaluaciones especializadas y soluciones para tu salud visual en Villavicencio.
      </p>

      <!-- Actions Container matching about rhythm -->
      <div class="mt-5 sm:mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-5 w-full sm:w-auto">
        
        <!-- Primary CTA (WhatsApp) -->
        <Button
          variant="primary"
          href={whatsappHeroUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_cta"
          data-event-location="hero_primary"
          icon="whatsapp"
          iconPosition="left"
        >
          Consultar por WhatsApp
        </Button>

        <!-- Secondary CTA Desktop: Pill Button -->
        <Button
          variant="secondary"
          href="#servicios"
          data-event="services_scroll"
          data-event-location="hero_secondary_desktop"
          icon="arrow-right"
          class="hidden sm:inline-flex"
        >
          Conocer servicios
        </Button>

        <!-- Secondary CTA Mobile: Underlined Link matching mobile mockup -->
        <Button
          variant="link"
          size="sm"
          href="#servicios"
          data-event="services_scroll"
          data-event-location="hero_secondary_mobile"
          icon="arrow-right"
          class="inline-flex sm:hidden"
        >
          Conocer servicios
        </Button>

      </div>

    </div>
  </div>

</section>
