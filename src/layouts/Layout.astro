---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Analytics from '../components/Analytics.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  gtmId?: string;
  currentPath?: string;
  headerTheme?: 'dark-hero' | 'light';
  navVariant?: 'transparent' | 'light';
  preloadMobileImage?: string;
  preloadDesktopImage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  floatingWhatsAppMessage?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  robots,
  gtmId = import.meta.env.PUBLIC_GTM_ID,
  currentPath = '/',
  headerTheme,
  navVariant,
  preloadMobileImage,
  preloadDesktopImage,
  ogImage,
  ogImageAlt,
  floatingWhatsAppMessage,
} = Astro.props;

const effectiveTheme: 'dark-hero' | 'light' = headerTheme || (navVariant === 'light' ? 'light' : 'dark-hero');

// Preload de Hero LCP adaptativo según página
const defaultMobilePreload = currentPath === '/nosotros'
  ? '/images/nosotros-hero-mobile.webp'
  : '/images/hero-mobile.webp';
const defaultDesktopPreload = currentPath === '/nosotros'
  ? '/images/nosotros-hero-desktop.webp'
  : '/images/hero-desktop.webp';

const resolvedMobilePreload = preloadMobileImage ?? defaultMobilePreload;
const resolvedDesktopPreload = preloadDesktopImage ?? defaultDesktopPreload;

// OpenGraph & Twitter Image adaptativo
const defaultOgImage = currentPath === '/nosotros'
  ? 'https://opticaalemania.co/images/nosotros-hero-desktop.webp'
  : 'https://opticaalemania.co/images/hero-desktop.webp';
const defaultOgImageAlt = currentPath === '/nosotros'
  ? 'Sobre Nosotros - Óptica Alemania en Villavicencio'
  : 'Óptica Alemania en Villavicencio - Optometría y salud visual';

const resolvedOgImage = ogImage || defaultOgImage;
const resolvedOgImageAlt = ogImageAlt || defaultOgImageAlt;

// Mensaje contextual de WhatsApp para widget flotante
const defaultWhatsAppMessage = currentPath === '/nosotros'
  ? 'Hola, estuve viendo la sección Nosotros de Óptica Alemania y deseo solicitar información o agendar una cita.'
  : 'Hola, estoy visitando la web de Óptica Alemania y deseo solicitar atención o agendar una cita.';

const resolvedWhatsAppMessage = floatingWhatsAppMessage || defaultWhatsAppMessage;

// PLAYBOOK Fase 4: Arquitectura de Protección de Staging en Doble Capa
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://opticaalemania.co';
const canonicalUrl = `${siteUrl.replace(/\/$/, '')}${currentPath === '/' ? '/' : currentPath.startsWith('/') ? currentPath : `/${currentPath}`}`;
const publicEnv = import.meta.env.PUBLIC_ENV || '';
const publicNoindex = import.meta.env.PUBLIC_NOINDEX;

const isStagingDomain = siteUrl.includes('oscardev.co') || siteUrl.includes('pages.dev') || siteUrl.includes('vercel.app');
const isStagingEnv = publicEnv === 'staging' || publicEnv === 'preview' || publicEnv === 'development';
const isExplicitNoindex = publicNoindex === 'true' || publicNoindex === true;
const isStaging = isStagingDomain || isStagingEnv || isExplicitNoindex;

const defaultRobots = isStaging ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const resolvedRobots = robots || defaultRobots;

// PLAYBOOK Fase 4: Schema.org Multigrafo @graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Optician",
      "@id": "https://opticaalemania.co/#optician",
      "name": siteConfig.name,
      "legalName": siteConfig.legalName,
      "url": "https://opticaalemania.co",
      "telephone": siteConfig.contact.phoneTel,
      "priceRange": "$$",
      "image": "https://opticaalemania.co/images/hero-desktop.webp",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.contact.address,
        "addressLocality": siteConfig.contact.city,
        "addressRegion": siteConfig.contact.department,
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 4.1420,
        "longitude": -73.6266
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:30",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday"],
          "opens": "08:30",
          "closes": "15:00"
        }
      ],
      "sameAs": [
        siteConfig.social.instagram,
        siteConfig.social.facebook,
        siteConfig.contact.googleMapsUrl
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://opticaalemania.co/#website",
      "url": "https://opticaalemania.co",
      "name": siteConfig.name,
      "inLanguage": "es-CO"
    },
    {
      "@type": "FAQPage",
      "@id": "https://opticaalemania.co/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Dónde está ubicada Óptica Alemania en Villavicencio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estamos ubicados en Calle 35 #34-36, Barzal Bajo, Villavicencio, Meta, en la zona médica de la ciudad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuáles son los horarios de atención?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos de lunes a viernes de 8:30 a.m. a 6:00 p.m. y sábados de 8:30 a.m. a 3:00 p.m. en jornada continua."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo puedo agendar una consulta de optometría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puedes agendar tu cita directamente a través de nuestro canal de WhatsApp (+57 311 201 7302) o comunicándote al 322 712 8828."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tienen convenio con Cofrem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, como afiliados al Club Descuentos Cofrem ofrecemos 15% de descuento en monturas y 10% en lentes oftálmicos."
          }
        }
      ]
    },
    ...(currentPath === '/nosotros' ? [
      {
        "@type": "AboutPage",
        "@id": `${canonicalUrl}#aboutpage`,
        "url": canonicalUrl,
        "name": title,
        "description": description,
        "inLanguage": "es-CO",
        "isPartOf": {
          "@id": "https://opticaalemania.co/#website"
        },
        "about": {
          "@id": "https://opticaalemania.co/#optician"
        }
      }
    ] : [])
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- LCP Hero Image Preloads -->
    {resolvedMobilePreload && (
      <link
        rel="preload"
        as="image"
        href={resolvedMobilePreload}
        type="image/webp"
        media="(max-width: 1023px)"
        fetchpriority="high"
      />
    )}
    {resolvedDesktopPreload && (
      <link
        rel="preload"
        as="image"
        href={resolvedDesktopPreload}
        type="image/webp"
        media="(min-width: 1024px)"
        fetchpriority="high"
      />
    )}

    <!-- ClientRouter for SPA transitions and lifecycle events -->
    <ClientRouter />

    <!-- Robots & Staging Isolation (Capa 1) -->
    <meta name="robots" content={resolvedRobots} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <!-- Schema.org JSON-LD Multigrafo -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- PLAYBOOK Fase 4: Salvaguarda Dinámica en Runtime (Capa 2) -->
    <script is:inline>
      (function() {
        try {
          var host = window.location.hostname;
          var isStagingHost = host.includes('oscardev.co') || host.endsWith('.pages.dev') || host.endsWith('.vercel.app');
          var isProdHost = host === 'opticaalemania.co' || host === 'www.opticaalemania.co';
          if (isStagingHost && !isProdHost) {
            var meta = document.querySelector('meta[name="robots"]');
            if (meta) {
              meta.setAttribute('content', 'noindex, nofollow');
            } else {
              var m = document.createElement('meta');
              m.name = 'robots';
              m.content = 'noindex, nofollow';
              document.head.appendChild(m);
            }
          }
        } catch (_) {}
      })();
    </script>

    <!-- Initialize dataLayer immediately to buffer events safely -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <!-- PLAYBOOK Fase 7: Deferred High-Performance GTM (Zero-TBT) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window._loadGTM = function() {
          if (window._gtmLoaded) return;
          window._gtmLoaded = true;
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() { setTimeout(window._loadGTM, 2500); });
        } else {
          setTimeout(window._loadGTM, 3000);
        }

        ['pointerdown', 'touchstart', 'scroll', 'keydown', 'click'].forEach(function(evt) {
          window.addEventListener(evt, window._loadGTM, { once: true, passive: true });
        });
      </script>
    )}
  </head>
  <body class="bg-brand-surface text-brand-body antialiased selection:bg-brand-blue-soft selection:text-brand-primary">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <Navbar currentPath={currentPath} theme={effectiveTheme} />
    <main id="main-content">
      <slot />
    </main>
    <FloatingWhatsApp message={resolvedWhatsAppMessage} />
    <Analytics />
  </body>
</html>
