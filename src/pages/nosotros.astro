---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutTrajectory from '../components/about/AboutTrajectory.astro';
import AboutPurpose from '../components/about/AboutPurpose.astro';
import AboutTeam from '../components/about/AboutTeam.astro';
import AboutSpaces from '../components/about/AboutSpaces.astro';
import AboutCta from '../components/about/AboutCta.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';

const pageTitle = `Nosotros | Óptica Alemania en Villavicencio`;
const pageDescription = "Conoce la historia, el equipo y los espacios de Óptica Alemania en Villavicencio. Descubre qué nos mueve y cómo puedes comunicarte con nosotros.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/nosotros"
  headerTheme="light"
  preloadMobileImage="/images/nosotros-hero-mobile.webp"
  preloadDesktopImage="/images/nosotros-hero-desktop.webp"
  ogImage="https://opticaalemania.co/images/nosotros-hero-desktop.webp"
  ogImageAlt="Sobre Nosotros - Óptica Alemania en Villavicencio"
>
  <AboutHero />
  <AboutTrajectory />
  <AboutPurpose />
  <AboutTeam />
  <AboutSpaces />
  <AboutCta />
  <Footer currentPath="/nosotros" />
</Layout>
