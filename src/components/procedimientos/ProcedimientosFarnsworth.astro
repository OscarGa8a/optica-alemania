---
// Sección 3 — Visión del Color (Test de Farnsworth D-15)
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import VideoPlayer from '../ui/VideoPlayer.astro';

const { farnsworth } = siteConfig.procedimientosPage;
const whatsappUrl = buildWhatsAppLink(
  farnsworth.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id={farnsworth.id}
  class="relative bg-[#F8FAFC] text-brand-body py-14 sm:py-20 lg:py-28 overflow-hidden scroll-mt-20 lg:scroll-mt-24"
  aria-labelledby="farnsworth-heading"
>
  <!-- Subtle decorative gradient accents matching Figma -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none select-none"
    aria-hidden="true"
  ></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-x-14 lg:gap-y-6 items-center">
      
      <!-- Eyebrow & H2 Heading (Row 1 on mobile, Col 1-5 Row 1 on desktop) -->
      <div class="order-1 lg:order-1 lg:col-span-5 lg:col-start-1 lg:self-end">
        <div>
          <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
            {farnsworth.eyebrow}
          </span>
        </div>

        <h2
          id="farnsworth-heading"
          class="font-display text-[2.6rem] sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] 2xl:text-[4.25rem] text-brand-heading leading-[1.04] tracking-tight mt-3 sm:mt-5"
        >
          <span class="block font-normal">{farnsworth.titleLine1}</span>
          <span class="block font-normal">{farnsworth.titleLine2}</span>
          <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine1 || farnsworth.titleHighlight}</span>
          {farnsworth.titleHighlightLine2 && (
            <span class="block italic font-normal text-brand-primary">{farnsworth.titleHighlightLine2}</span>
          )}
        </h2>
      </div>

      <!-- Video Player Card (Row 2 on mobile, Col 6-12 Row 1-2 on desktop) -->
      <div class="order-2 lg:order-3 lg:col-span-7 lg:col-start-6 lg:row-span-2">
        <VideoPlayer
          id={farnsworth.videoId}
          src={farnsworth.video.src}
          poster={farnsworth.video.poster}
          alt={farnsworth.video.alt}
          initialTimestamp={farnsworth.video.initialTimestamp}
          initialProgress={farnsworth.video.initialProgress}
        />
      </div>

      <!-- Descriptive Paragraph & CTA Button (Row 3 on mobile, Col 1-5 Row 2 on desktop) -->
      <div class="order-3 lg:order-2 lg:col-span-5 lg:col-start-1 lg:self-start">
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-1 sm:mt-2 font-normal">
          {farnsworth.description}
        </p>

        <div class="mt-6 sm:mt-8">
          <Button
            variant="primary"
            size="lg"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_cta"
            data-event-location="procedimientos_farnsworth"
            icon="arrow-right"
            iconPosition="right"
            class="w-full sm:w-auto inline-flex items-center !justify-between sm:!justify-center gap-3 px-6 sm:px-8 py-3.5 sm:py-4"
          >
            <span class="inline-flex items-center gap-2.5">
              <Icon name="whatsapp" class="w-5 h-5 fill-current shrink-0" />
              <span class="text-sm sm:text-base font-semibold whitespace-nowrap">{farnsworth.ctaText}</span>
            </span>
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>
