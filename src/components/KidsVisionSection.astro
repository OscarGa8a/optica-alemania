---
// Sección 6 — Salud Visual Infantil
// Óptica Alemania Villavicencio
import { siteConfig } from '../data/siteConfig';
import { buildWhatsAppLink } from '../utils/whatsapp';
import Button from './ui/Button.astro';
import VideoPlayer from './ui/VideoPlayer.astro';

const { kidsVision } = siteConfig;
const whatsappKidsUrl = buildWhatsAppLink(
  kidsVision.whatsappMessage,
  siteConfig.contact.whatsappNumber
);
---

<section
  id="infantil"
  class="relative bg-brand-cool text-brand-body py-14 sm:py-16 lg:py-24 scroll-mt-20 overflow-hidden"
>
  <!-- Atmospheric soft ambient clinic lighting matching brand tokens -->
  <div class="absolute -top-[10%] -right-[5%] w-[600px] h-[500px] bg-brand-blue-soft/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-[10%] -left-[5%] w-[500px] h-[450px] bg-brand-ice/40 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.22fr] gap-8 lg:gap-14 xl:gap-20 items-center">
      
      <!-- Left Column (Desktop): Eyebrow, Title, Description, Desktop CTAs -->
      <div class="flex flex-col items-start">
        <!-- Eyebrow -->
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-brand-primary">
          {kidsVision.eyebrow}
        </span>

        <!-- Section Title: 3 lines in Instrument Serif with editorial color contrast -->
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-brand-heading leading-tight tracking-tight mt-3 sm:mt-4">
          <span class="block font-normal">{kidsVision.titlePart1}</span>
          <span class="block italic font-normal text-brand-primary">{kidsVision.titlePart2}</span>
          <span class="block italic font-normal text-brand-primary">{kidsVision.titlePart3}</span>
        </h2>

        <!-- Context Description -->
        <p class="text-sm sm:text-base lg:text-lg text-brand-body leading-relaxed mt-4 sm:mt-6 max-w-xl">
          {kidsVision.description}
        </p>

        <!-- Desktop Action Container -->
        <div class="hidden lg:flex flex-col items-start gap-4 mt-7 sm:mt-8">
          <Button
            variant="link"
            size="lg"
            href={whatsappKidsUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="arrow-right"
            data-event="whatsapp_cta"
            data-event-location="kids_vision"
            aria-label="Consultar por atención visual infantil en Óptica Alemania vía WhatsApp"
          >
            {kidsVision.ctaText}
          </Button>

          <p class="text-xs sm:text-sm text-brand-body/80">
            {kidsVision.noteText}
          </p>
        </div>
      </div>

      <!-- Right Column: Video Preview Card & Mobile Bottom CTAs -->
      <div class="flex flex-col">
        <!-- Interactive Video Card -->
        <VideoPlayer
          id="kids-vision-video"
          src={kidsVision.videoSrc}
          poster={kidsVision.image.src}
          pngFallback={kidsVision.image.pngFallback}
          alt={kidsVision.image.alt}
          label="Evaluación optométrica infantil en Óptica Alemania Villavicencio"
          initialTimestamp={`0:00 / ${kidsVision.videoDuration}`}
          initialProgress={0}
          class="shadow-xs border-white/80"
        />

        <!-- Mobile Action Container (placed below video card matching mobile mockup) -->
        <div class="lg:hidden flex flex-col items-start gap-3 mt-6 sm:mt-7">
          <Button
            variant="link"
            size="md"
            href={whatsappKidsUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="arrow-right"
            data-event="whatsapp_cta"
            data-event-location="kids_vision"
            aria-label="Consultar por atención visual infantil en Óptica Alemania vía WhatsApp"
          >
            {kidsVision.ctaText}
          </Button>

          <p class="text-xs sm:text-sm text-brand-body/80">
            {kidsVision.noteText}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
