---
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';
import { obtenerVideoContacto } from '../lib/sanity/videos';

const pageTitle = `Cómo llegar a Óptica Alemania | Barzal, Villavicencio`;
const pageDescription = "Óptica Alemania está en Calle 35 #34-36, Barzal, Villavicencio. Lun–vie 9–12 y 2–6; sáb 9–12 y 1–3. WhatsApp 311 201 7302 o llama al 322 712 8828.";

const videoContacto = await obtenerVideoContacto();
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/contacto/"
  headerTheme="light"
>
  <ContactHero />
  <ContactLocation routeVideo={videoContacto} />
  <Footer currentPath="/contacto/" />
</Layout>
