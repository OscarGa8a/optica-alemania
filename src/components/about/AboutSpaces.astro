---
// Sección 5 — Nuestros Espacios
// Óptica Alemania Villavicencio
---

<section id="espacios" class="relative bg-brand-cool py-20 sm:py-24 lg:py-28 scroll-mt-20 overflow-hidden">
  <!-- Subtle Arc Watermark in Upper-Right matching mockup -->
  <div
    class="absolute -right-32 sm:-right-40 -top-28 sm:-top-44 w-full max-w-xl lg:max-w-3xl pointer-events-none opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header: Title left, Description right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-14 items-end mb-12 sm:mb-16 lg:mb-20">
      <!-- Title & Eyebrow -->
      <div class="lg:col-span-7">
        <!-- Eyebrow without line (consistent across sections) -->
        <div>
          <span class="text-xs uppercase font-semibold tracking-widest text-brand-primary">
            NUESTROS ESPACIOS
          </span>
        </div>

        <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-brand-heading tracking-tight leading-none mt-4 sm:mt-6">
          Así es nuestra<br />
          <span class="italic text-brand-primary">óptica.</span>
        </h2>
      </div>

      <!-- Description Paragraph (verbatim from mockup) -->
      <div class="lg:col-span-5">
        <p class="text-base sm:text-lg lg:text-xl text-brand-body leading-relaxed font-normal max-w-lg">
          Conoce los espacios de Óptica Alemania Villavicencio, desde nuestra zona de monturas hasta el consultorio donde realizamos las evaluaciones visuales.
        </p>
      </div>
    </div>

    <!-- Full-Width Rounded Showroom Photo -->
    <div class="relative w-full rounded-3xl overflow-hidden shadow-xs bg-brand-border h-112 sm:h-128 lg:h-140 xl:h-150">
      <picture class="block w-full h-full">
        <img
          src="/images/nosotros-espacios.webp"
          alt="Instalaciones de Óptica Alemania Villavicencio: exhibición de monturas y consultorios"
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-center"
        />
      </picture>
    </div>

  </div>
</section>
