---
// Sección 1 — Hero Contacto
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';
import Button from '../ui/Button.astro';

const whatsappUrl = buildWhatsAppLink(
  'Hola, quisiera recibir información sobre los servicios de Óptica Alemania.',
  siteConfig.contact.whatsappNumber
);
---

<section
  id="inicio"
  class="relative w-full min-h-screen lg:min-h-180 xl:min-h-screen flex flex-col justify-center bg-gradient-to-br from-brand-mist via-brand-cool to-brand-surface overflow-hidden"
>
  <!-- Large Brand Wave Arc Watermark across the Hero (centered vertically, taller, and slightly cropped at the right edge) -->
  <div
    class="absolute right-0 translate-x-1/4 sm:translate-x-1/3 top-1/2 -translate-y-1/2 h-4/5 sm:h-5/6 lg:h-full w-auto pointer-events-none opacity-30 sm:opacity-35 lg:opacity-40 select-none z-0 flex items-center"
    aria-hidden="true"
  >
    <img
      src="/images/contact/assets.webp"
      alt=""
      width="1774"
      height="887"
      loading="eager"
      decoding="async"
      class="h-full w-auto max-w-none object-contain"
    />
  </div>

  <!-- Content Container: Aligned with universal fluid container and Hero / AboutHero left spacing -->
  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-24 pb-12 sm:pt-28 sm:pb-16 lg:py-24">
    <div class="max-w-xl lg:max-w-2xl xl:max-w-3xl 2xl:max-w-4xl flex flex-col items-start">
      <!-- Eyebrow matching Hero & AboutHero rhythm -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-widest text-brand-primary">
          CONTACTO · ÓPTICA ALEMANIA
        </span>
      </div>

      <!-- Hero Heading H1: Fluid Instrument Serif scaling smoothly with screen width -->
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-brand-heading tracking-tight leading-none mt-4 sm:mt-6">
        <span class="block">Hablemos de</span>
        <span class="block italic font-normal text-brand-primary">tu visión.</span>
      </h1>

      <!-- Subtitle / Lead Paragraph matching Hero & AboutHero tokens -->
      <p class="mt-4 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-brand-body font-normal leading-relaxed max-w-md sm:max-w-lg xl:max-w-xl">
        ¿Tienes preguntas sobre nuestros servicios o necesitas información antes de visitarnos? Escríbenos o llámanos para resolver tus dudas y conocer las opciones de atención disponibles.
      </p>

      <!-- Action Buttons using shared Button and Icon components -->
      <div class="mt-6 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-5 w-full sm:w-auto">
        <!-- WhatsApp Primary Button -->
        <Button
          variant="primary"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_cta"
          data-event-location="contact_hero"
          aria-label="Escribir a Óptica Alemania por WhatsApp"
          icon="whatsapp"
          iconPosition="left"
          class="w-full sm:w-auto"
        >
          Escribir por WhatsApp
        </Button>

        <!-- Call Secondary Button -->
        <Button
          variant="secondary"
          href={`tel:${siteConfig.contact.phoneTel}`}
          data-event="phone_call"
          data-event-location="contact_hero"
          aria-label="Llamar a Óptica Alemania"
          icon="phone"
          iconPosition="left"
          class="w-full sm:w-auto"
        >
          Llamar ahora
        </Button>
      </div>
    </div>
  </div>
</section>
