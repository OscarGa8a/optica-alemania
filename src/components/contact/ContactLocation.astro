---
// Sección 2 — Ubicación y Video de Recorrido
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';

const { contact, contactSection } = siteConfig;
const googleMapsUrl = contact.googleMapsUrl;
const whatsappContactUrl = buildWhatsAppLink(
  contactSection.whatsappMessage,
  contact.whatsappNumber
);
---

<section id="ubicacion" class="relative overflow-hidden">
  
  <!-- Sub-sección 1: Encuéntranos en Villavicencio -->
  <div class="bg-[#FAFBFD] py-12 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Details & Direction (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col">
          <!-- Eyebrow with decorative rule -->
          <div class="flex items-center gap-3">
            <span class="text-xs uppercase font-semibold tracking-[0.2em] text-brand-primary">
              DÓNDE ENCONTRARNOS
            </span>
            <span class="w-10 h-[1.5px] bg-[#9BB0CE]" aria-hidden="true"></span>
          </div>

          <!-- H2 Heading -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-normal text-brand-heading tracking-tight leading-[1.08] mt-3 sm:mt-4">
            Nos vemos<br />
            <span class="italic text-brand-primary">en Barzal.</span>
          </h2>

          <!-- Description -->
          <p class="mt-3 sm:mt-4 text-[15px] sm:text-base text-brand-body leading-relaxed max-w-md">
            Estamos en Villavicencio. Aquí encontrarás nuestra dirección, los horarios de referencia y las opciones para llegar a Óptica Alemania.
          </p>

          <!-- Desktop Contact List (Vertical stack, hidden on mobile) -->
          <div class="hidden md:flex flex-col gap-5 mt-7 sm:mt-8">
            
            <!-- Dirección -->
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary shrink-0 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-brand-muted font-medium">Dirección</p>
                <p class="text-brand-heading text-[15px] sm:text-base font-medium mt-0.5">
                  {contact.address}, {contact.city}, {contact.department}.
                </p>
              </div>
            </div>

            <!-- Teléfonos -->
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary shrink-0 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-brand-muted font-medium">Teléfonos</p>
                <p class="text-brand-heading text-[15px] sm:text-base font-medium mt-0.5">
                  <a href={`tel:${contact.phonePrimary.replace(/\s+/g, '')}`} class="hover:text-brand-primary transition-colors">{contact.phonePrimary}</a>
                  <span class="text-slate-400 mx-2">|</span>
                  <a href={`tel:${contact.phoneSecondary.replace(/\s+/g, '')}`} class="hover:text-brand-primary transition-colors">{contact.phoneSecondary}</a>
                </p>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary shrink-0 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-brand-muted font-medium">Horarios de atención</p>
                <p class="text-brand-heading text-[15px] sm:text-base font-normal mt-0.5 leading-snug">
                  Lunes a viernes: 8:30 a. m. – 6:00 p. m.<br />
                  Sábados: 8:30 a. m. – 3:00 p. m.
                </p>
              </div>
            </div>

            <!-- Instagram -->
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary shrink-0 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                </svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-brand-muted font-medium">Instagram</p>
                <p class="text-brand-heading text-[15px] sm:text-base font-medium mt-0.5">
                  <a
                    href={contact.instagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-brand-primary transition-colors"
                  >
                    {contact.instagram}
                  </a>
                </p>
              </div>
            </div>

          </div>

          <!-- Mobile Contact Row (4 columns matching 2_ubicacion_mobile.png) -->
          <div class="grid grid-cols-4 gap-2 text-center md:hidden my-6">
            <!-- Dirección -->
            <div class="flex flex-col items-center">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary mb-1.5 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <p class="text-[11px] font-semibold text-brand-heading">Dirección</p>
              <p class="text-[10px] text-brand-body leading-tight mt-0.5">Calle 35 #34-36,<br />Barzal Bajo</p>
            </div>

            <!-- Teléfonos -->
            <div class="flex flex-col items-center">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary mb-1.5 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <p class="text-[11px] font-semibold text-brand-heading">Teléfonos</p>
              <p class="text-[10px] text-brand-body leading-tight mt-0.5">311 201 7302<br />322 712 8828</p>
            </div>

            <!-- Horarios -->
            <div class="flex flex-col items-center">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary mb-1.5 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <p class="text-[11px] font-semibold text-brand-heading">Horarios</p>
              <p class="text-[10px] text-brand-body leading-tight mt-0.5">Lun a vie: 8:30–6<br />Sáb: 8:30–3</p>
            </div>

            <!-- Instagram -->
            <div class="flex flex-col items-center">
              <div class="w-11 h-11 rounded-full bg-[#EBF3FB] border border-[#D3E3F5] flex items-center justify-center text-brand-primary mb-1.5 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                </svg>
              </div>
              <p class="text-[11px] font-semibold text-brand-heading">Instagram</p>
              <p class="text-[10px] text-brand-body leading-tight mt-0.5">@optica<br />alemania</p>
            </div>
          </div>

          <!-- Primary WhatsApp Conversion Button (Matching 2_ubicacion_desktop.png) -->
          <div class="mt-6 sm:mt-8 max-w-lg w-full">
            <a
              href={whatsappContactUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-event="whatsapp_cta"
              data-event-location="contact_location_section"
              class="group w-full bg-[#1A6FEF] hover:bg-[#1559C7] text-white font-medium rounded-full py-4 px-6 sm:px-8 flex items-center justify-between shadow-lg shadow-blue-500/25 transition-all duration-300 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              aria-label="Contactar por WhatsApp a Óptica Alemania Villavicencio"
            >
              <span class="flex items-center gap-3">
                <svg class="w-6 h-6 fill-current text-white shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.078-1.558-.291-.84-.336-1.574-.919-2.146-1.491-.572-.572-1.155-1.306-1.491-2.146-.369-.924-.336-1.246-.291-1.558.05-.333.419-1.026.824-1.17.135-.048.28-.052.404-.009.124.043.238.152.327.327.24.475.584 1.155.635 1.258.051.103.086.223.017.36-.069.137-.103.223-.206.343-.103.12-.218.269-.311.362-.103.103-.211.215-.09.423.121.208.538.887 1.154 1.436.792.705 1.46.924 1.668 1.028.208.104.33-.09.433-.193.103-.103.447-.517.567-.695.12-.178.24-.149.4-.09.16.059 1.016.479 1.19.566.174.087.29.13.333.203.043.073.043.424-.101.829z"/>
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.661 1.434 5.176L2 22l4.981-1.396A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.637 0-3.167-.478-4.464-1.301l-.32-.204-3.136.878.835-3.053-.223-.338C3.805 14.819 3.3 13.46 3.3 12c0-4.797 3.903-8.7 8.7-8.7s8.7 3.903 8.7 8.7-3.903 8.7-8.7 8.7z"/>
                </svg>
                <span class="text-base sm:text-lg font-medium">Contactar por WhatsApp</span>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>

        </div>

        <!-- Right Column: Illustrated Map Card (col-span-7) -->
        <div class="lg:col-span-7">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="google_maps_click"
            data-event-location="contact_location_map"
            class="group block relative rounded-2xl lg:rounded-3xl overflow-hidden border border-brand-border/70 shadow-md hover:shadow-xl transition-all duration-300 bg-white"
            aria-label="Abrir mapa de ubicación de Óptica Alemania Barzal en Google Maps"
          >
            <picture>
              <source srcset="/images/contact/2_ubicacion_map.webp" type="image/webp" />
              <img
                src="/images/contact/2_ubicacion_map.png"
                alt="Mapa ilustrado de ubicación de Óptica Alemania en Calle 35 #34-36, Barzal, Villavicencio"
                width="1656"
                height="811"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-500"
              />
            </picture>

            <!-- Subtle badge overlay -->
            <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6">
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/95 backdrop-blur-xs text-brand-heading text-xs font-semibold shadow-sm border border-brand-border/60 group-hover:bg-brand-primary group-hover:text-white transition-colors duration-200">
                <span>Abrir mapa</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17l9.2-9.2M17 17V7H7"/>
                </svg>
              </span>
            </div>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Sub-sección 2: Te mostramos el camino (Full-width light blue band) -->
  <div class="bg-gradient-to-br from-[#ECF5FD] via-[#F1F7FD] to-[#F8FAFD] border-t border-[#DFEBF8] py-12 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Copy & Title (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col">
          <div class="flex items-center gap-3">
            <span class="text-xs uppercase font-semibold tracking-[0.2em] text-brand-primary">
              ¿VIENES POR PRIMERA VEZ?
            </span>
            <span class="w-10 h-[1.5px] bg-[#9BB0CE]" aria-hidden="true"></span>
          </div>

          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-normal text-brand-heading tracking-tight leading-tight mt-3">
            Te mostramos <span class="italic text-brand-primary">cómo llegar.</span>
          </h3>

          <p class="mt-3 text-sm sm:text-base text-brand-body leading-relaxed max-w-md">
            Mira nuestro recorrido en video para reconocer el lugar y encontrar más fácilmente la entrada de la óptica.
          </p>
        </div>

        <!-- Right Column: Route Video Card (col-span-7) -->
        <div class="lg:col-span-7">
          <div class="rounded-[24px] sm:rounded-[28px] overflow-hidden border border-blue-500/20 bg-[#102341] shadow-xl">
            <!-- Desktop Layout (Horizontal split) -->
            <div class="hidden sm:grid sm:grid-cols-[1.05fr_1.1fr] items-center">
              <!-- Facade Thumbnail with Play Button -->
              <a
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block aspect-[16/10] overflow-hidden"
                aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
              >
                <picture>
                  <source srcset="/images/contact/2_ubicacion_image.webp" type="image/webp" />
                  <img
                    src="/images/contact/2_ubicacion_image.png"
                    alt={contactSection.facadeImage.alt}
                    width={contactSection.facadeImage.width}
                    height={contactSection.facadeImage.height}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors"></div>
                
                <!-- Play Button -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-white ml-0.5" viewBox="0 0 24 24">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                  </div>
                </div>

                <!-- Bottom Left Badge: Ver cómo llegar -->
                <div class="absolute bottom-2.5 left-2.5">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[11px] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#3B82F6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                    <span>Ver cómo llegar</span>
                  </span>
                </div>

                <!-- Bottom Right Duration Badge: 1:28 -->
                <div class="absolute bottom-2.5 right-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-black/70 backdrop-blur-md text-white text-[11px] font-semibold tabular-nums">
                    1:28
                  </span>
                </div>
              </a>

              <!-- Content & Action -->
              <div class="p-6 lg:p-7 flex items-center justify-between gap-4">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-widest text-[#4B9BFA]">
                    {contactSection.routeVideo.eyebrow}
                  </span>
                  <h4 class="font-display text-xl lg:text-[24px] xl:text-[26px] text-white leading-tight mt-1.5">
                    {contactSection.routeVideo.title}
                  </h4>
                  <p class="text-xs lg:text-[13px] text-slate-300 mt-2 leading-relaxed max-w-xs">
                    {contactSection.routeVideo.description}
                  </p>
                </div>

                <!-- Action circular button -->
                <a
                  href={contactSection.routeVideo.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-event="route_video_click"
                  data-event-location="contact_tour_action"
                  class="w-11 h-11 rounded-full border border-white/30 flex items-center justify-center text-white hover:bg-white hover:text-[#0B1B36] transition-colors shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3B82F6]"
                  aria-label="Abrir recorrido en video hasta Óptica Alemania"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Mobile Layout (Vertical stack matching 2_ubicacion_mobile.png) -->
            <div class="sm:hidden flex flex-col">
              <!-- Facade Thumbnail with Play Button -->
              <a
                href={contactSection.routeVideo.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block aspect-[16/10] overflow-hidden"
                aria-label="Ver video del recorrido hasta Óptica Alemania en Barzal"
              >
                <picture>
                  <source srcset="/images/contact/2_ubicacion_image.webp" type="image/webp" />
                  <img
                    src="/images/contact/2_ubicacion_image.png"
                    alt={contactSection.facadeImage.alt}
                    width={contactSection.facadeImage.width}
                    height={contactSection.facadeImage.height}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div class="absolute inset-0 bg-black/30"></div>
                
                <!-- Play Button -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-white ml-0.5" viewBox="0 0 24 24">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                  </div>
                </div>

                <!-- Badges -->
                <div class="absolute bottom-2.5 left-2.5">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[11px] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#3B82F6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                    <span>Ver cómo llegar</span>
                  </span>
                </div>
                <div class="absolute bottom-2.5 right-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-black/70 backdrop-blur-md text-white text-[11px] font-semibold tabular-nums">
                    1:28
                  </span>
                </div>
              </a>

              <!-- Content & Button -->
              <div class="p-5 flex flex-col">
                <span class="text-[11px] font-semibold uppercase tracking-widest text-[#4B9BFA]">
                  {contactSection.routeVideo.eyebrow}
                </span>
                <h4 class="font-display text-[20px] text-white leading-snug mt-1">
                  {contactSection.routeVideo.title}
                </h4>
                <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                  {contactSection.routeVideo.description}
                </p>

                <!-- Outlined Pill Action Button -->
                <a
                  href={contactSection.routeVideo.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-event="route_video_click"
                  data-event-location="contact_tour_action_mobile"
                  class="mt-4 w-full border border-white/30 text-white rounded-full py-2.5 px-5 text-sm font-medium flex items-center justify-center gap-2 hover:bg-white/10 transition-colors"
                  aria-label="Ver video del recorrido paso a paso"
                >
                  <span>{contactSection.routeVideo.actionTextMobile}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>
