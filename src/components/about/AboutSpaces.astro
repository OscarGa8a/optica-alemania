---
// Sección 5 — Nuestros Espacios
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import Icon from '../ui/Icon.astro';
import ImageLightboxModal from '../ui/ImageLightboxModal.astro';

const { space } = siteConfig;
const lightboxId = 'nosotros-espacios-lightbox';
---

<section id="espacios" class="relative bg-brand-cool py-20 sm:py-24 lg:py-28 scroll-mt-20 overflow-hidden">
  <!-- Subtle Arc Watermark in Upper-Right matching mockup -->
  <div
    class="absolute -right-32 sm:-right-40 -top-28 sm:-top-44 w-full max-w-xl lg:max-w-3xl pointer-events-none opacity-20 select-none z-0"
    aria-hidden="true"
  >
    <img
      src="/images/asset.svg"
      alt=""
      width="1774"
      height="887"
      loading="lazy"
      decoding="async"
      class="w-full h-auto object-contain"
    />
  </div>

  <div class="w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 relative z-10">
    
    <!-- Section Header: Title left, Description right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-14 items-end mb-10 sm:mb-12 lg:mb-16">
      <!-- Title & Eyebrow -->
      <div class="lg:col-span-7">
        <!-- Eyebrow without line (consistent across sections) -->
        <div>
          <span class="text-xs uppercase font-semibold tracking-widest text-brand-primary">
            NUESTROS ESPACIOS
          </span>
        </div>

        <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-normal text-brand-heading tracking-tight leading-none mt-4 sm:mt-6">
          Así es nuestra<br />
          <span class="italic text-brand-primary">óptica.</span>
        </h2>
      </div>

      <!-- Description Paragraph (verbatim from mockup) -->
      <div class="lg:col-span-5">
        <p class="text-base sm:text-lg lg:text-xl text-brand-body leading-relaxed font-normal max-w-lg">
          Conoce los espacios de Óptica Alemania Villavicencio, desde nuestra zona de monturas hasta el consultorio donde realizamos las evaluaciones visuales.
        </p>
      </div>
    </div>

    <!-- Responsive Bento Photo Grid (5 images with fullscreen Lightbox) -->
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-3.5 sm:gap-5 lg:gap-6 items-stretch">
      <!-- Main Featured Space (Card 1) -->
      <button
        type="button"
        data-open-gallery-modal={lightboxId}
        data-gallery-index="0"
        aria-label={`Ampliar imagen: ${space.images[0].alt}`}
        class="col-span-2 lg:col-span-7 relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[16/10] sm:aspect-[16/9] lg:aspect-[16/10] group bg-brand-ice/20 cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary p-0 block"
      >
        <img
          src={space.images[0].src}
          srcset={`${space.images[0].src.replace('.webp', '-sm.webp')} 640w, ${space.images[0].src} 1200w`}
          sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1024px) calc(100vw - 64px), 58vw"
          alt={space.images[0].alt}
          width="1200"
          height="900"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 shadow-md border border-white/20">
          <Icon name="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" />
        </div>
      </button>

      <!-- Secondary Featured Space (Card 2) -->
      <button
        type="button"
        data-open-gallery-modal={lightboxId}
        data-gallery-index="1"
        aria-label={`Ampliar imagen: ${space.images[1].alt}`}
        class="col-span-1 lg:col-span-5 relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[4/3] lg:aspect-auto lg:h-full group bg-brand-ice/20 cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary p-0 block"
      >
        <img
          src={space.images[1].src}
          srcset={`${space.images[1].src.replace('.webp', '-sm.webp')} 480w, ${space.images[1].src} 960w`}
          sizes="(max-width: 640px) calc(50vw - 32px), (max-width: 1024px) calc(50vw - 40px), 42vw"
          alt={space.images[1].alt}
          width="960"
          height="720"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 shadow-md border border-white/20">
          <Icon name="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" />
        </div>
      </button>

      <!-- Detail Space 1 (Card 3) -->
      <button
        type="button"
        data-open-gallery-modal={lightboxId}
        data-gallery-index="2"
        aria-label={`Ampliar imagen: ${space.images[2].alt}`}
        class="col-span-1 lg:col-span-4 relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[4/3] lg:aspect-[16/11] group bg-brand-ice/20 cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary p-0 block"
      >
        <img
          src={space.images[2].src}
          srcset={`${space.images[2].src.replace('.webp', '-sm.webp')} 480w, ${space.images[2].src} 960w`}
          sizes="(max-width: 640px) calc(50vw - 32px), (max-width: 1024px) calc(50vw - 40px), 33vw"
          alt={space.images[2].alt}
          width="960"
          height="720"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 shadow-md border border-white/20">
          <Icon name="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" />
        </div>
      </button>

      <!-- Detail Space 2 (Card 4) -->
      <button
        type="button"
        data-open-gallery-modal={lightboxId}
        data-gallery-index="3"
        aria-label={`Ampliar imagen: ${space.images[3].alt}`}
        class="col-span-1 lg:col-span-4 relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[4/3] lg:aspect-[16/11] group bg-brand-ice/20 cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary p-0 block"
      >
        <img
          src={space.images[3].src}
          srcset={`${space.images[3].src.replace('.webp', '-sm.webp')} 480w, ${space.images[3].src} 960w`}
          sizes="(max-width: 640px) calc(50vw - 32px), (max-width: 1024px) calc(50vw - 40px), 33vw"
          alt={space.images[3].alt}
          width="960"
          height="720"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 shadow-md border border-white/20">
          <Icon name="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" />
        </div>
      </button>

      <!-- Detail Space 3 (Card 5) -->
      <button
        type="button"
        data-open-gallery-modal={lightboxId}
        data-gallery-index="4"
        aria-label={`Ampliar imagen: ${space.images[4].alt}`}
        class="col-span-1 lg:col-span-4 relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-xs border border-white/80 aspect-[4/3] lg:aspect-[16/11] group bg-brand-ice/20 cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary p-0 block"
      >
        <img
          src={space.images[4].src}
          srcset={`${space.images[4].src.replace('.webp', '-sm.webp')} 480w, ${space.images[4].src} 960w`}
          sizes="(max-width: 640px) calc(50vw - 32px), (max-width: 1024px) calc(50vw - 40px), 33vw"
          alt={space.images[4].alt}
          width="960"
          height="720"
          class="w-full h-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 shadow-md border border-white/20">
          <Icon name="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" />
        </div>
      </button>
    </div>

  </div>

  <!-- Fullscreen Lightbox Modal for Nosotros -->
  <ImageLightboxModal
    id={lightboxId}
    images={space.images}
    title="Así es nuestra óptica"
    eyebrow="NUESTROS ESPACIOS"
  />
</section>
