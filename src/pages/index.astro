---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import TechSection from '../components/TechSection.astro';
import SpaceSection from '../components/SpaceSection.astro';
import KidsVisionSection from '../components/KidsVisionSection.astro';
import FramesSection from '../components/FramesSection.astro';
import CofremSection from '../components/CofremSection.astro';
import TrajectorySection from '../components/TrajectorySection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { obtenerVideosInicio } from '../lib/sanity/videos';

const videosInicio = await obtenerVideosInicio();

// Mapeo resiliente por título/palabra clave con fallback posicional
const videoInfantil = videosInicio.procedimientos.find((v) =>
  /infan/i.test(v.titulo)
) ?? videosInicio.procedimientos[0];

const videoVolk = videosInicio.procedimientos.find((v) =>
  /volk/i.test(v.titulo)
) ?? videosInicio.procedimientos[1];

const videoFarnsworth = videosInicio.procedimientos.find((v) =>
  /farnsworth/i.test(v.titulo)
) ?? videosInicio.procedimientos[2];
---

<Layout
  title="Óptica Alemania en Villavicencio | Optometría y salud visual"
  description="Conoce Óptica Alemania en Villavicencio: atención optométrica, evaluaciones visuales y monturas. Visítanos en Barzal o contáctanos por WhatsApp."
  currentPath="/"
  headerTheme="light"
>
  <Hero />
  <AboutSection />
  <ServicesSection />
  <TechSection
    volkVideo={videoVolk}
    farnsworthVideo={videoFarnsworth}
  />
  <SpaceSection />
  <KidsVisionSection
    videoUrl={videoInfantil?.url}
    posterUrl={videoInfantil?.portada}
  />
  <FramesSection />
  <CofremSection />
  <TrajectorySection />
  <ContactSection
    routeVideo={videosInicio.comoLlegar}
  />
  <Footer />
</Layout>
