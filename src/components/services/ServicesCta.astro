---
import { siteConfig } from '../../data/siteConfig';
import { buildWhatsAppLink } from '../../utils/whatsapp';

const { cta } = siteConfig.servicesPage;
const { contact } = siteConfig;

const whatsappUrl = buildWhatsAppLink(cta.whatsappMessage, contact.whatsappNumber);
---

<section
  id={cta.id}
  class="relative bg-[#06265E] py-16 sm:py-20 lg:py-24 scroll-mt-20 overflow-hidden"
  aria-labelledby="cta-heading"
>
  <!-- Decorative organic optical lens curves matching 7_contacto_desktop.png and 7_contacto_mobile.png -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden -z-0" aria-hidden="true">
    <!-- Left bottom lens wave sweeping up from bottom-left -->
    <svg
      viewBox="0 0 800 600"
      fill="none"
      class="absolute bottom-0 left-0 w-[360px] sm:w-[540px] lg:w-[720px] h-auto object-cover opacity-75"
      preserveAspectRatio="none"
    >
      <path
        d="M0,600 C220,580 420,440 450,220 C460,100 420,0 320,0 L0,0 Z"
        fill="url(#cta-lens-left-grad)"
      />
      <path
        d="M0,600 C150,580 300,480 320,320 C330,200 280,80 200,0 L0,0 Z"
        fill="url(#cta-lens-left-inner)"
        opacity="0.6"
      />
      <defs>
        <linearGradient id="cta-lens-left-grad" x1="0" y1="0" x2="450" y2="600" gradientUnits="userSpaceOnUse">
          <stop stop-color="#0E48A1" stop-opacity="0.85" />
          <stop offset="0.55" stop-color="#0066FF" stop-opacity="0.3" />
          <stop offset="1" stop-color="#06265E" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="cta-lens-left-inner" x1="0" y1="0" x2="320" y2="600" gradientUnits="userSpaceOnUse">
          <stop stop-color="#1452B3" stop-opacity="0.9" />
          <stop offset="0.6" stop-color="#0066FF" stop-opacity="0.4" />
          <stop offset="1" stop-color="#06265E" stop-opacity="0.05" />
        </linearGradient>
      </defs>
    </svg>

    <!-- Right top lens wave sweeping down from top-right -->
    <svg
      viewBox="0 0 800 600"
      fill="none"
      class="absolute top-0 right-0 w-[360px] sm:w-[540px] lg:w-[720px] h-auto object-cover opacity-75"
      preserveAspectRatio="none"
    >
      <path
        d="M800,0 C580,20 380,160 350,380 C340,500 380,600 480,600 L800,600 Z"
        fill="url(#cta-lens-right-grad)"
      />
      <path
        d="M800,0 C650,20 500,120 480,280 C470,400 520,520 600,600 L800,600 Z"
        fill="url(#cta-lens-right-inner)"
        opacity="0.6"
      />
      <defs>
        <linearGradient id="cta-lens-right-grad" x1="800" y1="600" x2="350" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#0E48A1" stop-opacity="0.85" />
          <stop offset="0.55" stop-color="#0066FF" stop-opacity="0.3" />
          <stop offset="1" stop-color="#06265E" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="cta-lens-right-inner" x1="800" y1="600" x2="480" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#1452B3" stop-opacity="0.9" />
          <stop offset="0.6" stop-color="#0066FF" stop-opacity="0.4" />
          <stop offset="1" stop-color="#06265E" stop-opacity="0.05" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-5 sm:px-8 text-center">
    <!-- Eyebrow flanked by thin horizontal rules -->
    <div class="flex items-center justify-center gap-3 sm:gap-4 mb-5 sm:mb-6">
      <span class="w-10 sm:w-14 h-px bg-white/40 inline-block" aria-hidden="true"></span>
      <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] text-white/90 uppercase font-sans">
        {cta.eyebrow}
      </p>
      <span class="w-10 sm:w-14 h-px bg-white/40 inline-block" aria-hidden="true"></span>
    </div>

    <!-- Title with responsive line breaks matching official desktop and mobile mockups verbatim -->
    <h2
      id="cta-heading"
      class="font-serif text-[2.25rem] sm:text-4xl lg:text-[3.5rem] xl:text-[3.85rem] font-normal text-white leading-[1.08] tracking-tight mb-5 sm:mb-6 text-center"
    >
      <!-- Mobile view lines verbatim matching 7_contacto_mobile.png -->
      <span class="block sm:hidden">
        ¿Tienes dudas
        <br />
        sobre nuestros
        <br />
        servicios?
        <br />
        <span class="text-[#70B2FF] italic font-normal">{cta.titleHighlight}</span>
      </span>

      <!-- Desktop view lines verbatim matching 7_contacto_desktop.png -->
      <span class="hidden sm:block">
        {cta.titlePart1}
        <br />
        {cta.titlePart2}
        {' '}
        <span class="text-[#70B2FF] italic font-normal">{cta.titleHighlight}</span>
      </span>
    </h2>

    <!-- Description -->
    <p class="text-blue-100/90 sm:text-white/85 text-sm sm:text-base lg:text-[1.0625rem] leading-relaxed font-normal max-w-2xl mx-auto mb-7 sm:mb-9 text-center">
      {cta.description}
    </p>

    <!-- Primary WhatsApp Pill CTA Button matching official mockup -->
    <div class="flex justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 bg-[#0066FF] hover:bg-[#0052CC] text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-full font-medium text-sm sm:text-base shadow-lg shadow-blue-950/40 hover:shadow-xl hover:shadow-blue-900/50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        <!-- WhatsApp outline bubble icon -->
        <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5 fill-none stroke-current" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0-4.5-1.2L3 21l1.2-4.5A9 9 0 0 0 12 21z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 9.5c.2 1.8 1.8 3.5 3.5 4 .5.1 1.2-.2 1.5-.5l.8-.8c.2-.2.6-.2.8-.1l1.5.7c.3.1.4.5.3.8-.4 1.2-1.6 1.9-2.9 1.9-3.3 0-6-2.7-6-6 0-1.3.7-2.5 1.9-2.9.3-.1.7 0 .8.3l.7 1.5c.1.2.1.6-.1.8l-.8.8c-.3.3-.6 1-.5 1.5z" />
        </svg>

        <span>{cta.ctaText}</span>

        <!-- Right arrow -->
        <svg
          class="w-4 h-4 sm:w-4.5 sm:h-4.5 transition-transform group-hover:translate-x-1"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    </div>
  </div>
</section>
