                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <div class="pt-1.5 leading-snug">
              <p class="font-medium text-white/90">Horario de atención</p>
              <p class="text-white/60 text-xs sm:text-sm mt-0.5">{contact.schedule}</p>
            </div>
          </li>
        </ul>

        <!-- Mobile Social Circles (Instagram & WhatsApp) -->
        <div class="flex items-center gap-3.5 mt-6 pt-1">
          <a
            href={footer.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Óptica Alemania"
            class="w-12 h-12 rounded-full border border-white/20 hover:border-brand-primary hover:bg-brand-primary text-white transition-all duration-200 flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            data-event="footer_social_click"
            data-event-network="instagram_icon"
