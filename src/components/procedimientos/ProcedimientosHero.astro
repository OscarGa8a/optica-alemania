---
// Sección 1 — Hero Procedimientos
// Óptica Alemania Villavicencio
import { siteConfig } from '../../data/siteConfig';
import Button from '../ui/Button.astro';

const { hero } = siteConfig.procedimientosPage;
---

<section
  id={hero.id}
  class="relative w-full min-h-[100dvh] flex flex-col justify-start lg:justify-center overflow-hidden bg-white"
  aria-labelledby="procedimientos-hero-title"
>
  <!-- Full-bleed Background Image occupying 100% width and 100% height of the Hero -->
  <div class="absolute inset-0 w-full h-full z-0 select-none pointer-events-none overflow-hidden">
    <picture class="block w-full h-full">
      <!-- Mobile source (< 1024px) -->
      <source
        media="(max-width: 1023px)"
        srcset={hero.images.mobile.src}
        type="image/webp"
      />
      <source
        media="(max-width: 1023px)"
        srcset={hero.images.mobile.pngFallback}
        type="image/png"
      />
      <!-- Desktop source (>= 1024px) -->
      <source
        media="(min-width: 1024px)"
        srcset={hero.images.desktop.src}
        type="image/webp"
      />
      <!-- Fallback image -->
      <img
        src={hero.images.desktop.pngFallback}
        alt={hero.images.desktop.alt}
        width={hero.images.desktop.width}
        height={hero.images.desktop.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-[18%_bottom] translate-y-40 sm:translate-y-28 lg:translate-y-0 lg:object-right"
      />
    </picture>

    <!-- Desktop gradient: cubre el bloque editorial a la izquierda sin velar a la especialista -->
    <div class="hidden lg:block absolute inset-y-0 left-0 w-[42%] xl:w-[38%] bg-gradient-to-r from-white via-white/95 via-65% to-transparent pointer-events-none"></div>

    <!-- Mobile gradient: de arriba hacia abajo para legibilidad total del texto y botón -->
    <div class="block lg:hidden absolute inset-0 bg-gradient-to-b from-white via-white/95 via-[42%] to-transparent to-[52%] pointer-events-none"></div>
  </div>

  <!-- Content Container: alineado a la izquierda con el header -->
  <div class="relative z-10 w-full px-6 sm:px-8 lg:px-10 xl:px-14 2xl:px-20 pt-20 pb-8 sm:pt-24 sm:pb-12 lg:py-24">
    <div class="max-w-xl lg:max-w-lg xl:max-w-xl flex flex-col items-start">
      <!-- Eyebrow matching system rhythm -->
      <div>
        <span class="text-xs sm:text-sm uppercase font-semibold tracking-[0.2em] text-brand-primary">
          {hero.eyebrow}
        </span>
      </div>

      <!-- Hero Heading H1: Fluid Instrument Serif scaling smoothly with screen width -->
      <h1
        id="procedimientos-hero-title"
        class="font-display text-[clamp(2.4rem,1.4rem+3.8vw,5.5rem)] text-brand-heading leading-[1.06] tracking-tight mt-3 sm:mt-6"
      >
        <span class="block">{hero.titleLine1}</span>
        <span class="block">{hero.titleLine2}</span>
        <span class="block italic text-brand-primary font-normal">{hero.titleHighlight}</span>
      </h1>

      <!-- Subtitle matching tokens & mockup rhythm -->
      <p class="mt-3 sm:mt-6 text-sm sm:text-base lg:text-lg xl:text-xl text-slate-800 font-medium sm:font-normal leading-relaxed max-w-md sm:max-w-lg xl:max-w-xl">
        {hero.description}
      </p>

      <!-- CTA: Explorar procedimientos -->
      <div class="mt-5 sm:mt-10">
        <Button
          variant="link"
          size="lg"
          href={hero.exploreHref}
          icon="arrow-right"
          data-event="procedimientos_explore_click"
          data-event-location="procedimientos_hero"
        >
          {hero.exploreText}
        </Button>
      </div>
    </div>
  </div>
</section>
